.submenu-item.is-disabled:hover,
.submenu-item.is-disabled:focus-visible {
    color: #8b98a7 !important;
    background: transparent !important;
    box-shadow: none !important;
    cursor: not-allowed;
    opacity: .58;
    transform: none !important;
}

.submenu-item.is-disabled::before,
.submenu-item.is-disabled:hover::before,
.submenu-item.is-disabled:focus-visible::before {
    background: #b8c2cd !important;
    transform: none !important;
}

