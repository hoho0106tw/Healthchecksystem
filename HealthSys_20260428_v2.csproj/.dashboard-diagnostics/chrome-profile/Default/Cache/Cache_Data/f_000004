/* Project self-pay accounting unit lookup */
.project-name-field,
.project-client-unit-field {
    grid-column: span 3;
}

.project-company-code-field {
    grid-column: span 2;
}

.project-year-field {
    grid-column: span 1;
}

.project-self-pay-accounting-control {
    grid-template-columns: minmax(0, 1fr) auto auto;
}

.project-self-pay-accounting-control input[readonly] {
    color: #475569;
    background: #f8fafc;
    cursor: default;
}

.project-self-pay-accounting-control .project-self-pay-accounting-clear-selection {
    color: #64748b;
    border-color: #cbd5e1;
    background: #fff;
}

.project-self-pay-accounting-control .project-self-pay-accounting-clear-selection:disabled {
    opacity: .45;
    cursor: not-allowed;
