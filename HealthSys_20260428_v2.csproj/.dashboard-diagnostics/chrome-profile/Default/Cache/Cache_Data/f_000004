html[data-theme-mode="gray"] :is(
    .examinee-table,
    .appointment-table,
    .compact-choice-table,
    .lookup-patient-table,
    .today-appointment-table,
    .customer-table,
    .basic-data-table,
    .health-project-table,
    .suite-selected-table,
    .package-content-table,
    .theme-preview-table
) td {
    color: var(--gray-mode-text);
