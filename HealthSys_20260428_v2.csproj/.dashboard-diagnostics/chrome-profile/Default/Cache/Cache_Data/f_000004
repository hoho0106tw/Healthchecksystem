.person-main {
    min-width: 0;
    flex: 1;
}

.person-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
}

.person-title strong {
    min-width: 0;
    font-size: 16px;
    overflow-wrap: anywhere;
}

.person-card dl {
    margin: 0;
    display: grid;
    gap: 7px;
    font-size: 13px;
}

.person-card dl div {
    display: grid;
    grid-template-columns: minmax(74px, .88fr) minmax(0, 1fr);
    gap: 7px;
}

.person-card dt,
.person-card dd {
    margin: 0;
}

.person-card dt {
    color: #374151;
    font-weight: 800;
    overflow-wrap: anywhere;
}

.person-card dd {
    text-align: right;
    color: #111827;
    overflow-wrap: anywhere;
}

.details-panel,
.progress-panel,
.alert-panel {
    display: grid;
}

.details-panel {
    grid-template-rows: auto minmax(0, 1fr);
}

.progress-panel {
    grid-template-rows: auto minmax(0, 1fr);
    padding-bottom: clamp(10px, 1.4vh, 14px);
}

.progress-content {
    min-height: 0;
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.2vw, 20px);
    padding: 10px clamp(16px, 1.35vw, 22px) 8px;
    overflow-y: auto;
    overflow-x: hidden;
}

.donut {
    position: relative;
    width: clamp(86px, calc(5vw + 3vh), 128px);
    height: clamp(86px, calc(5vw + 3vh), 128px);
    flex: 0 0 clamp(86px, calc(5vw + 3vh), 128px);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: conic-gradient(var(--green) 0 var(--progress-completed, 62%), var(--orange) var(--progress-completed, 62%) var(--progress-active, 85%), var(--gray-dot) var(--progress-active, 85%) 100%);
}

.donut::before {
    content: "";
    position: absolute;
    inset: clamp(11px, 1vw, 14px);
    border-radius: 50%;
    background: #fff;
}

.donut span,
.donut small {
    position: relative;
    z-index: 1;
}

.donut span {
    align-self: end;
    font-size: 24px;
    font-weight: 800;
}

.donut small {
    align-self: start;
    margin-top: 2px;
    color: #374151;
    font-size: 13px;
    font-weight: 700;
}

.legend-list {
    min-width: 0;
    flex: 1;
    display: grid;
    gap: 11px;
    color: #374151;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 700;
}

.legend-list div {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr) auto;
    align-items: center;
    gap: 7px;
}

.legend-list span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.legend-list strong {
    color: #111827;
}

.dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
}

.dot.green {
    background: var(--green);
}

.dot.orange {
    background: var(--orange);
}

.dot.gray {
    background: var(--gray-dot);
}

.legend-list p {
    margin: 4px 0 0;
    color: #111827;
    font-weight: 800;
    text-align: right;
}

.alert-panel {
    grid-template-rows: auto minmax(0, 1fr) auto;
    padding-bottom: clamp(8px, 1.2vh, 12px);
}

.alert-list {
    min-height: 0;
    padding: 2px 12px 10px;
    overflow-y: auto;
    overflow-x: hidden;
}

.alert-item {
    min-height: clamp(52px, 7vh, 60px);
    display: grid;
    grid-template-columns: 24px minmax(72px, .8fr) minmax(0, 1fr) 48px;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    border: 1px solid #eef1f5;
    border-radius: 6px;
    color: #111827;
}

.alert-item + .alert-item {
    margin-top: -1px;
}

.alert-icon {
    position: relative;
    width: 22px;
    height: 22px;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
}

.alert-icon::before {
    color: #fff;
    font-size: 13px;
    font-weight: 900;
}

.alert-icon.warn {
    background: var(--orange);
}

.alert-icon.warn::before {
    content: "!";
}

.alert-icon.info {
    background: #2da7df;
}

.alert-icon.info::before {
    content: "i";
}

.alert-item strong,
.alert-item em,
.alert-item time {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.alert-item strong {
    font-size: 14px;
    line-height: 1.25;
}

.alert-item em {
    color: #d15454;
    font-size: 13px;
    line-height: 1.25;
    font-style: normal;
    font-weight: 800;
}

.alert-item:nth-child(3) em {
    color: #2186c4;
}

.alert-item time {
    color: #374151;
    font-size: 13px;
    line-height: 1.25;
    text-align: right;
}

.all-alerts {
    display: block;
    color: #1677e8;
    font-size: 13px;
    font-weight: 800;
    text-align: center;
}

@media (max-height: 780px) and (min-width: 1281px) {
    .right-column {
        gap: 8px;
    }

    .right-column .panel h2 {
        padding-top: clamp(9px, 1.45vh, 12px);
