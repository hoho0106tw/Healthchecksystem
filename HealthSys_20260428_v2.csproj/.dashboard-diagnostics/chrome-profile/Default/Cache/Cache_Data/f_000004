}

.customer-table th:nth-child(2),
.customer-table td:nth-child(2) {
    width: 110px;
}

.customer-table th:nth-child(4),
.customer-table td:nth-child(4) {
    width: 130px;
}

.customer-table th:nth-child(5),
.customer-table td:nth-child(5) {
    width: 120px;
}

.customer-table th:nth-child(6),
.customer-table td:nth-child(6) {
    width: 220px;
}

.customer-table th:nth-child(7),
.customer-table td:nth-child(7) {
    width: 150px;
}

.customer-table tbody tr {
    position: relative;
    background: #fff;
}

.customer-table tbody td {
    transition: background-color .16s ease, border-color .16s ease, color .16s ease;
}

.customer-table tbody tr:hover td {
    color: #0b2747;
    background: #f7fbff;
}

.customer-table tbody tr.is-selected td {
    color: #0b2747;
    border-bottom-color: rgba(74, 144, 226, .36);
    background:
        linear-gradient(90deg, rgba(22, 119, 232, .18) 0%, rgba(232, 246, 255, .98) 30%, rgba(255, 255, 255, .98) 100%);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, .92),
        inset 0 -1px 0 rgba(132, 188, 239, .32);
}

.customer-table tbody tr.is-selected:hover td {
    background:
        linear-gradient(90deg, rgba(22, 119, 232, .22) 0%, rgba(222, 243, 255, 1) 32%, rgba(255, 255, 255, .98) 100%);
}

.customer-table tbody tr:hover td:first-child,
.customer-table tbody tr.is-selected td:first-child {
    border-radius: 8px 0 0 8px;
}

.customer-table tbody tr:hover td:last-child,
.customer-table tbody tr.is-selected td:last-child {
    border-radius: 0 8px 8px 0;
}

.customer-table tbody tr.is-selected td:first-child {
    position: relative;
}

.customer-table tbody tr.is-selected td:first-child::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    bottom: 9px;
    width: 4px;
    border-radius: 0 999px 999px 0;
    background: linear-gradient(180deg, #0f5eb8 0%, #22a7f2 100%);
    box-shadow: 0 0 14px rgba(22, 119, 232, .48);
}

.customer-table input[type="checkbox"] {
    width: 16px;
    height: 16px;
