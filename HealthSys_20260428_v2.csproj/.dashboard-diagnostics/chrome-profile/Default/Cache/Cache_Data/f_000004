}

.checkin-table-footer {
    min-height: 58px;
    display: grid;
    grid-template-columns: minmax(210px, 1fr) auto minmax(210px, 1fr);
    align-items: center;
    gap: 16px;
    padding: 10px 18px 12px;
    border-top: 1px solid #e8edf4;
    color: #64748b;
    font-size: 13px;
    font-weight: 800;
}

.checkin-pagination {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
}

.checkin-pagination button {
    width: 34px;
    height: 34px;
    display: inline-grid;
    place-items: center;
    padding: 0;
    border: 1px solid #dfe7f1;
    border-radius: 7px;
    color: #475569;
    background: #fff;
    font-weight: 900;
}

.checkin-pagination button.active {
    border-color: #1677e8;
