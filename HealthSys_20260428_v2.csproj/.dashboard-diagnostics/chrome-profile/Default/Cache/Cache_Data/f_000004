.appointment-table-panel {
    position: relative;
    overflow: hidden;
}

.appointment-table-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    background:
        linear-gradient(90deg, transparent 0%, rgba(37, 99, 235, .10) 46%, rgba(14, 165, 233, .18) 50%, rgba(37, 99, 235, .10) 54%, transparent 100%);
    transform: translateX(-120%);
}

.appointment-table-panel.is-query-loading,
.appointment-table-panel.is-query-refreshed { isolation: isolate; }

.appointment-table-panel.is-query-loading::before,
.appointment-table-panel.is-query-refreshed::before {
    content: "";
    position: absolute;
    top: 0;
    left: -42%;
    z-index: 8;
    width: 42%;
    height: 3px;
    border-radius: 999px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(22, 119, 232, .28), #29c7ff 64%, transparent);
    box-shadow: 0 0 18px rgba(41, 199, 255, .48);
}
.appointment-table-panel.is-query-loading::before { animation: appointment-grid-progress .82s ease-in-out infinite; }
.appointment-table-panel.is-query-refreshed::before { animation: appointment-grid-progress .72s ease-out 1; }
.appointment-table-panel.is-query-loading::after,
.appointment-table-panel.is-query-refreshed::after {
    opacity: 1;
    animation: appointment-grid-sheen .9s ease-in-out infinite;
}
.appointment-table-panel.is-query-refreshed::after { animation-iteration-count: 1; }
.appointment-table-panel.is-query-loading .appointment-table-frame { animation: appointment-grid-wait .82s ease-in-out infinite alternate; }
.appointment-table-panel.is-query-refreshed .appointment-table-frame { animation: appointment-grid-arrive .62s cubic-bezier(.2, .8, .2, 1) both; }

@keyframes appointment-grid-progress { to { left: 100%; } }
@keyframes appointment-grid-sheen {
    from { transform: translateX(-120%); }
    to { transform: translateX(120%); }
}
@keyframes appointment-grid-wait {
    from { opacity: .76; filter: saturate(.82); transform: scale(.998); }
    to { opacity: .94; filter: saturate(1); transform: scale(1); }
}
@keyframes appointment-grid-arrive {
    from { opacity: .56; filter: saturate(.76); transform: translateY(5px); }
    to { opacity: 1; filter: saturate(1); transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
    .appointment-table-panel.is-query-loading::before,
    .appointment-table-panel.is-query-refreshed::before,
    .appointment-table-panel.is-query-loading::after,
    .appointment-table-panel.is-query-refreshed::after,
    .appointment-table-panel.is-query-loading .appointment-table-frame,
    .appointment-table-panel.is-query-refreshed .appointment-table-frame { animation: none; }
}
