/* roster-scrollbar-scope-sentinel */
.group-create-page {
    --roster-table-row-height: 42px;
    --roster-table-header-height: 42px;
    --roster-fixed-select-width: 40px;
    --roster-fixed-edit-width: 58px;
    --roster-fixed-row-width: 44px;
    --roster-fixed-id-width: 104px;
    --roster-fixed-chart-width: 104px;
    --roster-fixed-name-width: 74px;
    --roster-fixed-sex-width: 40px;
    --roster-fixed-birthday-width: 84px;
    --roster-fixed-phone-width: 116px;
    --roster-fixed-mobile-width: 120px;
    --roster-fixed-status-width: 112px;
    --roster-fixed-validation-width: 240px;
    --roster-scroll-address-width: 220px;
    --roster-scroll-email-width: 240px;
    --roster-scroll-dependent-width: 92px;
    --roster-scroll-dependent-note-width: 132px;
    --roster-scroll-note-width: 168px;
    --roster-scroll-package-width: 208px;
    --roster-scroll-addon-width: 168px;
    --roster-scroll-company-width: 158px;
    --roster-scroll-job-width: 118px;
    --roster-scroll-status-width: 112px;
    --roster-fixed-address-width: var(--roster-scroll-address-width);
    --roster-fixed-email-width: var(--roster-scroll-email-width);
    --roster-fixed-date-width: 112px;
    --roster-fixed-columns-width: calc(
        var(--roster-fixed-select-width)
        + var(--roster-fixed-edit-width)
        + var(--roster-fixed-row-width)
        + var(--roster-fixed-id-width)
        + var(--roster-fixed-chart-width)
        + var(--roster-fixed-name-width)
        + var(--roster-fixed-sex-width)
        + var(--roster-fixed-birthday-width)
        + var(--roster-fixed-phone-width)
        + var(--roster-fixed-mobile-width)
        + var(--roster-fixed-date-width)
        + var(--roster-fixed-status-width)
        + var(--roster-fixed-validation-width)
    );
    --roster-scroll-columns-width: calc(
        var(--roster-scroll-address-width)
        + var(--roster-scroll-email-width)
        + var(--roster-scroll-dependent-width)
        + var(--roster-scroll-dependent-note-width)
        + var(--roster-scroll-note-width)
        + var(--roster-scroll-package-width)
        + var(--roster-scroll-addon-width)
        + var(--roster-scroll-company-width)
        + var(--roster-scroll-job-width)
    );
    --roster-table-scrollbar-size: 16px;
}

