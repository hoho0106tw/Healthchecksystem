    align-items: center;
    gap: 5px;
}

.package-pagination button {
    min-width: 28px;
    height: 28px;
    display: inline-grid;
    place-items: center;
    padding: 0 7px;
    border: 1px solid #e3eaf3;
    border-radius: 6px;
    color: #334155;
    background: #fff;
    text-decoration: none;
    font-size: 12px;
    font-weight: 900;
