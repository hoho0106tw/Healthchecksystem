:root {
    --bg: #f6f9fd;
    --panel: #ffffff;
    --line: #e5ebf2;
    --soft-line: #edf1f6;
    --text: #111827;
    --muted: #667085;
    --blue: #1677e8;
    --blue-dark: #0f5eb8;
    --blue-soft: #eaf5ff;
    --green: #21b978;
    --green-soft: #e4faef;
    --orange: #f5aa22;
    --orange-soft: #fff6dc;
    --red: #ef5d63;
    --red-soft: #ffedf0;
    --gray-dot: #a9b3c1;
    --shadow: 0 8px 24px rgba(31, 45, 61, .055);
}

* {
    box-sizing: border-box;
}

html,
body {
    min-height: 100%;
}

body.hc {
    margin: 0;
    color: var(--text);
    background: var(--bg);
    font-family: "Segoe UI", "Microsoft JhengHei", Arial, sans-serif;
    font-size: 14px;
    letter-spacing: 0;
}

button,
input,
select {
    font: inherit;
}

button,
select {
    cursor: default;
}

a {
    color: inherit;
    text-decoration: none;
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.app-shell {
    min-height: 100vh;
    background:
        linear-gradient(90deg, rgba(224, 234, 247, .35) 0 1px, transparent 1px 100%),
        var(--bg);
    background-size: 32px 32px;
}

.topbar {
    height: 78px;
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 0 28px 0 40px;
    background: rgba(255, 255, 255, .97);
    border-bottom: 1px solid var(--line);
}

.brand {
    width: 210px;
    display: flex;
    align-items: center;
    gap: 14px;
}

.brand-mark {
    width: 50px;
    height: 50px;
    flex: 0 0 50px;
    display: block;
    overflow: visible;
    filter: drop-shadow(0 8px 14px rgba(185, 28, 28, .16));
}

.brand-heart {
    transform-box: view-box;
    transform-origin: 50% 52%;
    animation: brand-heartbeat 2.4s ease-in-out infinite;
}

@keyframes brand-heartbeat {
    0%, 38%, 100% { transform: scale(1); }
    9% { transform: scale(1.10); }
    16% { transform: scale(.99); }
    24% { transform: scale(1.06); }
    32% { transform: scale(1); }
}

@media (prefers-reduced-motion: reduce) {
    .brand-heart { animation: none; }
}

.brand-copy {
    display: grid;
    gap: 2px;
}

.brand-title {
    font-size: 22px;
    line-height: 1;
    font-weight: 800;
}

.brand-subtitle {
    color: #607084;
    font-size: 12px;
    white-space: nowrap;
}

.icon-button {
    position: relative;
    width: 42px;
    height: 42px;
    display: inline-grid;
    place-items: center;
    border: 0;
    border-radius: 8px;
    color: #263241;
    background: transparent;
}

.menu-toggle {
    gap: 4px;
}

.menu-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
}

.topbar-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 22px;
}

.notification-button {
    overflow: visible;
}

