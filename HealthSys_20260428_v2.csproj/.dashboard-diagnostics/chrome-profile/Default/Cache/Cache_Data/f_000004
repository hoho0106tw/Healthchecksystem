.basic-data-page {
    min-width: 980px;
    height: 100%;
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 14px;
    color: #0f172a;
    overflow: hidden;
}

.basic-data-page button {
    cursor: pointer;
}

.basic-data-header {
    display: grid;
    gap: 8px;
    padding: 2px 2px 0;
}

.basic-data-header h1 {
    margin: 0;
    color: #0f172a;
    font-size: 28px;
    line-height: 1.15;
    font-weight: 900;
}

.basic-data-header p {
    margin: 0;
    color: #475569;
    font-size: 15px;
    line-height: 1.45;
    font-weight: 800;
}

.basic-data-tabs {
    height: 40px;
    display: flex;
    align-items: stretch;
    gap: 34px;
    border-bottom: 1px solid #dfe7f1;
}

.basic-data-tabs button {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0 2px;
    border: 0;
    color: #475569;
    background: transparent;
    font-size: 16px;
    font-weight: 900;
}

.basic-data-tabs button.is-active {
    color: #1677e8;
}

.basic-data-tabs button.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 4px;
    border-radius: 999px 999px 0 0;
    background: #1677e8;
}

.basic-data-panel {
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    border: 1px solid #e5ebf2;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 8px 22px rgba(31, 45, 61, .05);
    overflow: hidden;
}

.basic-data-panel[hidden] {
    display: none;
}

.basic-data-toolbar {
    min-height: 86px;
    display: grid;
    grid-template-columns: minmax(320px, 420px) 190px auto;
    align-items: center;
    gap: 26px;
    padding: 18px 22px;
    border-bottom: 1px solid #eef2f6;
}

.basic-data-toolbar.flow-toolbar {
    grid-template-columns: minmax(320px, 420px) auto;
}

.basic-search-field,
.basic-status-field {
    min-width: 0;
}

.basic-search-field {
    position: relative;
    display: block;
}

.basic-search-field .customer-action-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    color: #64748b;
    transform: translateY(-50%);
}

.basic-search-field input,
.basic-status-field select,
.basic-page-size select {
    width: 100%;
    height: 40px;
    border: 1px solid #dfe6ef;
    border-radius: 7px;
    color: #111827;
    background: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 800;
    outline: none;
}

.basic-search-field input {
    padding: 0 14px 0 42px;
}

.basic-search-field input::placeholder {
    color: #94a3b8;
}

.basic-status-field {
    display: grid;
    grid-template-columns: auto minmax(120px, 1fr);
    align-items: center;
    gap: 10px;
    color: #334155;
    font-size: 14px;
    font-weight: 900;
}

.basic-status-field select,
.basic-page-size select {
    padding: 0 34px 0 14px;
}

.basic-search-field input:focus,
.basic-status-field select:focus,
.basic-page-size select:focus {
    border-color: rgba(22, 119, 232, .72);
    box-shadow: 0 0 0 3px rgba(22, 119, 232, .12);
}

.basic-add-button {
    justify-self: end;
    height: 42px;
    min-width: 150px;
    font-size: 14px;
    font-weight: 900;
}

.basic-table-wrap {
    min-height: 0;
    overflow: auto;
}

.basic-data-table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    table-layout: fixed;
}

.basic-data-table th,
.basic-data-table td {
    height: 56px;
    padding: 0 18px;
    border-bottom: 1px solid #edf2f7;
    color: #1f2937;
    font-size: 15px;
    font-weight: 800;
    text-align: left;
    vertical-align: middle;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.basic-data-table th {
    height: 48px;
    color: #0f172a;
    background: #f8fafc;
    font-weight: 900;
}

.basic-data-table tbody tr:hover td {
    background: #fbfdff;
}

.basic-data-table tbody tr.is-editing td {
    background: #f8fbff;
}

.basic-data-table [contenteditable="true"] {
    color: #0f172a;
    outline: 2px solid rgba(22, 119, 232, .22);
    outline-offset: -4px;
    background: #fff;
}

.phrase-table th:first-child,
.phrase-table td:first-child {
    width: 47%;
}

.phrase-table th:nth-child(2),
.phrase-table td:nth-child(2) {
    width: 21%;
}

.phrase-table th:nth-child(3),
.phrase-table td:nth-child(3) {
    width: 18%;
}

.phrase-table th:nth-child(4),
.phrase-table td:nth-child(4) {
    width: 14%;
    text-align: center;
}

.area-table th:first-child,
.area-table td:first-child {
    width: 18%;
}

.area-table th:nth-child(2),
.area-table td:nth-child(2) {
    width: 46%;
}

.area-table th:nth-child(3),
.area-table td:nth-child(3) {
    width: 16%;
}

.area-table th:nth-child(4),
.area-table td:nth-child(4) {
    width: 20%;
    text-align: center;
}

.flow-table th:first-child,
.flow-table td:first-child {
    width: 22%;
}

.flow-table th:nth-child(2),
.flow-table td:nth-child(2) {
    width: 58%;
}

.flow-table th:nth-child(3),
.flow-table td:nth-child(3) {
    width: 20%;
    text-align: center;
}

.basic-sort {
    position: relative;
    width: 10px;
    height: 14px;
    display: inline-block;
    margin-left: 4px;
    vertical-align: -2px;
}

.basic-sort::before,
.basic-sort::after {
    content: "";
    position: absolute;
    left: 3px;
    width: 5px;
    height: 5px;
    border-right: 1px solid #94a3b8;
    border-bottom: 1px solid #94a3b8;
}

.basic-sort::before {
    top: 1px;
    transform: rotate(-135deg);
}

.basic-sort::after {
    bottom: 1px;
    transform: rotate(45deg);
}

.basic-status-pill {
    min-width: 46px;
    min-height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 13px;
    line-height: 1.1;
    font-weight: 900;
    white-space: nowrap;
}

.basic-status-pill.enabled {
    color: #067647;
    border: 1px solid #bbf7d0;
    background: #dcfae6;
}

.basic-status-pill.disabled {
    color: #475569;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
}

.basic-row-actions {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
}

.basic-icon-button {
    width: 32px;
    height: 32px;
    display: inline-grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
}

.basic-icon-button.edit {
    color: #1677e8;
}

.basic-icon-button.delete {
    color: #df3048;
}

.basic-icon-button:hover,
.basic-icon-button:focus-visible {
    background: #f1f5f9;
}

.basic-icon-button:focus-visible {
    outline: 3px solid rgba(22, 119, 232, .18);
    outline-offset: 1px;
}

.basic-empty-row td {
    height: 150px;
    color: #94a3b8;
    text-align: center;
    font-weight: 900;
}

.basic-table-footer {
    min-height: 62px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 22px;
    border-top: 1px solid #eef2f6;
    color: #475569;
    font-size: 14px;
    font-weight: 900;
}

.basic-pagination {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.basic-pagination button {
    min-width: 36px;
    height: 36px;
    display: inline-grid;
    place-items: center;
    padding: 0 10px;
    border: 1px solid #e5ebf2;
    border-radius: 7px;
    color: #334155;
    background: #fff;
    font-weight: 900;
}

.basic-pagination button.active {
    color: #fff;
    border-color: #1677e8;
    background: #1677e8;
    box-shadow: 0 4px 10px rgba(22, 119, 232, .22);
}

.basic-pagination button:disabled {
    color: #cbd5e1;
    background: #f8fafc;
    cursor: default;
}

.basic-page-size {
    width: 94px;
    flex: 0 0 94px;
}

.basic-page-size select {
    height: 38px;
    font-size: 14px;
}

.basic-data-page[data-basic-data-page],
.basic-data-page[data-basic-data-page] * {
    font-weight: 400 !important;
}

@media (max-width: 1180px) {
    .basic-data-toolbar {
        grid-template-columns: minmax(280px, 1fr) 170px;
        gap: 14px;
    }

    .basic-data-toolbar.flow-toolbar {
        grid-template-columns: minmax(280px, 1fr);
    }

    .basic-add-button {
        grid-column: 1 / -1;
        justify-self: start;
    }
}

.health-project-page {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    gap: 12px;
    grid-template-rows: auto auto minmax(0, 1fr);
}

.health-project-page button,
.health-project-page input,
.health-project-page select {
    cursor: pointer;
}

.health-project-header {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    padding-top: 0;
    gap: 4px;
}

.health-project-header h1 {
    font-size: 24px;
}

.health-project-header p {
    font-size: 14px;
}

.health-project-create-button {
    min-width: 118px;
    height: 36px;
    padding-inline: 15px;
