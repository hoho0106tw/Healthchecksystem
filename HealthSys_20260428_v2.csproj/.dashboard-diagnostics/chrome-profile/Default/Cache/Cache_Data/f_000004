.notification-count {
    position: absolute;
    top: 0;
    right: -3px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    color: #fff;
    background: #ef4444;
    font-size: 10px;
    line-height: 17px;
    text-align: center;
}

.admin-profile {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
}

.admin-avatar {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #e8eef8;
}

.admin-avatar::before {
    content: "";
    position: absolute;
    left: 11px;
    top: 7px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #475569;
}

.admin-avatar::after {
    content: "";
    position: absolute;
    left: 7px;
    bottom: 6px;
    width: 20px;
    height: 11px;
    border-radius: 12px 12px 4px 4px;
    background: #475569;
}

.chevron,
.down-caret,
.menu-arrow {
    width: 8px;
    height: 8px;
    border-right: 1.8px solid currentColor;
    border-bottom: 1.8px solid currentColor;
    transform: rotate(45deg);
}

.app-body {
    min-height: calc(100vh - 78px);
    display: flex;
}

.sidebar {
    position: relative;
    width: 262px;
    flex: 0 0 262px;
    min-height: calc(100vh - 78px);
    display: flex;
    flex-direction: column;
    padding: 18px 14px 64px;
    background: rgba(255, 255, 255, .92);
    border-right: 1px solid var(--line);
    transition: width .18s ease, flex-basis .18s ease, padding .18s ease;
}

.sidebar-toggle-button {
    position: absolute;
    top: 20px;
    right: -15px;
    z-index: 4;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid #d7dee8;
    border-radius: 5px;
    color: #263241;
    background: #fff;
    box-shadow: 0 8px 18px rgba(31, 45, 61, .12);
}

.sidebar-toggle-button:hover,
.sidebar-toggle-button:focus-visible {
    color: #146bb8;
    border-color: #b9d8f4;
    background: #f8fbff;
}

.sidebar-toggle-button:focus-visible {
    outline: 3px solid rgba(22, 119, 232, .22);
    outline-offset: 2px;
}

.sidebar-toggle-icon {
    position: relative;
    width: 16px;
    height: 16px;
    display: block;
}

.sidebar-toggle-icon::before,
.sidebar-toggle-icon::after {
    content: "";
    position: absolute;
    top: 50%;
    background: currentColor;
}

.sidebar-toggle-icon::before {
    left: 3px;
    width: 2px;
    height: 14px;
    border-radius: 999px;
    transform: translateY(-50%);
}

.sidebar-toggle-icon::after {
    left: 11px;
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-right: 6px solid currentColor;
    border-bottom: 4px solid transparent;
    background: transparent;
    transform: translate(-50%, -50%);
}

html.sidebar-collapsed .sidebar {
    width: 86px;
    flex-basis: 86px;
    padding-right: 12px;
    padding-left: 12px;
}

.menu {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.menu::after {
    content: "";
    order: 99;
    flex: 1 1 auto;
    min-height: clamp(28px, 5vh, 46px);
}

.menu-group {
    position: relative;
    order: 0;
    display: grid;
    gap: 4px;
    border-radius: 10px;
}

.menu-group > .menu-item {
    padding-right: 56px;
}

.menu-group.is-open {
    padding-bottom: 4px;
}

.menu-item {
    min-height: 56px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 18px;
    border-radius: 8px;
    color: #1f2937;
    font-size: 16px;
    font-weight: 500;
    transition: width .18s ease, padding .18s ease, gap .18s ease, background .18s ease, box-shadow .18s ease, color .18s ease;
}

.menu-item.active {
    color: #146bb8;
    background: #eef6ff;
    box-shadow: inset 3px 0 0 #1677e8;
}

.menu-icon {
    position: relative;
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    color: currentColor;
}

