.checkin-lookup-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid #dfe7f1;
    border-radius: 7px;
    overflow: hidden;
}

.checkin-lookup-tabs button {
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 0;
    border-right: 1px solid #dfe7f1;
    color: #475569;
    background: #f8fafc;
    font-weight: 900;
}

.checkin-lookup-tabs button:last-child {
    border-right: 0;
}

.checkin-lookup-tabs button.is-active {
    color: #1677e8;
    background: #fff;
    box-shadow: inset 0 -2px 0 #1677e8;
}

.checkin-lookup-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 88px;
    gap: 10px;
    padding: 10px;
    border: 1px solid #e7edf5;
    border-radius: 8px;
    background: #fbfdff;
}

.checkin-lookup-search label {
    min-width: 0;
}

.checkin-lookup-search input {
    width: 100%;
    height: 42px;
    border: 1px solid #dfe6ef;
    border-radius: 6px;
    padding: 0 14px;
    color: #111827;
    background: #fff;
    font: inherit;
    font-weight: 800;
    outline: none;
}

.checkin-lookup-search input:focus {
    border-color: rgba(22, 119, 232, .72);
    box-shadow: 0 0 0 3px rgba(22, 119, 232, .12);
}

.checkin-lookup-search .primary-button {
    height: 42px;
    gap: 7px;
    font-weight: 900;
}

.checkin-reservation-card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 10px;
    min-height: 240px;
}

.checkin-reservation-card h3 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #0f172a;
    font-size: 16px;
    font-weight: 900;
}

.checkin-reservation-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid #e7edf5;
    border-radius: 8px;
    overflow: hidden;
}

.checkin-reservation-grid > div {
    min-height: 68px;
    display: grid;
    align-content: center;
    gap: 5px;
    padding: 10px 16px;
    border-right: 1px solid #e7edf5;
    border-bottom: 1px solid #e7edf5;
    background: #fff;
}

.checkin-reservation-grid > div:nth-child(4n) {
    border-right: 0;
}

.checkin-reservation-grid > div:nth-last-child(-n + 2) {
    border-bottom: 0;
}

.checkin-reservation-grid span {
    color: #64748b;
    font-size: 12px;
    font-weight: 900;
}

.checkin-reservation-grid strong {
    color: #1f2937;
    font-size: 14px;
    font-weight: 900;
}

.checkin-work-side {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    grid-template-rows: auto auto;
    align-self: start;
    gap: 10px;
}

.checkin-live-summary,
.checkin-confirm-panel {
    display: grid;
    padding: 14px 16px;
}

.checkin-live-summary {
    gap: 6px;
    padding: 8px 12px;
}

.checkin-confirm-panel {
    gap: 12px;
    align-content: start;
    min-height: 0;
}

.checkin-live-summary .calendar-mini-icon,
.checkin-confirm-panel .shield-mini-icon,
.checkin-recent-panel .clock-mini-icon {
    color: #1677e8;
}

.checkin-live-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 7px;
}

.checkin-live-cards article {
    min-height: 46px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 8px;
    border: 1px solid #e7edf5;
    border-radius: 8px;
    background: #fff;
}

.checkin-live-cards .checkin-stat-icon {
    width: 30px;
    height: 30px;
    flex-basis: 30px;
}

.checkin-live-cards .checkin-stat-icon::before {
    inset: 8px;
}

.checkin-live-cards div {
    display: grid;
    gap: 2px;
}

.checkin-live-cards span:not(.checkin-stat-icon) {
    color: #334155;
    font-size: 11px;
    font-weight: 900;
}

.checkin-live-cards strong {
    color: #1677e8;
    font-size: 19px;
    line-height: 1;
    font-weight: 900;
}

.checkin-live-cards small {
    color: #334155;
    font-size: 11px;
}

.checkin-live-cards article:nth-child(2) strong {
    color: #16a36c;
}

.checkin-live-cards article:nth-child(3) strong {
    color: #d99a10;
}

.checkin-confirm-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 10px 0 12px;
    border-bottom: 1px solid #e7edf5;
    list-style: none;
}

.checkin-confirm-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #334155;
    font-size: 14px;
    font-weight: 900;
}

.checkin-confirm-list .check-mini-icon {
    width: 18px;
    height: 18px;
    display: inline-grid;
    place-items: center;
    border-radius: 4px;
    color: #fff;
    background: #16a36c;
}

.checkin-confirm-list .check-mini-icon::before {
    inset: 4px;
}

.checkin-ticket {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 14px;
    padding: 2px 0 0;
}

.checkin-ticket span {
    color: #334155;
    font-size: 14px;
    font-weight: 900;
}

.checkin-ticket strong {
    color: #16a36c;
    font-size: 32px;
    line-height: 1;
    font-weight: 900;
}

.checkin-confirm-button {
    width: 100%;
    height: 44px;
    margin-top: 0;
    gap: 8px;
    font-size: 16px;
    font-weight: 900;
}

.checkin-confirm-button .shield-mini-icon {
    color: #fff;
}

.checkin-confirm-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.checkin-confirm-actions .ghost-button {
    height: 40px;
    gap: 8px;
    font-weight: 900;
}

.checkin-confirm-actions .ghost-button.cancel {
    color: #df3048;
    border-color: #ffd1d8;
    background: #fff;
}

.checkin-recent-panel {
    grid-column: 1 / -1;
    grid-row: 3;
    align-self: stretch;
    min-height: 380px;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
}

.checkin-recent-panel > header {
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px 8px;
}

.checkin-recent-panel > header .ghost-button {
    height: 32px;
    gap: 6px;
    color: #1677e8;
    font-size: 12px;
    font-weight: 900;
}

.checkin-recent-panel .pager-arrow.next {
    width: 13px;
    height: 13px;
}

.checkin-recent-table-wrap {
    overflow-x: auto;
    min-height: 0;
}

.checkin-recent-table {
    width: 100%;
    min-width: 880px;
    border-collapse: collapse;
}

.checkin-recent-table th,
.checkin-recent-table td {
    height: 46px;
    padding: 0 18px;
    border-top: 1px solid #e8edf4;
    color: #1f2937;
    text-align: left;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 800;
}

.checkin-recent-table th {
    color: #64748b;
    background: #f8fafc;
    font-size: 12px;
    font-weight: 900;
}

.checkin-recent-table th:nth-child(5),
.checkin-recent-table td:nth-child(5),
.checkin-recent-table th:nth-child(6),
.checkin-recent-table td:nth-child(6) {
    text-align: center;
}

.checkin-status-pill.printed {
    color: #0891b2;
    background: #e7f9fc;
}

@media (max-width: 1180px) {
    .checkin-summary-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

    .checkin-summary-card {
        gap: 12px;
        min-height: 84px;
        padding: 14px;
    }

    .checkin-stat-icon {
        width: 48px;
        height: 48px;
        flex-basis: 48px;
    }

    .checkin-summary-card strong {
        font-size: 25px;
    }

    .checkin-filter-panel {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .checkin-filter-actions {
        grid-column: auto;
        align-self: end;
    }

    .checkin-work-page {
        grid-template-columns: 1fr;
        column-gap: 0;
    }

    .checkin-work-header,
    .checkin-lookup-panel,
    .checkin-work-side,
    .checkin-recent-panel {
        grid-column: 1;
        grid-row: auto;
    }

    .checkin-recent-panel {
        min-height: 0;
    }
}

@media (max-width: 900px) {
    .checkin-summary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .checkin-reservation-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .checkin-reservation-grid > div:nth-child(4n) {
        border-right: 1px solid #e7edf5;
    }

