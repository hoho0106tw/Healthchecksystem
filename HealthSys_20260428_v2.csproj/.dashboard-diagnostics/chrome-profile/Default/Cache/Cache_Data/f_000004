    right: 0;
    bottom: 0;
    left: 4px;
    height: 3px;
    background: linear-gradient(90deg, rgba(20, 184, 121, .96), rgba(20, 184, 121, .18));
    transform-origin: left center;
    animation: appointmentCreateResultProgress .95s linear forwards;
}

