    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 13px;
    border: 1px solid #d9e8fb;
    border-radius: 6px;
    color: #1677e8;
    background: #f8fbff;
    font-size: 12px;
    font-weight: 900;
}

.eye-mini-icon {
