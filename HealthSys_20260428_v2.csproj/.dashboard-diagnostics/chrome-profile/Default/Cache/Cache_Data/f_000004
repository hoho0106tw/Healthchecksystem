    font: inherit;
    font-size: 14px;
    font-weight: 800;
    outline: none;
}

.health-project-field input {
    padding: 0 12px;
}

.health-project-field select,
.health-project-page-size select {
    padding: 0 32px 0 12px;
}

.health-project-field input::placeholder {
    color: #94a3b8;
}

.health-project-field input:focus,
.health-project-field select:focus,
.health-project-page-size select:focus {
