}

.health-project-field.is-compact {
    width: 100%;
    max-width: 112px;
}

.health-project-field.is-compact input,
.health-project-field.is-compact select {
    font-size: 13px;
}

.health-project-field input,
.health-project-field select,
.health-project-page-size select {
    width: 100%;
    height: 36px;
    border: 1px solid #d8e2ee;
    border-radius: 7px;
    color: #0f172a;
