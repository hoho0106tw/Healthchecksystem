html[data-theme-mode="gray"] .sidebar-support-illustration {
    filter: saturate(.7) contrast(.98);
}

body.hc:has(.theme-settings-page) .page {
    overflow-x: hidden;
}

.theme-settings-page {
    --theme-accent: #1677e8;
    --theme-radius: 8px;
    --theme-row-height: 40px;
    width: 100%;
    min-width: 0;
    min-height: 100%;
    height: 100%;
    display: grid;
    grid-template-rows: minmax(0, 1fr) minmax(54px, 4%);
    gap: 10px;
    color: #0f172a;
    overflow: visible;
}

.theme-settings-page button {
    cursor: pointer;
}

.theme-page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    min-height: 44px;
}

.theme-page-header h1 {
    margin: 0;
    color: #0f172a;
    font-size: 26px;
    line-height: 1.15;
    font-weight: 900;
}

.theme-page-header p,
.theme-preview-header p,
.theme-section p,
.theme-note {
    margin: 5px 0 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.45;
    font-weight: 800;
}

.theme-settings-workspace {
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(360px, .94fr);
    align-items: stretch;
    gap: 10px;
    overflow: hidden;
}

.theme-settings-form {
    min-height: 0;
    display: grid;
    grid-template-rows: auto auto auto;
    gap: 10px;
    padding-right: 0;
    overflow-x: hidden;
    overflow-y: auto;
}

.theme-settings-form::-webkit-scrollbar,
.theme-preview-panel::-webkit-scrollbar {
    width: 8px;
}

.theme-settings-form::-webkit-scrollbar-track,
.theme-preview-panel::-webkit-scrollbar-track {
    border-radius: 999px;
    background: #edf2f7;
}

.theme-settings-form::-webkit-scrollbar-thumb,
.theme-preview-panel::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: #cbd5e1;
}

.theme-section,
.theme-preview-panel,
.theme-settings-footer {
    border: 1px solid #e5ebf2;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 8px 22px rgba(31, 45, 61, .05);
}

.theme-section {
    min-width: 0;
    padding: 14px;
}

.theme-section h2,
.theme-preview-header h2,
.theme-preview-card h3,
.theme-announcement h3 {
    margin: 0;
    color: #0f172a;
    font-size: 16px;
    line-height: 1.2;
    font-weight: 900;
}

.theme-mode-options {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-top: 10px;
}

.theme-choice {
    position: relative;
    min-height: 96px;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 7px;
    padding: 14px 12px 13px;
    border: 1px solid #e5ebf2;
    border-radius: var(--theme-radius);
    background: #fff;
    text-align: center;
}

.theme-choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.theme-choice strong {
    color: #0f172a;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 900;
}

.theme-choice small {
    color: #64748b;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 800;
}

.theme-choice.is-selected {
    border-color: color-mix(in srgb, var(--theme-accent), #ffffff 30%);
    background: color-mix(in srgb, var(--theme-accent), #ffffff 94%);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--theme-accent), transparent 42%);
}

.theme-choice-check {
    position: absolute;
    top: 14px;
    left: 14px;
    width: 18px;
    height: 18px;
    border: 1px solid #d7e0ea;
    border-radius: 50%;
    background: #fff;
}

.theme-choice.is-selected .theme-choice-check {
    border: 5px solid var(--theme-accent);
}

.theme-icon {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    display: inline-block;
    color: currentColor;
    background: currentColor;
    mask: var(--theme-icon) center / contain no-repeat;
    -webkit-mask: var(--theme-icon) center / contain no-repeat;
}

.theme-choice .theme-icon {
    width: 28px;
    height: 28px;
    color: var(--theme-accent);
}

