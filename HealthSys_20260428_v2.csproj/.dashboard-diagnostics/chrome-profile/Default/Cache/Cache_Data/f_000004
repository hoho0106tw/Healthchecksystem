}

.checkin-dialog-notice {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: start;
    gap: 9px;
    padding: 10px 12px;
    border: 1px solid #dbe7f7;
    border-radius: 8px;
    color: #41627f;
    background: #f7faff;
}

.checkin-dialog-notice > span {
    width: 18px;
    height: 18px;
    border: 1px solid #9ec1ea;
    border-radius: 50%;
    color: #2872c7;
    background: #eaf4ff;
}

.checkin-dialog-notice > span::before {
    content: "i";
    display: grid;
    place-items: center;
    font-size: 11px;
    font-style: normal;
    font-weight: 950;
