.appointment-supplement-existing-status {
    display: inline-flex;
    align-items: center;
    padding: 5px 9px;
    border-radius: 999px;
    color: #2563eb;
    background: #dbeafe;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
}
html[data-theme-mode="dark"] body.hc .appointment-supplement-project-panel { border-color: #343437; background: #1d1d1f; }
html[data-theme-mode="dark"] body.hc .appointment-supplement-project-panel > .field-group > span:first-child { color: #f5f5f7; }
html[data-theme-mode="dark"] body.hc .appointment-supplement-project-panel [data-supplement-selected-project] {
    border-color: #48484a;
    color: #f5f5f7;
    background: #2c2c2e;
}
@media (max-width: 720px) {
    .appointment-supplement-project-panel { padding: 12px; }
    .appointment-supplement-project-panel .project-lookup-control { flex-direction: column; }
    .appointment-supplement-project-panel .appointment-project-action-group { width: 100%; }
    .appointment-supplement-project-panel .appointment-project-action-group > * { flex: 1; justify-content: center; }
}
