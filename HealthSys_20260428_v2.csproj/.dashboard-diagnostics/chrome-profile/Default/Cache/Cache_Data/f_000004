@media (max-width: 1500px) {
    .theme-settings-workspace {
        grid-template-columns: minmax(0, 1fr) minmax(340px, .92fr);
    }

    .theme-preview-metrics {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 1360px) {
    .theme-settings-page {
        height: auto;
        grid-template-rows: auto auto;
    }

    .theme-settings-workspace {
        grid-template-columns: minmax(0, 1fr);
        overflow: visible;
    }

    .theme-settings-form,
    .theme-preview-panel {
        overflow: visible;
    }

    .theme-preview-panel {
        order: 2;
    }

    .theme-preview-metrics {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }
}

@media (max-width: 1040px) {
    body.hc:has(.theme-settings-page) .page {
        overflow-x: clip;
    }

    .theme-settings-page {
        gap: 8px;
    }

    .theme-section,
    .theme-preview-panel {
        padding: 12px;
    }

    .theme-mode-options {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .theme-color-row,
    .theme-preview-metrics {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .theme-control-grid,
    .theme-preview-main {
        grid-template-columns: minmax(0, 1fr);
    }

    .theme-settings-footer {
        align-items: stretch;
        flex-wrap: wrap;
        gap: 10px;
    }

    .theme-footer-actions {
        flex: 1 1 360px;
    }
}

@media (max-width: 720px) {
    .theme-mode-options,
    .theme-color-row,
    .theme-preview-metrics {
        grid-template-columns: minmax(0, 1fr);
    }

    .theme-choice {
        min-height: 78px;
        grid-template-columns: 34px minmax(0, 1fr);
        place-items: center start;
        align-content: center;
        gap: 3px 10px;
        padding: 12px 12px 12px 42px;
        text-align: left;
    }

    .theme-choice .theme-icon {
        grid-row: 1 / span 2;
        width: 24px;
        height: 24px;
    }

    .theme-choice-check {
        top: 50%;
        left: 12px;
        transform: translateY(-50%);
    }

    .theme-preview-header,
    .theme-announcement footer,
    .theme-settings-footer,
    .theme-footer-actions {
        align-items: stretch;
        flex-direction: column;
    }

    .theme-preview-refresh,
    .theme-settings-footer .ghost-button,
    .theme-settings-footer .primary-button {
        width: 100%;
    }

    .theme-save-state {
        min-width: 0;
        text-align: left;
    }
}

@media (max-width: 560px) {
    .theme-range-track {
        grid-template-columns: minmax(0, 1fr) 58px;
    }

    .theme-range-track small {
        display: none;
    }

    .theme-progress-body {
        grid-template-columns: minmax(0, 1fr);
        justify-items: center;
    }

    .theme-progress-list {
        width: 100%;
    }

    .theme-preview-table th,
    .theme-preview-table td {
        padding-right: 6px;
        padding-left: 6px;
    }
}

