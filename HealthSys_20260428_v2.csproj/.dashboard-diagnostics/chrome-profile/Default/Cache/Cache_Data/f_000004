    font-family: "Segoe UI", "Noto Sans TC", "Microsoft JhengHei", Arial, sans-serif;
}

.customer-table th,
.customer-table td {
    height: 56px;
    padding: 0 12px;
    border-bottom: 1px solid #edf2f7;
    color: #0f172a;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 400;
    text-align: left;
    vertical-align: middle;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.customer-table th {
    height: 44px;
