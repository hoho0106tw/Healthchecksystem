.checkin-dialog-summary dt {
    color: #64748b;
    font-size: 11px;
    font-weight: 900;
}

.checkin-dialog-summary dd {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: #172033;
    font-size: 14px;
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.checkin-status-flow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.checkin-status-flow b {
    color: #0369a1;
}

.checkin-status-flow i {
    color: #94a3b8;
    font-style: normal;
}

.checkin-status-flow strong {
    color: #3157c8;
}

.checkin-filter-status {
    height: 34px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0 10px;
    border: 1px solid #c8d8eb;
    border-radius: 6px;
    color: #315d91;
    background: #f7faff;
    font-size: 13px;
    font-weight: 800;
}

.checkin-filter-status i {
