    background: linear-gradient(180deg, #1677e8, #0f5eb8);
}

.package-transfer-button:hover {
    border-color: #b9d8f4;
}

.package-transfer-icon {
    width: 18px;
    height: 18px;
    display: inline-block;
    background: currentColor;
    mask: var(--transfer-icon) center / contain no-repeat;
    -webkit-mask: var(--transfer-icon) center / contain no-repeat;
