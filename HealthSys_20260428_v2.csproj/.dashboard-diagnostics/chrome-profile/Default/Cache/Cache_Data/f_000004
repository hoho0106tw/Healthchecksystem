}

.today-appointment-page .appointment-table-frame {
    position: relative;
    height: clamp(430px, calc(100vh - 330px), 760px);
    height: clamp(430px, calc(100dvh - 330px), 760px);
    min-height: 0;
}

.today-appointment-page .appointment-table-wrap {
    height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
    padding-bottom: var(--today-table-scrollbar-size);
    scrollbar-gutter: stable;
}

.today-appointment-page .appointment-table-scrollbar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: var(--today-fixed-columns-width);
    height: var(--today-table-scrollbar-size);
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-color: #a9b3c1 #edf1f6;
}

.today-appointment-page .appointment-table-scrollbar[hidden] {
    display: none;
}

.today-appointment-page .appointment-table-scrollbar-content {
    height: 1px;
}

.today-appointment-page .appointment-table-scrollbar::-webkit-scrollbar {
    height: var(--today-table-scrollbar-size);
}

.today-appointment-page .appointment-table-scrollbar::-webkit-scrollbar-track {
    border-radius: 999px;
    background: #edf1f6;
}

.today-appointment-page .appointment-table-scrollbar::-webkit-scrollbar-thumb {
    min-width: 40px;
    border: 3px solid #edf1f6;
    border-radius: 999px;
