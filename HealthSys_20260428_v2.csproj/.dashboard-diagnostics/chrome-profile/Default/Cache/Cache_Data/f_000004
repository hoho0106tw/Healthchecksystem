        min-height: 0;
        padding: 10px;
        border-right: 0;
        border-bottom: 1px solid var(--line);
    }

    .sidebar-toggle-button {
        display: none;
    }

    html.sidebar-collapsed .sidebar {
        width: auto;
        flex-basis: auto;
        max-height: 0;
        padding: 10px;
        padding-top: 0;
        padding-bottom: 0;
        overflow: hidden;
        border-bottom: 0;
    }

    .menu {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        overflow-x: auto;
    }

    .menu::after {
        display: none;
        content: none;
    }

    .sidebar-support-card {
        min-height: 128px;
        flex: 0 0 218px;
        margin: 0 2px;
        padding: 12px;
    }

    html.sidebar-collapsed .sidebar-support-card {
        display: grid;
    }

    .sidebar-support-body {
        min-height: 58px;
    }

    .sidebar-support-button {
        bottom: 6px;
    }

    .menu-group {
        flex: 0 0 auto;
        align-self: flex-start;
    }

    html.sidebar-collapsed .menu {
        display: none;
        justify-items: initial;
    }

    .menu-item {
        flex: 0 0 auto;
    }

    .menu-group > .menu-item {
        padding-right: 56px;
    }

    html.sidebar-collapsed .menu-item {
        width: auto;
        justify-content: flex-start;
        gap: 14px;
        padding-right: 18px;
        padding-left: 18px;
    }

    html.sidebar-collapsed .menu-group {
        justify-items: stretch;
    }

    html.sidebar-collapsed .menu-group > .menu-item {
        padding-right: 56px;
        padding-left: 18px;
    }

    html.sidebar-collapsed .menu-label {
        max-width: 150px;
        opacity: 1;
        visibility: visible;
    }

    html.sidebar-collapsed .menu-arrow {
        width: 8px;
        height: 8px;
        margin-left: auto;
        border-width: 0 1.8px 1.8px 0;
        opacity: 1;
        visibility: visible;
    }

    html.sidebar-collapsed .menu-group .menu-submenu-toggle {
        display: grid;
    }

    html.sidebar-collapsed .menu-group.is-open .submenu {
        display: grid;
    }

    .copyright {
        display: none;
    }

    .page {
        padding: 14px;
    }

    .panel-header,
    .table-toolbar,
    .table-footer {
        align-items: stretch;
        flex-direction: column;
    }

    .pagination-controls {
        justify-content: flex-start;
    }

    .search-box input {
        width: 100%;
    }

    .station-grid,
    .metric-grid {
        grid-template-columns: 1fr;
    }
}

