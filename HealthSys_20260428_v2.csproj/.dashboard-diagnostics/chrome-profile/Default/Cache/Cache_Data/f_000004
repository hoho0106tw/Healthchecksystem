}

.appointment-create-page .employee-family-check input {
    position: absolute;
    left: 0;
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: pointer;
}

.appointment-create-page .employee-family-box {
    position: relative;
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    border: 1px solid #dfe6ef;
    border-radius: 6px;
    background: #fff;
    transition: border-color .18s ease, background-color .18s ease, box-shadow .18s ease;
}

.appointment-create-page .employee-family-box::after {
    content: "";
    position: absolute;
    left: 8px;
    top: 5px;
    width: 8px;
    height: 14px;
    border-right: 2px solid #1677e8;
    border-bottom: 2px solid #1677e8;
    opacity: 0;
    transform: rotate(45deg) scale(.8);
    transition: opacity .18s ease, transform .18s ease;
}

.appointment-create-page .employee-family-check input:checked + .employee-family-box {
