.my-health-button {
    position: relative;
    min-width: max-content;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 0 0 auto;
    padding: 0 14px 0 16px;
    border: 1px solid rgba(74, 164, 238, .45);
    border-radius: 999px;
    color: #075985;
    background:
        linear-gradient(135deg, #f4fbff 0%, #dff2ff 48%, #bfe6ff 100%);
    background-size: 170% 170%;
    box-shadow:
        0 7px 16px rgba(14, 116, 188, .1),
        inset 0 1px 0 rgba(255, 255, 255, .85);
    font-size: 13px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 0;
    white-space: nowrap;
    overflow: hidden;
    isolation: isolate;
    cursor: pointer;
    transform: translateY(0) scale(1);
    transition:
        transform 240ms ease-out,
        box-shadow 240ms ease-out,
        border-color 240ms ease-out,
        background 240ms ease-out;
    animation:
        my-health-gradient-drift 9s ease-in-out infinite,
        my-health-glow-pulse 6.8s ease-in-out infinite;
}

.my-health-button::before {
    content: "";
    position: absolute;
    inset: -18px auto -18px -52%;
    z-index: 0;
    width: 42%;
    background: linear-gradient(105deg, transparent 0%, rgba(255, 255, 255, .58) 48%, transparent 78%);
    transform: translateX(-80%) skewX(-16deg);
    opacity: .38;
    animation: my-health-shimmer 9.5s ease-in-out infinite;
    pointer-events: none;
}

.my-health-button::after {
    content: "";
    position: absolute;
    inset: 3px 9px;
    z-index: 1;
    border-radius: inherit;
    background:
        radial-gradient(circle at 18% 64%, rgba(125, 211, 252, .56) 0 2px, transparent 4px),
        radial-gradient(circle at 56% 28%, rgba(255, 255, 255, .72) 0 1.5px, transparent 3.5px),
        radial-gradient(circle at 84% 56%, rgba(56, 189, 248, .48) 0 2px, transparent 4px);
    filter: blur(.15px);
    opacity: .24;
    transform: translate3d(-1px, 0, 0);
    animation: my-health-firefly-glow 8.2s ease-in-out infinite;
    pointer-events: none;
}

.my-health-button-text,
.my-health-button-icon {
    position: relative;
    z-index: 2;
}

.my-health-button-icon {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    color: #0874c7;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 240ms ease-out;
}

.my-health-button:hover {
    border-color: rgba(43, 148, 232, .58);
    background:
        linear-gradient(135deg, #fbfeff 0%, #e8f6ff 42%, #caebff 100%);
    box-shadow:
        0 11px 22px rgba(14, 116, 188, .16),
        inset 0 1px 0 rgba(255, 255, 255, .9);
    transform: translateY(-2px);
}

.my-health-button:hover .my-health-button-icon {
    transform: translate(2px, -2px);
}

.my-health-button:active {
    box-shadow:
        0 5px 12px rgba(14, 116, 188, .12),
        inset 0 1px 1px rgba(8, 89, 133, .1);
    transform: translateY(0) scale(.98);
}

.my-health-button:focus-visible {
    outline: 0;
    box-shadow:
        0 0 0 3px rgba(219, 242, 255, .95),
        0 0 0 5px rgba(14, 116, 188, .38),
        0 9px 18px rgba(14, 116, 188, .14);
}

@keyframes my-health-shimmer {
    0%,
    64% {
        transform: translateX(-80%) skewX(-16deg);
        opacity: .18;
    }

    76% {
        opacity: .42;
    }

    90%,
    100% {
        transform: translateX(360%) skewX(-16deg);
        opacity: .16;
    }
}

@keyframes my-health-gradient-drift {
    0%,
    100% {
        background-position: 0% 45%;
    }

    42% {
        background-position: 84% 28%;
    }

    72% {
        background-position: 38% 88%;
    }
}

@keyframes my-health-firefly-glow {
    0%,
    100% {
        opacity: .18;
        transform: translate3d(-2px, 1px, 0) scale(.98);
    }

    22% {
        opacity: .38;
        transform: translate3d(1px, -1px, 0) scale(1.01);
    }

    46% {
        opacity: .24;
        transform: translate3d(3px, 1px, 0) scale(.99);
    }

    68% {
        opacity: .46;
        transform: translate3d(0, -2px, 0) scale(1.02);
    }

    84% {
        opacity: .28;
        transform: translate3d(-1px, 0, 0) scale(1);
    }
}

@keyframes my-health-glow-pulse {
    0%,
    100% {
        box-shadow:
            0 7px 16px rgba(14, 116, 188, .1),
            inset 0 1px 0 rgba(255, 255, 255, .85);
    }

    50% {
        box-shadow:
            0 8px 18px rgba(14, 116, 188, .14),
            0 0 0 1px rgba(191, 230, 255, .3),
            0 0 18px rgba(125, 211, 252, .18),
            inset 0 1px 0 rgba(255, 255, 255, .88);
    }
}

@media (prefers-reduced-motion: reduce) {
    .my-health-button,
    .my-health-button::before,
    .my-health-button::after,
    .my-health-button-icon {
        animation: none;
        transition: none;
    }

    .my-health-button:hover,
    .my-health-button:active,
    .my-health-button:hover .my-health-button-icon {
        transform: none;
    }
}

