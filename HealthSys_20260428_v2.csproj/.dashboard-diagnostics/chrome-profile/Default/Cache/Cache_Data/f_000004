.checkin-page-size {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
}

.checkin-page-size select {
    width: 72px;
    height: 36px;
    padding: 0 12px;
    border: 1px solid #dfe6ef;
    border-radius: 7px;
