}

.group-summary-icon.check-ring::before {
    inset: 7px;
    border: 3px solid currentColor;
    border-radius: 50%;
    background: transparent;
}

.group-summary-icon.check-ring::after {
    content: "";
    position: absolute;
    left: 18px;
    top: 20px;
    width: 9px;
    height: 5px;
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
}

.group-summary-icon.cancel-ring::before {
    inset: 7px;
    border: 3px solid currentColor;
    border-radius: 50%;
    background: transparent;
}

.group-summary-icon.cancel-ring::after {
    content: "";
    position: absolute;
    left: 16px;
    top: 16px;
    width: 10px;
    height: 10px;
    background:
        linear-gradient(45deg, transparent 42%, currentColor 43%, currentColor 57%, transparent 58%),
        linear-gradient(-45deg, transparent 42%, currentColor 43%, currentColor 57%, transparent 58%);
}

.group-summary-icon.reserved-slot::before {
    inset: 9px 11px;
    border: 3px solid currentColor;
    border-radius: 7px;
    background: transparent;
}

.group-summary-icon.reserved-slot::after {
    content: "";
    position: absolute;
    left: 18px;
    top: 18px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 9px 0 currentColor;
}

.group-summary-icon.clock-ring {
    color: #f28a0c;
    background: #fff4df;
}

