    height: 14px;
    display: inline-block;
    margin-left: 4px;
    vertical-align: -2px;
}

.customer-sort::before,
.customer-sort::after {
    content: "";
    position: absolute;
    left: 3px;
    width: 5px;
    height: 5px;
    border-right: 1px solid #94a3b8;
    border-bottom: 1px solid #94a3b8;
}

.customer-sort::before {
    top: 1px;
    transform: rotate(-135deg);
}

.customer-sort::after {
