    overflow-wrap: anywhere;
}

.customer-project-name-value {
    font-size: 13px;
}

.customer-project-date-value {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
}

.customer-project-state {
    justify-self: end;
}

.customer-project-status {
    width: fit-content;
    max-width: 100%;
    min-height: 22px;
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: 999px;
    color: #0f5eb8;
    background: #eef6ff;
    font-size: 12px;
    line-height: 1.25;
    font-weight: 400;
    white-space: normal;
    overflow-wrap: anywhere;
}

.customer-project-empty td {
    height: 68px;
    color: #64748b;
    text-align: center;
}

.customer-project-more {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border: 0;
    color: #0f5eb8;
    background: transparent;
    font-size: 12px;
    font-weight: 400;
}

.customer-note-section {
    display: grid;
}

.customer-note-card {
    display: grid;
    gap: 10px;
    padding: 14px;
    border: 1px solid #eef2f6;
    border-radius: 8px;
    background: #fbfdff;
}

.customer-note-card h3 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #0f172a;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 400;
}

.customer-note-card p {
    margin: 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.55;
    font-weight: 400;
}

.customer-detail-actions {
    justify-content: space-between;
    gap: 10px;
    padding: 14px 18px 18px;
    border-top: 1px solid #eef2f6;
}

.customer-detail-actions .ghost-button {
    height: 38px;
    flex: 1 1 0;
    min-width: 0;
    padding: 0 10px;
    font-size: 13px;
    font-weight: 400;
}

.customer-create-panel {
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    overflow: hidden;
}

.customer-create-frame-root,
body.customer-create-frame-body {
    height: 100%;
    min-height: 0;
    width: 100%;
    overflow-x: hidden;
}

body.customer-create-frame-body {
    margin: 0;
    overflow: hidden;
    background: #f6f8fb;
}

.customer-create-frame {
    height: 100%;
    min-height: 0;
    width: 100%;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    color: #0f172a;
    background: #f6f8fb;
    overflow: hidden;
}

.customer-create-header {
    position: absolute;
    top: 6px;
    right: 8px;
    z-index: 3;
    min-height: 0;
    display: grid;
    grid-template-columns: 30px;
    align-items: center;
    padding: 0;
    border: 0;
    background: transparent;
}

.customer-create-header h1,
.customer-create-header h2 {
    margin: 0 0 5px;
    color: #0f172a;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 900;
}

.customer-create-header p {
    margin: 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 800;
}

.customer-create-close {
    width: 30px;
    height: 30px;
    display: inline-grid;
    place-items: center;
    justify-self: end;
    border: 0;
    border-radius: 6px;
    color: #334155;
    background: transparent;
}

.customer-create-close:hover,
.customer-create-close:focus-visible {
    color: #1677e8;
    background: #eff6ff;
}

.customer-create-form {
    min-height: 0;
    min-width: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
}

.customer-create-body {
    min-height: 0;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, .92fr);
    align-content: start;
    gap: 10px;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 10px 48px 10px 12px;
}

.customer-create-section {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 9px;
    padding: 11px 12px;
    border: 1px solid #e3eaf3;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 8px 22px rgba(31, 45, 61, .05);
}

.customer-create-primary-section {
    grid-column: 1 / -1;
}

.customer-create-business-section {
    align-self: start;
}

.customer-create-section-header {
    min-height: 28px;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) 28px;
    align-items: center;
    gap: 8px;
}

.customer-create-section-number {
    width: 24px;
    height: 24px;
    display: inline-grid;
    place-items: center;
    border-radius: 8px;
    color: #0f5eb8;
    background: #e8f2ff;
    font-size: 12px;
    line-height: 1;
    font-weight: 900;
}

.customer-create-section-header strong {
    color: #0f172a;
    font-size: 15px;
    line-height: 1.2;
    font-weight: 900;
}

.customer-create-section-header button {
    width: 28px;
    height: 28px;
    display: inline-grid;
    place-items: center;
    border: 0;
    border-radius: 6px;
    color: #1e3a5f;
    background: transparent;
    font-size: 15px;
    font-weight: 900;
}

.customer-create-section-header button:hover,
.customer-create-section-header button:focus-visible {
    color: #1677e8;
    background: #eff6ff;
}

.customer-create-section.is-collapsed .customer-create-section-header button span {
    transform: rotate(180deg);
}

.customer-create-section-body {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 9px 12px;
}

.customer-create-primary-section .customer-create-section-body {
    grid-template-columns: minmax(150px, .6fr) repeat(2, minmax(0, 1.1fr)) minmax(0, 1fr) minmax(0, .9fr);
}

.customer-create-business-section .customer-create-section-body {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px 12px;
}

.customer-create-business-section .customer-create-field.is-full {
    grid-column: auto;
}

.customer-create-note-section {
    grid-column: 1 / -1;
}

.customer-create-note-section .customer-create-section-body {
    grid-template-columns: minmax(220px, .42fr) minmax(0, 1fr);
    align-items: start;
}

.customer-create-note-section .customer-create-field.is-full {
    grid-column: auto;
}

.customer-create-field {
    min-width: 0;
    display: grid;
    gap: 5px;
    color: #334155;
    font-size: 13px;
    font-weight: 900;
}

.customer-create-field > span {
    min-height: 18px;
    display: flex;
    align-items: center;
    gap: 4px;
    line-height: 1.25;
}

.customer-create-field.is-full {
    grid-column: 1 / -1;
}

.customer-create-name-field {
    grid-column: span 2;
}

.customer-create-field em {
    color: #e11d48;
    font-style: normal;
}

.customer-create-field input,
.customer-create-field select,
.customer-create-field textarea {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    border: 1px solid #d7e1ec;
    border-radius: 6px;
    color: #0f172a;
    background: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    outline: none;
}

.customer-create-field input,
.customer-create-field select {
    height: 34px;
    padding: 0 10px;
}

.customer-create-field select {
    padding-right: 30px;
}

.customer-create-field textarea {
    min-height: 66px;
    padding: 8px 10px;
    resize: vertical;
}

.customer-create-field input::placeholder,
.customer-create-field textarea::placeholder {
    color: #9aa5b1;
}

.customer-create-field input:focus,
.customer-create-field select:focus,
.customer-create-field textarea:focus {
    border-color: rgba(22, 119, 232, .72);
    box-shadow: 0 0 0 3px rgba(22, 119, 232, .12);
}

.customer-create-field input[readonly] {
    color: #334155;
    border-color: #dfe6ef;
    background: #f3f6fa;
    cursor: default;
}

.customer-create-code-input {
    max-width: 180px;
}

.customer-create-input-action {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 96px;
    gap: 8px;
}

.customer-create-input-action button {
    height: 36px;
    border: 1px solid #cfe0f5;
    border-radius: 6px;
    color: #1e3a5f;
    background: #f8fbff;
    font-size: 13px;
    font-weight: 900;
}

.customer-create-input-action button:hover,
.customer-create-input-action button:focus-visible {
    border-color: #9ec5fe;
    color: #0f5eb8;
    background: #eff6ff;
}

.customer-create-note {
    position: relative;
}

.customer-create-note small {
    justify-self: end;
    margin-top: -2px;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 900;
}

.customer-create-status {
    margin: 0 20px 12px;
    padding: 10px 12px;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    color: #1d4ed8;
    background: #eff6ff;
    font-size: 13px;
    font-weight: 900;
}

.customer-create-status[data-state="success"] {
    border-color: #bbf7d0;
    color: #15803d;
    background: #f0fdf4;
}

.customer-create-status[data-state="error"] {
    border-color: #fecdd3;
    color: #be123c;
    background: #fff1f2;
}

.customer-create-footer {
    min-height: 54px;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-top: 1px solid #eef2f6;
    background: #fff;
}

.customer-create-footer .ghost-button,
.customer-create-footer .primary-button {
    height: 36px;
    min-width: 0;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 900;
}

.customer-create-footer .ghost-button:first-child {
    margin-right: auto;
}

.customer-create-save-next {
    color: #1677e8;
    border-color: #9ec5fe;
    background: #fff;
}

@media (max-width: 1280px) {
    .customer-command-bar {
        align-items: flex-start;
        flex-direction: column;
    }

    .customer-command-actions {
        flex-wrap: wrap;
    }

    .customer-total-count {
        align-self: flex-start;
    }

    .customer-workspace {
        grid-template-columns: minmax(0, 1fr) minmax(300px, 320px);
    }

    .customer-detail-tabs {
        grid-template-columns: repeat(5, minmax(88px, 1fr));
        overflow-x: auto;
    }
}

@media (max-width: 1280px) {
    .customer-workspace,
    .customer-maintenance-page:not(.is-detail-open) .customer-workspace {
        display: block;
        overflow: auto;
    }

    .customer-list-panel,
    .customer-detail-panel {
        min-height: clamp(360px, calc(100vh - 230px), 620px);
    }

    .customer-detail-panel:not([hidden]) {
        margin-top: 12px;
    }

    .customer-table {
        min-width: 860px;
    }
}

@media (max-width: 900px) {
    .customer-maintenance-page {
        gap: 10px;
    }

    .customer-command-bar,
    .customer-filter-panel {
        padding: 12px 14px;
    }

    .customer-command-actions {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(138px, 1fr));
        gap: 10px;
    }

    .customer-command-button {
        width: 100%;
        min-width: 0;
    }

    .customer-filter-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
    }

    .customer-filter-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        white-space: normal;
    }

    .customer-filter-actions .primary-button,
    .customer-filter-actions .ghost-button {
        width: 100%;
        min-width: 0;
    }

    .customer-list-header {
        min-height: 0;
        align-items: flex-start;
        flex-direction: column;
        padding: 12px 14px;
    }

    .customer-list-tools {
        width: 100%;
        flex-wrap: wrap;
    }

    .customer-table {
        min-width: 760px;
    }

    .customer-table-footer {
        min-height: 0;
        flex-wrap: wrap;
        align-items: flex-start;
        padding: 10px 14px;
    }

    .customer-pagination {
        width: 100%;
        margin-left: 0;
        flex-wrap: wrap;
    }

    .customer-page-size {
        margin-left: auto;
    }
}

@media (max-width: 640px) {
    .customer-command-actions,
    .customer-filter-actions {
        grid-template-columns: minmax(0, 1fr);
    }

    .customer-list-panel,
    .customer-detail-panel {
        min-height: clamp(320px, calc(100vh - 210px), 560px);
    }

    .customer-list-header,
    .customer-detail-header {
        padding-right: 12px;
        padding-left: 12px;
    }

    .customer-list-tools .customer-column-button {
        flex: 1 1 140px;
    }

    .customer-table {
        min-width: 680px;
    }

    .customer-table-footer {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 10px;
    }

    .customer-page-size {
        margin-left: 0;
    }

    .customer-pagination {
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 2px;
    }

    .customer-pagination button {
        flex: 0 0 auto;
    }

    .customer-detail-profile {
        grid-template-columns: 44px minmax(0, 1fr);
        padding: 14px;
    }

    .customer-detail-avatar {
        width: 42px;
        height: 42px;
    }

    .customer-detail-tabs {
        height: auto;
        min-height: 42px;
        display: flex;
        overflow-x: auto;
    }

    .customer-detail-tabs button {
        flex: 0 0 auto;
        min-width: 86px;
        height: 42px;
    }

    .customer-detail-content {
        padding: 12px;
    }

    .customer-info-card dl > div,
    .customer-project-summary-top,
    .customer-project-summary-bottom {
        grid-template-columns: minmax(0, 1fr);
    }

    .customer-project-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .customer-project-state {
        justify-self: start;
    }
}
@media (max-width: 980px) {
    .customer-create-frame-shell {
        width: calc(100vw - 28px);
        height: min(700px, calc(100vh - 28px));
    }

    .customer-detail-frame-shell {
        width: calc(100vw - 28px);
        height: min(760px, calc(100vh - 28px));
    }

    .customer-create-body {
        grid-template-columns: 1fr;
        padding: 16px;
    }

    .customer-create-primary-section,
    .customer-create-business-section {
        grid-column: auto;
        grid-row: auto;
    }

    .customer-create-primary-section .customer-create-section-body {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .customer-create-note-section .customer-create-section-body {
        grid-template-columns: 1fr;
    }

    .customer-create-note-section .customer-create-field.is-full {
        grid-column: 1 / -1;
    }
}

@media (max-width: 640px) {
    .customer-create-frame-modal,
    .customer-detail-frame-modal {
        padding: 0;
    }

    .customer-create-frame-shell,
    .customer-create-frame-shell iframe,
    .customer-detail-frame-shell,
    .customer-detail-frame-shell iframe {
        width: 100vw;
        height: 100vh;
        border-radius: 0;
    }

    .customer-create-header {
        grid-template-columns: minmax(0, 1fr);
        min-height: 0;
        padding: 0;
    }

    .customer-create-close {
        position: fixed;
        top: 6px;
        right: 10px;
        z-index: 2;
    }

    .customer-create-close .customer-action-icon {
        display: none;
    }

    .customer-create-close::before {
        content: "\00d7";
        font-size: 24px;
        line-height: 1;
        font-weight: 500;
    }

    .customer-create-header h1,
    .customer-create-header h2 {
        font-size: 19px;
    }

    .customer-create-body {
        gap: 10px;
        padding: 10px 46px 10px 10px;
    }

    .customer-create-section {
        padding: 11px 12px;
    }

    .customer-create-section-body,
    .customer-create-primary-section .customer-create-section-body {
        grid-template-columns: 1fr;
    }

    .customer-create-business-section .customer-create-section-body {
        grid-template-columns: 1fr;
    }

    .customer-create-note-section .customer-create-section-body {
        grid-template-columns: 1fr;
    }

    .customer-create-name-field {
        grid-column: auto;
    }

    .customer-create-code-input {
        max-width: none;
    }

    .customer-create-footer {
        display: grid;
        grid-template-columns: 1fr;
        padding: 8px 10px;
    }

    .customer-create-footer .ghost-button:first-child {
        margin-right: 0;
    }

    .customer-create-footer .ghost-button,
    .customer-create-footer .primary-button {
        width: 100%;
    }
}

