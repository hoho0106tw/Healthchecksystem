}

.group-appointment-table tbody tr td:first-child {
    position: relative;
}

.group-appointment-table tbody tr:hover td:first-child::before,
.group-appointment-table tbody tr.is-selected td:first-child::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 4px;
    border-radius: 999px;
    background: linear-gradient(180deg, #7dd3fc, #1677e8 52%, #29c7ff);
    box-shadow: 0 0 12px rgba(41, 199, 255, .62);
    animation: group-row-lightbar .85s ease-out both;
}

@keyframes group-refresh-line {
    0% { left: -42%; opacity: 0; }
    16% { opacity: 1; }
    100% { left: 100%; opacity: .95; }
}

@keyframes group-refresh-sheen {
    0% { transform: translateX(-120%); opacity: .2; }
    34% { opacity: 1; }
    100% { transform: translateX(120%); opacity: 0; }
}

@keyframes group-refresh-surface {
    0% { filter: saturate(1); }
    42% { filter: saturate(1.08) brightness(1.01); }
    100% { filter: saturate(1); }
}

@keyframes group-refresh-spin {
    to { transform: rotate(360deg); }
}

@keyframes group-row-lightbar {
