.group-table-panel.is-refreshing::before {
    content: "";
    position: absolute;
    top: 0;
    left: -42%;
    z-index: 5;
    width: 42%;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, rgba(22, 119, 232, .25), #29c7ff, transparent);
    box-shadow: 0 0 18px rgba(41, 199, 255, .42);
    animation: group-refresh-line .9s ease-in-out infinite;
}

.group-table-panel.is-refreshing::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background: linear-gradient(110deg, transparent 0%, transparent 38%, rgba(255, 255, 255, .72) 48%, rgba(41, 199, 255, .18) 52%, transparent 64%, transparent 100%);
    animation: group-refresh-sheen .9s ease-out both;
}

.group-table-panel.is-refreshing .group-table-wrap {
    animation: group-refresh-surface .9s ease-out both;
}

.group-appointment-page.is-refreshing .group-filter-actions button.primary-button[type="submit"] {
    background: linear-gradient(180deg, #1d8af2, #0f5eb8);
    box-shadow: 0 0 0 3px rgba(22, 119, 232, .13), 0 10px 20px rgba(22, 119, 232, .18);
}

.group-appointment-page.is-refreshing .group-filter-actions button.primary-button[type="submit"] .refresh-mini-icon::before {
    animation: group-refresh-spin .72s linear infinite;
}

