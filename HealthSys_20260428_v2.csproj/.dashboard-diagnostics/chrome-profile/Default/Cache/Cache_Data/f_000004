    max-height: none;
    overflow-x: hidden;
    overflow-y: visible;
    scrollbar-gutter: auto;
}

.group-create-page .roster-table {
    width: max(100%, 2060px);
    min-width: 2060px;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
}

.group-create-page .roster-table-scrollbar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: min(var(--roster-fixed-columns-width), calc(100% - 96px));
