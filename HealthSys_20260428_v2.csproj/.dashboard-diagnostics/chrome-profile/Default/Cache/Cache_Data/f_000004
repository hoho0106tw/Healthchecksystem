}

.submenu-item {
    min-height: 38px;
    display: flex;
    align-items: center;
    gap: 9px;
    justify-content: flex-start;
    padding: 0 10px 0 12px;
    border-radius: 7px;
    color: #526172;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.25;
    text-align: left;
    transition: background-color .18s ease, color .18s ease, transform .18s ease;
}

.submenu-item::before {
    content: "";
    width: 5px;
    height: 5px;
    flex: 0 0 5px;
    border-radius: 50%;
    background: #a9bdd3;
    transition: background-color .18s ease, transform .18s ease;
}

.submenu-item:hover,
.submenu-item:focus-visible {
    color: #146bb8;
    background: #f0f7ff;
    transform: translateX(2px);
}

.submenu-item.active {
    color: #146bb8;
    background: #eef6ff;
    box-shadow: inset 3px 0 0 #1677e8;
}

.submenu-item:hover::before,
.submenu-item:focus-visible::before,
.submenu-item.active::before {
    background: #1677e8;
    transform: scale(1.25);
}

.submenu-item:focus-visible {
