.flow-step > .money-icon::before,
.flow-step > .stethoscope-icon::before,
.flow-step > .check-mini-icon::before {
    inset: 11px;
}

.group-appointment-page {
    min-height: calc(100vh - 86px);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
}
.group-appointment-layout {
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
}

.group-appointment-layout.has-detail {
    grid-template-columns: minmax(0, 1fr) minmax(310px, 380px);
}

.group-appointment-main,
.group-appointment-side {
    min-width: 0;
    display: grid;
    gap: 16px;
}

.group-appointment-side[hidden],
.group-detail-frame-modal[hidden] {
    display: none;
}

.group-appointment-main {
        container-type: inline-size;
grid-template-rows: auto minmax(0, 1fr);
}

.group-filter-panel {
    display: grid;
    grid-template-columns: minmax(138px, 170px) minmax(150px, 220px) minmax(270px, 320px) minmax(118px, 140px) minmax(16px, 1fr) max-content;
    justify-content: stretch;
    column-gap: 10px;
    row-gap: 12px;
    align-items: end;
    padding: 16px;
}

.group-filter-panel .field-group:nth-child(n),
.group-filter-actions {
    grid-column: auto;
}

.date-range-control {
    min-width: 0;
    height: 38px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 0 8px 0 4px;
    border: 1px solid #dfe6ef;
    border-radius: 6px;
    background: #fff;
    color: #334155;
    font-weight: 800;
}

.group-filter-panel .date-range-control {
    width: 100%;
    max-width: 320px;
}

.date-range-control input {
    height: 36px;
    border: 0;
    padding: 0 6px;
    box-shadow: none;
    background: transparent;
}


.date-range-control input[type="date"] {
    cursor: pointer;
    color-scheme: light;
}

.date-range-control input[type="date"]::-webkit-calendar-picker-indicator {
    cursor: pointer;
    opacity: .72;
    filter: hue-rotate(175deg) saturate(1.35);
}

.date-range-control:focus-within {
    border-color: rgba(22, 119, 232, .7);
    box-shadow: 0 0 0 3px rgba(22, 119, 232, .12);
}

.date-range-control input:focus {
    box-shadow: none;
}

.group-filter-actions {
    grid-column: 6;
    justify-self: end;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: nowrap;
    margin-left: 16px;
}

.group-filter-actions .primary-button,
.group-filter-actions .ghost-button {
    height: 42px;
    min-width: 96px;
}

.group-add-button {
    min-width: 156px;
}

.group-appointment-page.is-filter-compact .group-filter-panel {
    grid-template-columns: minmax(224px, 320px) minmax(108px, 140px) max-content;
    justify-content: start;
    column-gap: 10px;
}

.group-appointment-page.is-filter-compact .group-filter-panel .field-group:nth-child(n),
.group-appointment-page.is-filter-compact .group-filter-actions {
    grid-column: auto;
}

.group-appointment-page.is-filter-compact .group-filter-panel .field-group:nth-child(2) {
    grid-column: 2 / -1;
}

.group-appointment-page.is-filter-compact .group-filter-actions {
    display: flex;
    justify-content: flex-start;
    width: auto;
    margin-left: 10px;
}

.group-appointment-page.is-filter-compact .group-filter-actions .primary-button,
.group-appointment-page.is-filter-compact .group-filter-actions .ghost-button {
    width: auto;
    min-width: 96px;
}

.group-appointment-page.is-filter-narrow .group-filter-panel {
    grid-template-columns: 1fr;
}

.group-appointment-page.is-filter-narrow .group-filter-panel .field-group:nth-child(n),
.group-appointment-page.is-filter-narrow .group-filter-actions {
    grid-column: auto;
}

.group-appointment-page.is-filter-narrow .group-filter-actions {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    margin-left: 0;
}

.group-appointment-page.is-filter-narrow .group-filter-actions .primary-button,
.group-appointment-page.is-filter-narrow .group-filter-actions .ghost-button {
    width: 100%;
    min-width: 0;
}

.group-appointment-page.is-filter-narrow .group-filter-panel .date-range-control {
    max-width: none;
}

@container (max-width: 1120px) {
    .group-filter-panel {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .group-filter-panel .field-group:nth-child(n) {
        grid-column: auto;
    }

    .group-filter-actions {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        justify-content: stretch;
        width: 100%;
        margin-left: 0;
    }

    .group-filter-actions .primary-button,
    .group-filter-actions .ghost-button {
        width: 100%;
        min-width: 0;
    }
}

@container (max-width: 640px) {
    .group-filter-panel {
        grid-template-columns: 1fr;
    }

    .group-filter-panel .date-range-control {
        max-width: none;
    }

    .group-filter-actions {
        grid-column: auto;
        justify-self: stretch;
        display: grid;
        grid-template-columns: 1fr;
        width: 100%;
        margin-left: 0;
    }
}
.group-table-panel {
    position: relative;
    isolation: isolate;
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    overflow: hidden;
}

.group-table-panel > h2 {
    padding: 18px 22px 10px;
    font-size: 18px;
}

.group-summary-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(88px, 1fr));
    gap: 8px;
    padding: 0 16px 12px;
    overflow-x: auto;
}

.group-summary-card {
    min-height: 60px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
    border: 1px solid #dce8f6;
    border-radius: 8px;
    background: linear-gradient(180deg, #fff, #f8fbff);
    box-shadow: 0 4px 14px rgba(31, 45, 61, .035);
}

.group-summary-card.indigo {
    border-color: #c7d2fe;
    background: linear-gradient(180deg, #fbfcff, #eef2ff);
}

.group-summary-card.teal {
    border-color: #99f6e4;
    background: linear-gradient(180deg, #faffff, #ecfdf5);
}

.group-summary-card.green {
    border-color: #caeadc;
    background: linear-gradient(180deg, #fbfffd, #effbf5);
}

.group-summary-card.cyan {
    border-color: #bae6fd;
    background: linear-gradient(180deg, #fbfdff, #eef9ff);
}

.group-summary-card.amber,
.group-summary-card.orange {
    border-color: #f8deb7;
    background: linear-gradient(180deg, #fffdf8, #fff7e8);
}

.group-summary-card.rose {
    border-color: #fecdd3;
    background: linear-gradient(180deg, #fffafa, #fff1f2);
}

.group-summary-card div {
    min-width: 0;
    display: grid;
    gap: 3px;
}

.group-summary-card span:not(.group-summary-icon) {
    color: #334155;
    font-size: 12px;
    font-weight: 900;
    white-space: nowrap;
}

.group-summary-card strong {
    color: #1677e8;
    font-size: 19px;
    line-height: 1;
    font-weight: 900;
    white-space: nowrap;
}

.group-summary-card strong small {
    color: inherit;
    font-size: 10px;
    font-weight: 900;
}

.group-summary-card.indigo strong {
    color: #4f46e5;
}

.group-summary-card.teal strong {
    color: #0f766e;
}

.group-summary-card.green strong {
    color: #16a36c;
}

.group-summary-card.cyan strong {
    color: #0284c7;
}

.group-summary-card.amber strong,
.group-summary-card.orange strong {
    color: #f28a0c;
}

.group-summary-card.rose strong {
    color: #e11d48;
}

.group-summary-icon,
.reset-mini-icon,
.eye-mini-icon,
.upload-mini-icon,
.group-checkin-mini-icon,
.qr-mini-icon,
.mail-mini-icon,
.file-mini-icon {
    position: relative;
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    display: inline-block;
    color: currentColor;
}

.group-summary-icon {
    width: 34px;
    height: 34px;
    flex-basis: 34px;
    border-radius: 8px;
    color: #1677e8;
    background: #edf6ff;
}

.group-summary-card.indigo .group-summary-icon {
    color: #4f46e5;
    background: #eef2ff;
}

.group-summary-card.teal .group-summary-icon {
    color: #0f766e;
    background: #ccfbf1;
}

.group-summary-card.green .group-summary-icon {
    color: #16a36c;
    background: #dcfce7;
}

.group-summary-card.cyan .group-summary-icon {
    color: #0284c7;
    background: #e0f2fe;
}

.group-summary-card.amber .group-summary-icon,
.group-summary-card.orange .group-summary-icon {
    color: #d97706;
    background: #fef3c7;
}

.group-summary-card.rose .group-summary-icon {
    color: #e11d48;
    background: #ffe4e6;
}

.group-summary-icon::before,
.reset-mini-icon::before,
.eye-mini-icon::before,
.upload-mini-icon::before,
.group-checkin-mini-icon::before,
.qr-mini-icon::before,
.mail-mini-icon::before,
.file-mini-icon::before {
    content: "";
    position: absolute;
    inset: 3px;
    background: currentColor;
}

.group-summary-icon::before {
    inset: 7px;
}

