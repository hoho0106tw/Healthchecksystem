.appointment-create-page .reservation-switch {
    position: relative;
    width: 52px;
    height: 30px;
    flex: 0 0 52px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
}

.appointment-create-page .reservation-switch input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: pointer;
}

.appointment-create-page .reservation-switch-track {
    position: relative;
    width: 52px;
    height: 30px;
    border-radius: 999px;
    background: #d4dae2;
    box-shadow: inset 0 0 0 1px #cbd5e1;
    transition: background-color .18s ease, box-shadow .18s ease;
}

.appointment-create-page .reservation-switch-track::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 3px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 5px rgba(15, 23, 42, .18);
    transition: transform .18s ease;
}

.appointment-create-page .reservation-switch input:checked + .reservation-switch-track {
    background: #1677e8;
    box-shadow: inset 0 0 0 1px #1677e8;
}

.appointment-create-page .reservation-switch input:checked + .reservation-switch-track::before {
    transform: translateX(22px);
}

.appointment-create-page .reservation-switch input:focus-visible + .reservation-switch-track {
    box-shadow: 0 0 0 3px rgba(22, 119, 232, .16);
}

