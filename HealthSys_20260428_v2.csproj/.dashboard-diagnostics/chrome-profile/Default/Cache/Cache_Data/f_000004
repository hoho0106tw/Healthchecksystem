    border-color: #1677e8;
    background: #eef6ff;
}

.package-pagination span {
    color: #94a3b8;
}

.package-transfer-controls {
    align-self: center;
    display: grid;
    gap: 14px;
}

.package-transfer-button {
    width: 76px;
    min-height: 58px;
    display: grid;
    place-items: center;
    gap: 6px;
    padding: 9px 7px;
    border: 1px solid #e3eaf3;
    border-radius: 8px;
    color: #0f172a;
    background: #fff;
    box-shadow: 0 7px 18px rgba(31, 45, 61, .06);
    font-size: 12px;
    line-height: 1.15;
    font-weight: 900;
