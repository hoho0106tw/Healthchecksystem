.menu-label {
    max-width: 150px;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width .18s ease, opacity .12s ease, visibility .12s ease;
}

.menu-arrow {
    margin-left: auto;
    color: #6b7280;
    transition: width .18s ease, height .18s ease, margin .18s ease, opacity .12s ease, visibility .12s ease;
}

.menu-submenu-toggle {
    position: absolute;
    top: 0;
    right: 6px;
    width: 44px;
    height: 56px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 8px;
    color: #6b7280;
    background: transparent;
    cursor: pointer;
}

.menu-submenu-toggle:hover,
.menu-submenu-toggle:focus-visible {
    color: #146bb8;
    background: rgba(22, 119, 232, .07);
}

.menu-submenu-toggle:focus-visible {
    outline: 3px solid rgba(22, 119, 232, .2);
    outline-offset: -3px;
}

.menu-submenu-toggle .menu-arrow {
    margin: 0;
}

