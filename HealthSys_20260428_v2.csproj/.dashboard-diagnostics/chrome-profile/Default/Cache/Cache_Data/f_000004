}

.package-total-panel {
    min-height: 78px;
    display: grid;
    grid-template-columns: 1fr 1.2fr 1.05fr .95fr;
    border-top: 1px solid #eef2f6;
}

.package-total-panel article {
    position: relative;
    display: grid;
    align-content: center;
    gap: 9px;
    padding: 14px 20px;
    border-right: 1px solid #eef2f6;
}

.package-total-panel article:last-child {
    border-right: 0;
}

.package-total-panel article > span {
    color: #64748b;
    font-size: 12px;
    font-weight: 900;
}

.package-total-panel strong {
    color: #0f172a;
    font-size: 18px;
    line-height: 1.1;
    font-weight: 900;
}

.package-total-panel small {
    color: #64748b;
