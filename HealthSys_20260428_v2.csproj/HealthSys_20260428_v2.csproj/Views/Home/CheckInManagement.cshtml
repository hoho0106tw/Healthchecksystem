<script>
    (function () {
        const page = document.querySelector(".today-checkin-page");

        if (!page) {
            return;
        }

        const rows = Array.from(page.querySelectorAll("[data-checkin-row]"));
        const pageSummary = page.querySelector("[data-checkin-page-summary]");
        const pagination = page.querySelector("[data-checkin-pagination]");
        const pageSizeSelect = page.querySelector("[data-checkin-page-size]");
        let currentPage = 1;

        function getPageSize() {
            const parsed = Number.parseInt(pageSizeSelect ? pageSizeSelect.value : "10", 10);
            return Number.isFinite(parsed) && parsed > 0 ? parsed : 10;
        }

        function createPageButton(label, pageNumber, options) {
            const button = document.createElement("button");
            button.type = "button";

            if (options?.isArrow) {
                const arrow = document.createElement("span");
                arrow.className = "pager-arrow " + options.direction;
                arrow.setAttribute("aria-hidden", "true");
                button.appendChild(arrow);
            } else {
                button.textContent = label;
            }

            if (options?.ellipsis) {
                button.classList.add("ellipsis");
                button.disabled = true;
            }

            if (options?.active) {
                button.classList.add("active");
                button.setAttribute("aria-current", "page");
            }

            if (options?.disabled) {
                button.disabled = true;
            }

            if (options?.ariaLabel) {
                button.setAttribute("aria-label", options.ariaLabel);
            }

            button.addEventListener("click", function () {
                if (button.disabled || pageNumber === currentPage) {
                    return;
                }

                currentPage = pageNumber;
                renderCheckInPage();
            });

            return button;
        }

        function getVisiblePageNumbers(pageCount) {
            const pages = new Set([1, pageCount]);

            for (let pageNumber = currentPage - 1; pageNumber <= currentPage + 1; pageNumber += 1) {
                if (pageNumber >= 1 && pageNumber <= pageCount) {
                    pages.add(pageNumber);
                }
            }

            return Array.from(pages).sort(function (a, b) {
                return a - b;
            });
        }

        function renderPagination(pageCount) {
            if (!pagination) {
                return;
            }

            pagination.innerHTML = "";
            pagination.appendChild(createPageButton("", Math.max(1, currentPage - 1), {
                isArrow: true,
                direction: "prev",
                disabled: currentPage <= 1,
                ariaLabel: "上一頁"
            }));

            let previousPage = 0;
            getVisiblePageNumbers(pageCount).forEach(function (pageNumber) {
                if (previousPage && pageNumber - previousPage > 1) {
                    pagination.appendChild(createPageButton("...", previousPage + 1, {
                        ellipsis: true,
                        ariaLabel: "更多頁面"
                    }));
                }

                pagination.appendChild(createPageButton(String(pageNumber), pageNumber, {
                    active: pageNumber === currentPage,
                    ariaLabel: "第 " + pageNumber + " 頁"
                }));
                previousPage = pageNumber;
            });

            pagination.appendChild(createPageButton("", Math.min(pageCount, currentPage + 1), {
                isArrow: true,
                direction: "next",
                disabled: currentPage >= pageCount,
                ariaLabel: "下一頁"
            }));
        }

        function renderCheckInPage() {
            if (!rows.length) {
                return;
            }

            const pageSize = getPageSize();
            const pageCount = Math.max(1, Math.ceil(rows.length / pageSize));
            currentPage = Math.min(Math.max(currentPage, 1), pageCount);

            const startIndex = (currentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, rows.length);

            rows.forEach(function (row, index) {
                row.hidden = index < startIndex || index >= endIndex;
            });

            if (pageSummary) {
                pageSummary.textContent = "顯示第 " + (startIndex + 1) + " - " + endIndex + " 筆，共 " + rows.length + " 筆";
            }

            renderPagination(pageCount);
        }

        pageSizeSelect?.addEventListener("change", function () {
            currentPage = 1;
            renderCheckInPage();
        });

        renderCheckInPage();
    })();

    (function () {
        const todayList = document.querySelector("#today-checkin-list");
        const checkinWork = document.querySelector("#checkin-work");
        const sectionLinks = Array.from(document.querySelectorAll("a[href$='#today-checkin-list'], a[href$='#checkin-work']"));

        function normalizeTargetHash(hash) {
            return hash === "#checkin-work" ? "#checkin-work" : "#today-checkin-list";
        }

        function setActiveCheckInSection(targetHash) {
            const activeHash = normalizeTargetHash(targetHash || window.location.hash);
            const showWork = activeHash === "#checkin-work";

            if (todayList) {
                todayList.hidden = showWork;
                todayList.classList.toggle("is-hidden", showWork);
                todayList.setAttribute("aria-hidden", String(showWork));
            }

            if (checkinWork) {
                checkinWork.hidden = !showWork;
                checkinWork.classList.toggle("is-hidden", !showWork);
                checkinWork.setAttribute("aria-hidden", String(!showWork));
            }

            sectionLinks.forEach(function (link) {
                const linkHash = normalizeTargetHash(new URL(link.href, window.location.href).hash);
                link.classList.toggle("active", linkHash === activeHash);
            });

            if (window.location.hash !== activeHash) {
                history.pushState(null, "", activeHash);
            }
        }

        sectionLinks.forEach(function (link) {
            link.addEventListener("click", function (event) {
                const url = new URL(link.href, window.location.href);

                if (url.pathname !== window.location.pathname) {
                    return;
                }

                event.preventDefault();
                setActiveCheckInSection(url.hash);
            });
        });

        window.addEventListener("hashchange", function () {
            setActiveCheckInSection(window.location.hash);
        });

        window.addEventListener("popstate", function () {
            setActiveCheckInSection(window.location.hash);
        });

        setActiveCheckInSection();
    })();

    (function () {
        const workPage = document.querySelector(".checkin-work-page");

        if (!workPage) {
            return;
        }

        const tabButtons = Array.from(workPage.querySelectorAll("[data-checkin-lookup-tab]"));
        const lookupInput = workPage.querySelector("[data-checkin-lookup-input]");
        const lookupButton = workPage.querySelector("[data-checkin-lookup-button]");
        const confirmButton = workPage.querySelector("[data-confirm-checkin]");
        const statusField = workPage.querySelector("[data-work-field='status']");
        const recentBody = workPage.querySelector("[data-recent-checkin-body]");
        const ticket = workPage.querySelector("[data-checkin-ticket]");
        const samplePeople = {
            id: {
                placeholder: "請輸入身分證號或掃描條碼",
                ticket: "A-023",
                name: "王小明",
                idNo: "A1234****56",
                gender: "男",
                birthDate: "1988/03/12",
                phone: "0910-000-123",
                plan: "高階全身健檢",
                counter: "A櫃台"
            },
            phone: {
                placeholder: "請輸入手機號碼",
                ticket: "A-024",
                name: "陳美玲",
                idNo: "D4567****12",
                gender: "女",
                birthDate: "1991/09/20",
                phone: "0944-345-678",
                plan: "心血管檢查專案",
                counter: "B櫃台"
            },
            barcode: {
                placeholder: "請掃描或輸入預約條碼",
                ticket: "A-025",
                name: "林佳慧",
                idNo: "F6789****34",
                gender: "女",
                birthDate: "1986/12/05",
                phone: "0966-345-678",
                plan: "標準健康檢查",
                counter: "A櫃台"
            }
        };

        function setText(field, value) {
            const target = workPage.querySelector("[data-work-field='" + field + "']");
            if (target) {
                target.textContent = value;
            }
        }

        function applyLookupMode(mode) {
            const person = samplePeople[mode] || samplePeople.id;

            tabButtons.forEach(function (button) {
                button.classList.toggle("is-active", button.dataset.checkinLookupTab === mode);
            });

            if (lookupInput) {
                lookupInput.placeholder = person.placeholder;
                lookupInput.value = "";
            }

            if (ticket) {
                ticket.textContent = person.ticket;
            }

            Object.keys(person).forEach(function (field) {
                if (field !== "placeholder" && field !== "ticket") {
                    setText(field, person[field]);
                }
            });

            if (statusField) {
                statusField.textContent = "待報到";
                statusField.className = "checkin-status-pill pending";
            }
        }

        function prependRecentRecord() {
            if (!recentBody) {
                return;
            }

            const now = new Date();
            const timeText = "2026/06/02 " + String(now.getHours()).padStart(2, "0") + ":" + String(now.getMinutes()).padStart(2, "0");
            const row = document.createElement("tr");
            row.innerHTML = [
                "<td>" + timeText + "</td>",
                "<td>" + (workPage.querySelector("[data-work-field='name']")?.textContent || "") + "</td>",
                "<td>" + (workPage.querySelector("[data-work-field='idNo']")?.textContent || "") + "</td>",
                "<td>" + (workPage.querySelector("[data-work-field='plan']")?.textContent || "") + "</td>",
                '<td><span class="checkin-status-pill arrived">已報到</span></td>',
                "<td>管理員</td>"
            ].join("");
            recentBody.prepend(row);
        }

        tabButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                applyLookupMode(button.dataset.checkinLookupTab || "id");
            });
        });

        lookupButton?.addEventListener("click", function () {
            const activeTab = workPage.querySelector("[data-checkin-lookup-tab].is-active");
            applyLookupMode(activeTab?.dataset.checkinLookupTab || "id");
        });

        confirmButton?.addEventListener("click", function () {
            if (statusField) {
                statusField.textContent = "已報到";
                statusField.className = "checkin-status-pill arrived";
            }

            prependRecentRecord();
        });
    })();
</script>
