@{
    ViewData["Title"] = "今日報到";

    var summaryCards = new[]
    {
        new { Label = "應到人數", Value = "128", Unit = "人", Tone = "blue", Icon = "people" },
        new { Label = "已報到", Value = "68", Unit = "人", Tone = "green", Icon = "check" },
        new { Label = "待報到", Value = "50", Unit = "人", Tone = "amber", Icon = "clock" },
        new { Label = "未到", Value = "10", Unit = "人", Tone = "red", Icon = "missed" }
    };

    var namePool = new[] { "王小明", "李大同", "張小華", "陳美玲", "黃志浩", "林佳慧", "劉俊傑", "吳孟謙", "許家豪", "鄭佩君", "周明哲", "蔡宜芳", "楊宗翰", "謝佳穎", "郭俊廷", "曾筱婷" };
    var idPrefixes = new[] { "A", "B", "C", "D", "E", "F", "G", "H", "J", "K", "L", "M", "N", "P", "Q", "R" };
    var periods = new[] { "08:00 - 09:00", "09:00 - 10:00", "10:00 - 11:00", "11:00 - 12:00" };
    var statusPattern = new[]
    {
        new { Status = "已報到", Tone = "arrived" },
        new { Status = "待報到", Tone = "pending" },
        new { Status = "已報到", Tone = "arrived" },
        new { Status = "待報到", Tone = "pending" },
        new { Status = "已報到", Tone = "arrived" },
        new { Status = "未到", Tone = "missed" },
        new { Status = "已報到", Tone = "arrived" },
        new { Status = "待報到", Tone = "pending" }
    };
    var checkIns = Enumerable.Range(1, 128).Select(index =>
    {
        var status = statusPattern[(index - 1) % statusPattern.Length];
        var period = periods[(index - 1) % periods.Length];
        var hour = 8 + ((index - 1) % periods.Length);
        var minute = 10 + ((index * 7) % 45);

        return new
        {
            No = index,
            Name = $"{namePool[(index - 1) % namePool.Length]}{index:000}",
            IdNumber = $"{idPrefixes[(index - 1) % idPrefixes.Length]}{123456789 + index:000000000}",
            Phone = $"09{(10000000 + index * 7919) % 100000000:00000000}",
            Period = period,
            Status = status.Status,
            Tone = status.Tone,
            CheckInTime = status.Status == "已報到" ? $"{hour:00}:{minute:00}" : "-"
        };
    }).ToArray();
}

<section class="appointment-page today-checkin-page" id="today-checkin-list" aria-labelledby="today-checkin-title">
    <header class="checkin-page-header">
        <div>
            <nav class="breadcrumb checkin-breadcrumb" aria-label="頁面位置">
                <span>報到管理</span>
                <span>今日報到</span>
            </nav>
            <h1 id="today-checkin-title">今日報到</h1>
            <div class="checkin-date-row" aria-label="清單日期">
                <span class="checkin-date-icon" aria-hidden="true"></span>
                <span>2026/06/02（三）</span>
            </div>
        </div>
        <button class="ghost-button checkin-refresh-button" type="button">
            <span class="refresh-mini-icon" aria-hidden="true"></span>
            <span>重新整理</span>
        </button>
    </header>

    <section class="checkin-summary-grid" aria-label="今日報到統計">
        @foreach (var card in summaryCards)
        {
            <article class="checkin-summary-card @card.Tone">
                <span class="checkin-stat-icon @card.Icon" aria-hidden="true"></span>
                <div>
                    <span>@card.Label</span>
                    <strong>@card.Value <small>@card.Unit</small></strong>
                </div>
            </article>
        }
    </section>

    <section class="panel checkin-filter-panel" aria-label="報到清單篩選">
        <label class="field-group checkin-search-field">
            <span>搜尋</span>
            <span class="checkin-search-box">
                <input type="search" placeholder="請輸入姓名 / 身分證 / 手機" aria-label="搜尋姓名、身分證或手機" />
                <span class="search-icon" aria-hidden="true"></span>
            </span>
        </label>
        <label class="field-group">
            <span>報到狀態</span>
            <select aria-label="報到狀態">
                <option>全部</option>
                <option>已報到</option>
                <option>待報到</option>
                <option>未到</option>
            </select>
        </label>
        <label class="field-group">
            <span>時段</span>
            <select aria-label="時段">
                <option>全部時段</option>
                <option>08:00 - 09:00</option>
                <option>09:00 - 10:00</option>
                <option>10:00 - 11:00</option>
                <option>11:00 - 12:00</option>
            </select>
        </label>
        <div class="checkin-filter-actions">
            <button class="ghost-button checkin-export-button" type="button">
                <span class="download-mini-icon" aria-hidden="true"></span>
                <span>匯出清單</span>
            </button>
            <button class="primary-button checkin-filter-button" type="button">
                <span class="filter-mini-icon" aria-hidden="true"></span>
                <span>篩選</span>
            </button>
        </div>
    </section>

    <section class="panel checkin-table-panel" aria-label="今日報到">
        <div class="checkin-table-wrap">
            <table class="checkin-table">
                <thead>
                    <tr>
                        <th>序號</th>
                        <th>姓名</th>
                        <th>身分證字號</th>
                        <th>手機</th>
                        <th>時段</th>
                        <th>報到狀態</th>
                        <th>報到時間</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var person in checkIns)
                    {
                        <tr data-checkin-row>
                            <td>@person.No</td>
                            <td>@person.Name</td>
                            <td>@person.IdNumber</td>
                            <td>@person.Phone</td>
                            <td>@person.Period</td>
                            <td><span class="checkin-status-pill @person.Tone">@person.Status</span></td>
                            <td>@person.CheckInTime</td>
                            <td>
                                <button class="checkin-view-button" type="button" aria-label="查看 @person.Name">
                                    <span>查看</span>
                                    <span class="eye-mini-icon" aria-hidden="true"></span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <footer class="checkin-table-footer">
            <span data-checkin-page-summary>顯示第 1 - 10 筆，共 128 筆</span>
            <nav class="checkin-pagination" aria-label="分頁" data-checkin-pagination>
                <button type="button" disabled aria-label="上一頁">
                    <span class="pager-arrow prev" aria-hidden="true"></span>
                </button>
                <button type="button" class="active" aria-current="page">1</button>
                <button type="button">2</button>
                <button type="button">3</button>
                <button type="button" class="ellipsis" aria-label="更多頁面">...</button>
                <button type="button">16</button>
                <button type="button" aria-label="下一頁">
                    <span class="pager-arrow next" aria-hidden="true"></span>
                </button>
            </nav>
            <label class="checkin-page-size">
                <span>每頁顯示</span>
                <select aria-label="每頁顯示" data-checkin-page-size>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
            </label>
        </footer>
    </section>
</section>

