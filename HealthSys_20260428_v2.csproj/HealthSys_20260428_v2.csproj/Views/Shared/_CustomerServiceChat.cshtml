<dialog class="customer-chat" data-customer-chat aria-labelledby="customer-chat-title"
        data-chat-url="@Url.Action("Chat", "Agent")"
        data-unavailable-message="@HealthSys_20260428_v2.csproj.Controllers.AgentController.UnavailableMessage">
<header class="app-header">
    <div class="brand-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="m16 3 3.5 9.5L29 16l-9.5 3.5L16 29l-3.5-9.5L3 16l9.5-3.5L16 3Z" fill="currentColor"/><path d="m26 2 1.1 3L30 6l-2.9 1L26 10l-1-3-3-1 3-1 1-3Z" fill="currentColor"/></svg></div>
    <div class="brand"><span class="eyebrow">HEALTHSYS ASSISTANT</span><h1 id="customer-chat-title">您的健檢智慧精靈</h1></div>
    <div class="header-actions"><button data-customer-chat-font class="icon-button" title="切換加大字體" aria-label="切換加大字體" aria-pressed="false">A+</button><button data-customer-chat-clear class="icon-button" title="清除對話" aria-label="清除對話"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 10v7m4-7v7"/></svg></button><button class="icon-button" type="button" data-customer-chat-close aria-label="關閉智能客服">×</button></div>
  </header>
  <section class="connection-bar" aria-label="服務狀態"><span class="connection-dot"></span><span>服務暫停</span><span class="page-pill">智能客服</span></section>
  <div class="customer-chat-messages" data-customer-chat-messages role="log" aria-live="polite" aria-label="對話紀錄">
    <section class="welcome customer-chat-welcome" data-customer-chat-welcome>
      <div class="hero-art" aria-hidden="true"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="tiny-spark">✦</span><svg viewBox="0 0 180 160" fill="none"><defs><linearGradient id="robot" x1="40" y1="30" x2="145" y2="125"><stop stop-color="#fff"/><stop offset="1" stop-color="#d7e5ff"/></linearGradient></defs><ellipse cx="90" cy="142" rx="47" ry="8" fill="#c5d6fb" opacity=".5"/><path d="M90 37V24" stroke="#6485eb" stroke-width="5" stroke-linecap="round"/><circle cx="90" cy="19" r="7" fill="#8e7cf1"/><rect x="33" y="40" width="114" height="91" rx="34" fill="url(#robot)" stroke="#b8cbf4" stroke-width="2"/><rect x="25" y="71" width="13" height="33" rx="6.5" fill="#809af2"/><rect x="142" y="71" width="13" height="33" rx="6.5" fill="#809af2"/><rect x="48" y="58" width="84" height="52" rx="22" fill="#354c95"/><path d="M65 83c3-7 8-7 11 0m29 0c3-7 8-7 11 0" stroke="#a6e7ff" stroke-width="4" stroke-linecap="round"/><path d="M83 94q7 7 14 0" stroke="#a6e7ff" stroke-width="3" stroke-linecap="round"/><circle cx="57" cy="93" r="4" fill="#ba9df5"/><circle cx="123" cy="93" r="4" fill="#ba9df5"/><path d="m140 27 3 8 8 3-8 3-3 8-3-8-8-3 8-3 3-8Z" fill="#b099f0"/></svg><span class="hero-tag">您的健檢智慧精靈</span></div>
      <span class="welcome-kicker">少一點操作，多一點從容</span><h2>想查什麼，交給我。</h2><p>輸入您的訊息，與健檢智慧精靈對話。</p>
      
    </section>
  </div>
  
  <footer>
    
    <form class="customer-chat-form" data-customer-chat-form>@Html.AntiForgeryToken()<label class="sr-only" for="customer-chat-input">對話訊息</label><div class="composer"><textarea id="customer-chat-input" rows="2" maxlength="2000" placeholder="輸入您想對話的內容…" required></textarea><div class="composer-bottom"><span>✦ 智能客服對話</span><button id="customer-chat-send" type="submit"><span>送出</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m4 4 17 8-17 8 3-8-3-8Zm3 8h14"/></svg></button></div></div></form>
    <div class="footer-note"><span>Enter 送出 · Shift + Enter 換行</span><span>智能客服對話</span></div>
  </footer>
</dialog>
