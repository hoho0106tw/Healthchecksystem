@model HealthSys_20260428_v2.csproj.Models.MedicalOrderMaintenanceViewModel

@{
    ViewData["Title"] = "醫令維護";

    IDictionary<string, string> PageRoute(int page) => new Dictionary<string, string>
    {
        ["category"] = Model.Category,
        ["keyword"] = Model.Keyword,
        ["page"] = page.ToString(),
        ["pageSize"] = Model.PageSize.ToString()
    };

    IReadOnlyList<int> VisiblePages()
    {
        if (Model.TotalPages <= 7) return Enumerable.Range(1, Model.TotalPages).ToArray();
        if (Model.Page <= 4) return new[] { 1, 2, 3, 4, 5, -1, Model.TotalPages };
        if (Model.Page >= Model.TotalPages - 3) return new[] { 1, -1, Model.TotalPages - 4, Model.TotalPages - 3, Model.TotalPages - 2, Model.TotalPages - 1, Model.TotalPages };
        return new[] { 1, -1, Model.Page - 1, Model.Page, Model.Page + 1, -1, Model.TotalPages };
    }

    var firstItem = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
    var basicPhysicalCategory = Model.Categories.FirstOrDefault(category =>
        string.Equals(category.Name, "基本體格檢查", StringComparison.Ordinal));
}

<section class="medical-order-page"
         aria-label="醫令維護"
         data-create-url="@Url.Action("CreateMedicalOrder", "MedicalOrderMaintenance")"
         data-update-url="@Url.Action("UpdateMedicalOrder", "MedicalOrderMaintenance")"
         data-delete-url="@Url.Action("DeleteMedicalOrder", "MedicalOrderMaintenance")">
    <div data-ai-page="medicalOrders" data-ai-result-count="@Model.TotalCount" data-ai-query-error="@Model.ErrorMessage" hidden></div>
    <dialog class="medical-order-editor" data-order-editor aria-labelledby="medical-order-editor-title">
        <form class="medical-order-editor-form" data-order-editor-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="OriginalCheckNo" data-field="OriginalCheckNo" />

            <header class="medical-order-dialog-header">
                <div>
                    <span class="medical-order-dialog-eyebrow" data-editor-eyebrow>新增資料</span>
                    <h2 id="medical-order-editor-title" data-editor-title>新增醫令</h2>
                    <p>建立醫令的中英文名稱、分類與報告顯示資料。</p>
                </div>
                <button class="medical-order-dialog-close" type="button" data-editor-close aria-label="關閉">×</button>
            </header>

            <div class="medical-order-form-section">
                <div class="medical-order-form-section-title"><span>01</span><div><strong>基本資料</strong><small>醫令識別與檢查分類</small></div></div>
                <div class="medical-order-form-grid">
                    <label class="medical-order-editor-field">
                        <span>醫令代碼 <em>必填</em></span>
                        <input type="text" name="CheckNo" maxlength="26" required data-field="CheckNo" placeholder="最多 26 個字元" />
                    </label>
                    <div class="medical-order-editor-field medical-order-category-combobox" data-category-combobox>
                        <span>檢查分類</span>
                        <span class="medical-order-combobox-input">
                            <input type="text" name="CheckCategory" maxlength="500" data-field="CheckCategory" placeholder="選擇或自行輸入新分類" autocomplete="off" aria-expanded="false" aria-controls="medical-order-category-menu" />
                            <button type="button" data-category-toggle aria-label="展開檢查分類">⌄</button>
                        </span>
                        <span class="medical-order-combobox-menu" id="medical-order-category-menu" data-category-menu hidden>
                            @foreach (var category in Model.Categories)
                            {
                                <button type="button" data-category-option="@category.Name" data-category-search="@category.Name">
                                    <span class="medical-order-category @category.Tone">
                                        <span class="package-category-icon @category.Icon" aria-hidden="true"></span>
                                        <span>@category.Name</span>
                                    </span>
                                </button>
                            }
                            <span class="medical-order-category-no-result" data-category-no-result hidden>沒有既有分類，可直接使用目前輸入內容建立新分類</span>
                        </span>
                    </div>
                    <div class="medical-order-editor-field medical-order-category-combobox medical-order-field-wide" data-item-category-combobox>
                        <span>細項類別</span>
                        <span class="medical-order-combobox-input">
                            <input type="text" name="ItemCategory" maxlength="500" data-field="ItemCategory" placeholder="選擇或自行輸入細項類別" autocomplete="off" aria-expanded="false" aria-controls="medical-order-item-category-menu" />
                            <button type="button" data-item-category-toggle aria-label="展開細項類別">⌄</button>
                        </span>
                        <span class="medical-order-combobox-menu medical-order-item-category-menu" id="medical-order-item-category-menu" data-item-category-menu hidden>
                            @foreach (var itemCategory in Model.ItemCategories)
                            {
                                <button type="button" data-item-category-option="@itemCategory" data-item-category-search="@itemCategory">@itemCategory</button>
                            }
                            <span class="medical-order-category-no-result" data-item-category-no-result hidden>沒有符合的既有類別，可直接使用目前輸入內容</span>
                        </span>
                    </div>
                </div>
            </div>

            <div class="medical-order-form-section">
                <div class="medical-order-form-section-title"><span>02</span><div><strong>名稱資料</strong><small>中文與英文顯示名稱</small></div></div>
                <div class="medical-order-form-grid">
                    <label class="medical-order-editor-field"><span>醫令名稱</span><input type="text" name="Name" maxlength="500" data-field="Name" /></label>
                    <label class="medical-order-editor-field"><span>英文名稱</span><input type="text" name="EName" maxlength="500" data-field="EName" lang="en" /></label>
                </div>
            </div>

            <div class="medical-order-form-section medical-order-output-section">
                <div class="medical-order-form-section-title"><span>03</span><div><strong>結果設定</strong><small>報告格式與單位</small></div></div>
                <div class="medical-order-form-grid">
                    <label class="medical-order-editor-field"><span>格式</span><input type="text" name="Format" maxlength="100" data-field="Format" /></label>
                    <label class="medical-order-editor-field"><span>單位</span><input type="text" name="Unit" maxlength="100" data-field="Unit" /></label>
                </div>
            </div>

            <p class="medical-order-dialog-error" data-editor-error role="alert" hidden></p>
            <footer class="medical-order-dialog-footer">
                <button class="ghost-button" type="button" data-editor-cancel>取消</button>
                <button class="primary-button" type="submit" data-editor-submit>新增醫令</button>
            </footer>
        </form>
    </dialog>

    <dialog class="medical-order-delete-dialog" data-delete-dialog aria-labelledby="medical-order-delete-title">
        <form class="medical-order-delete-form" data-delete-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="checkNo" data-delete-code-input />
            <div class="medical-order-delete-icon" aria-hidden="true">!</div>
            <h2 id="medical-order-delete-title">刪除醫令</h2>
            <p>確定要刪除醫令 <strong data-delete-code></strong> 嗎？</p>
            <span>刪除後無法復原，若資料已被其他功能使用，系統將不允許刪除。</span>
            <p class="medical-order-dialog-error" data-delete-error role="alert" hidden></p>
            <footer class="medical-order-delete-actions">
                <button class="ghost-button" type="button" data-delete-cancel>取消</button>
                <button class="medical-order-confirm-delete" type="submit" data-delete-submit>確認刪除</button>
            </footer>
        </form>
    </dialog>

    <form class="medical-order-category-panel" method="get" asp-controller="MedicalOrderMaintenance" asp-action="MedicalOrderMaintenance">
        <input type="hidden" name="keyword" value="@Model.Keyword" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="suite-category-tabs medical-order-category-tabs" aria-label="檢驗項分類" data-medical-order-category-tabs>
            <button class="blue @(string.IsNullOrWhiteSpace(Model.Category) ? "active" : "")" type="submit" name="category" value="" aria-pressed="@(string.IsNullOrWhiteSpace(Model.Category) ? "true" : "false")" data-category-name="全部">
                <span class="package-category-icon stethoscope" aria-hidden="true"></span>
                <span>全部</span>
            </button>
            @if (basicPhysicalCategory is not null)
            {
                <button class="@basicPhysicalCategory.Tone @(basicPhysicalCategory.Active ? "active" : "")" type="submit" name="category" value="@basicPhysicalCategory.Key" aria-pressed="@(basicPhysicalCategory.Active ? "true" : "false")" data-category-name="@basicPhysicalCategory.Name">
                    <span class="package-category-icon @basicPhysicalCategory.Icon" aria-hidden="true"></span>
                    <span>@basicPhysicalCategory.Name</span>
                </button>
            }
            @foreach (var category in Model.Categories.Where(category => !string.Equals(category.Name, "基本體格檢查", StringComparison.Ordinal)))
            {
                <button class="@category.Tone @(category.Active ? "active" : "")" type="submit" name="category" value="@category.Key" aria-pressed="@(category.Active ? "true" : "false")" data-category-name="@category.Name">
                    <span class="package-category-icon @category.Icon" aria-hidden="true"></span>
                    <span>@category.Name</span>
                </button>
            }
        </div>
    </form>

    <form class="medical-order-filter" method="get" asp-controller="MedicalOrderMaintenance" asp-action="MedicalOrderMaintenance">
        <input type="hidden" name="category" value="@Model.Category" />
        <label class="medical-order-field">
            <span>搜尋分類索引</span>
            <input type="search" placeholder="輸入分類，例如：影像檢查" autocomplete="off" data-category-index-search />
        </label>
        <label class="medical-order-field medical-order-keyword">
            <span>關鍵字</span>
            <input type="search" name="keyword" value="@Model.Keyword" placeholder="輸入醫令代碼、中文／英文名稱或細項類別" autocomplete="off" />
        </label>
        <div class="medical-order-actions">
            <button class="primary-button" type="submit">查詢</button>
            <a class="ghost-button" asp-controller="MedicalOrderMaintenance" asp-action="MedicalOrderMaintenance">清除條件</a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="medical-order-alert" role="alert">@Model.ErrorMessage</div>
    }

    <section class="medical-order-grid-panel" aria-label="醫令查詢結果">
        <div class="medical-order-grid-title">
            <div><h2>醫令清單</h2><span>@(string.IsNullOrWhiteSpace(Model.Category) ? "全部分類" : Model.Category)</span></div>
            <div class="medical-order-grid-actions">
                <span class="medical-order-count">共 @Model.TotalCount 筆</span>
                <a class="medical-order-export-button"
                   asp-controller="MedicalOrderMaintenance"
                   asp-action="ExportExcel"
                   asp-route-category="@Model.Category"
                   asp-route-keyword="@Model.Keyword">
                    <span class="medical-order-export-icon" aria-hidden="true">⇩</span>
                    <span>匯出 Excel</span>
                </a>
                <button class="primary-button medical-order-add-button" type="button" data-order-add>
                    <span aria-hidden="true">＋</span>
                    <span>新增醫令</span>
                </button>
            </div>
        </div>

        <div class="medical-order-table-wrap">
            <table class="medical-order-table">
                <thead>
                    <tr>
                        <th class="medical-order-action-heading">操作</th>
                        <th>醫令代碼</th>
                        <th>醫令名稱</th>
                        <th>英文名稱</th>
                        <th>檢驗分類</th>
                        <th>細項類別</th>
                        <th>格式</th>
                        <th>單位</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr class="medical-order-empty-row"><td colspan="8">查無符合條件的醫令資料</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="medical-order-row-actions">
                                        <button class="medical-order-edit-button"
                                                type="button"
                                                data-order-edit
                                                data-check-no="@item.Code"
                                                data-name="@item.Name"
                                                data-check-category="@item.Category"
                                                data-item-category="@item.ItemCategory"
                                                data-e-name="@item.EnglishName"
                                                data-format="@item.Format"
                                                data-unit="@item.Unit">編輯</button>
                                        <button class="medical-order-delete-button" type="button" data-order-delete data-order-code="@item.Code">刪除</button>
                                    </div>
                                </td>
                                <td><span class="medical-order-code">@item.Code</span></td>
                                <td class="medical-order-name">@item.Name</td>
                                <td class="medical-order-english-name" lang="en">@item.EnglishName</td>
                                <td>
                                    <span class="medical-order-category @item.CategoryTone">
                                        <span class="package-category-icon @item.CategoryIcon" aria-hidden="true"></span>
                                        <span>@item.Category</span>
                                    </span>
                                </td>
                                <td>@item.ItemCategory</td>
                                <td>@item.Format</td>
                                <td>@item.Unit</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <footer class="medical-order-grid-footer">
            <span>顯示 @firstItem - @lastItem 筆，共 @Model.TotalCount 筆</span>
            <div class="medical-order-pagination-controls">
                <form method="get" asp-controller="MedicalOrderMaintenance" asp-action="MedicalOrderMaintenance">
                    <input type="hidden" name="category" value="@Model.Category" />
                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                    <select class="page-select" name="pageSize" aria-label="每頁筆數" onchange="this.form.submit()">
                        @foreach (var option in Model.PageSizeOptions)
                        {
                            <option value="@option" selected="@(option == Model.PageSize ? "selected" : null)">@option 筆/頁</option>
                        }
                    </select>
                </form>
                <nav class="medical-order-pagination" aria-label="醫令列表分頁">
                    <a class="@(Model.Page <= 1 ? "is-disabled" : "")" asp-all-route-data="@PageRoute(Math.Max(1, Model.Page - 1))" aria-label="上一頁" aria-disabled="@(Model.Page <= 1 ? "true" : "false")">‹</a>
                    @foreach (var pageNumber in VisiblePages())
                    {
                        if (pageNumber == -1)
                        {
                            <span class="medical-order-ellipsis">…</span>
                        }
                        else
                        {
                            <a class="@(pageNumber == Model.Page ? "active" : "")" asp-all-route-data="@PageRoute(pageNumber)" aria-current="@(pageNumber == Model.Page ? "page" : null)">@pageNumber</a>
                        }
                    }
                    <a class="@(Model.Page >= Model.TotalPages ? "is-disabled" : "")" asp-all-route-data="@PageRoute(Math.Min(Model.TotalPages, Model.Page + 1))" aria-label="下一頁" aria-disabled="@(Model.Page >= Model.TotalPages ? "true" : "false")">›</a>
                </nav>
            </div>
        </footer>
    </section>

    <div class="medical-order-toast" role="status" aria-live="polite" data-medical-order-toast hidden></div>
</section>

<style>
    .medical-order-page { display: grid; gap: 18px; padding: 24px; color: var(--app-text, #172033); }
    .medical-order-filter, .medical-order-grid-panel, .medical-order-category-panel { border: 1px solid var(--app-border, #dfe5ee); border-radius: 14px; background: var(--app-surface, #fff); box-shadow: 0 5px 20px rgba(24, 40, 72, .06); }
    .medical-order-category-panel { overflow: hidden; }
    .medical-order-category-tabs { grid-template-rows: 34px; padding-top: 14px; padding-bottom: 14px; }
    .medical-order-category-tabs button[hidden] { display: none; }
    .medical-order-category-tabs button.blue .package-category-icon { --package-icon-color: #2563eb; }
    .medical-order-category-tabs button.cyan .package-category-icon { --package-icon-color: #0891b2; }
    .medical-order-category-tabs button.rose .package-category-icon { --package-icon-color: #e11d48; }
    .medical-order-category-tabs button.violet .package-category-icon { --package-icon-color: #7c3aed; }
    .medical-order-category-tabs button.lime .package-category-icon { --package-icon-color: #65a30d; }
    .medical-order-filter { display: grid; grid-template-columns: minmax(180px, .35fr) minmax(280px, 1fr) auto; align-items: end; gap: 12px; padding: 16px; }
    .medical-order-field { display: grid; gap: 7px; min-width: 0; font-size: 14px; font-weight: 650; }
    .medical-order-field input, .medical-order-field select { width: 100%; min-height: 42px; padding: 8px 11px; border: 1px solid var(--app-border, #cfd7e3); border-radius: 8px; background: var(--app-surface, #fff); color: inherit; font: inherit; }
    .medical-order-field input:focus, .medical-order-field select:focus { border-color: var(--app-accent, #1677e8); outline: 3px solid rgba(var(--app-accent-rgb, 22, 119, 232), .14); }
    .medical-order-actions { display: flex; gap: 8px; }
    .medical-order-actions a { text-decoration: none; }
    .medical-order-alert { padding: 12px 15px; border: 1px solid #f0b7b7; border-radius: 10px; background: #fff3f3; color: #a42626; }
    .medical-order-grid-panel { min-width: 0; overflow: hidden; }
    .medical-order-grid-title { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 17px 18px; border-bottom: 1px solid var(--app-border, #e4e9f0); }
    .medical-order-grid-title > div { display: flex; align-items: baseline; gap: 10px; }
    .medical-order-grid-title h2 { margin: 0; font-size: 18px; }
    .medical-order-grid-title span { color: var(--app-text-muted, #687386); font-size: 13px; }
    .medical-order-grid-actions { align-items: center !important; }
    .medical-order-add-button { display: inline-flex; align-items: center; gap: 5px; min-height: 36px; padding: 7px 13px; }
    .medical-order-add-button span { color: inherit; font-size: inherit; }
    .medical-order-export-button { min-height: 36px; display: inline-flex; align-items: center; gap: 7px; padding: 7px 13px; border: 1px solid #91d1ac; border-radius: 8px; background: #e9f8ef; color: #187542; font-size: 13px; font-weight: 800; text-decoration: none; white-space: nowrap; }
    .medical-order-export-button:hover { border-color: #55b47d; background: #dff4e8; color: #116236; }
    .medical-order-export-icon { width: 19px; height: 19px; display: grid; place-items: center; border-radius: 5px; background: #c8ecd6; color: #187542 !important; font-size: 15px !important; line-height: 1; }
    .medical-order-count { padding: 5px 10px; border-radius: 999px; background: var(--app-accent-soft, #eaf3ff); color: var(--app-accent-dark, #0f67c7) !important; font-weight: 700; }
    .medical-order-table-wrap { overflow-x: auto; }
    .medical-order-table { width: 100%; min-width: 900px; border-collapse: collapse; }
    .medical-order-table th { padding: 13px 16px; background: var(--app-surface-muted, #f5f7fa); color: var(--app-text-muted, #556174); text-align: left; font-size: 13px; white-space: nowrap; }
    .medical-order-table td { padding: 13px 16px; border-top: 1px solid var(--app-border, #e4e9f0); vertical-align: middle; }
    .medical-order-table tbody tr:hover { background: rgba(var(--app-accent-rgb, 22, 119, 232), .045); }
    .medical-order-code { color: var(--app-accent-dark, #0f67c7); font-weight: 750; }
    .medical-order-name { font-weight: 650; }
    .medical-order-english-name { color: var(--app-text-muted, #687386); }
    .medical-order-action-heading { width: 140px; text-align: center !important; }
    .medical-order-row-actions { display: flex; justify-content: center; gap: 7px; }
    .medical-order-row-actions button { min-height: 31px; padding: 4px 11px; border-radius: 7px; background: var(--app-surface, #fff); font: inherit; font-size: 12px; font-weight: 750; cursor: pointer; }
    .medical-order-edit-button { border: 1px solid #93bce9; color: #1267c5; }
    .medical-order-edit-button:hover { border-color: #1677e8; background: #edf6ff; }
    .medical-order-delete-button { border: 1px solid #efb1b1; color: #c43333; }
    .medical-order-delete-button:hover { border-color: #dc4d4d; background: #fff1f1; }
    .medical-order-category { --category-color: #1677e8; display: inline-flex; align-items: center; gap: 7px; min-height: 30px; padding: 5px 10px; border: 1px solid color-mix(in srgb, var(--category-color) 32%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--category-color) 10%, var(--app-surface, #fff)); color: color-mix(in srgb, var(--category-color) 82%, #172033); font-size: 12px; font-weight: 800; white-space: nowrap; }
    .medical-order-category .package-category-icon { --package-icon-color: var(--category-color); width: 17px; height: 17px; flex-basis: 17px; }
    .medical-order-category.red { --category-color: #ef4444; }
    .medical-order-category.green { --category-color: #10b981; }
    .medical-order-category.blue { --category-color: #1677e8; }
    .medical-order-category.orange, .medical-order-category.amber { --category-color: #f59e0b; }
    .medical-order-category.purple, .medical-order-category.indigo { --category-color: #8b5cf6; }
    .medical-order-category.teal { --category-color: #14b8a6; }
    .medical-order-category.pink { --category-color: #ec4899; }
    .medical-order-category.brown { --category-color: #a16207; }
    .medical-order-category.cyan { --category-color: #0891b2; }
    .medical-order-category.rose { --category-color: #e11d48; }
    .medical-order-category.violet { --category-color: #7c3aed; }
    .medical-order-category.lime { --category-color: #65a30d; }
    .medical-order-empty-row td { height: 180px; color: var(--app-text-muted, #687386); text-align: center; }
    .medical-order-grid-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 18px; border-top: 1px solid var(--app-border, #e4e9f0); color: var(--app-text-muted, #687386); font-size: 13px; }
    .medical-order-pagination-controls, .medical-order-pagination { display: flex; align-items: center; gap: 8px; }
    .medical-order-pagination a, .medical-order-ellipsis { min-width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--app-border, #d9e0e9); border-radius: 7px; color: inherit; text-decoration: none; }
    .medical-order-pagination a.active { border-color: var(--app-accent, #1677e8); background: var(--app-accent, #1677e8); color: #fff; }
    .medical-order-pagination a.is-disabled { pointer-events: none; opacity: .42; }
    .medical-order-ellipsis { border-color: transparent; }
    .medical-order-editor { width: min(920px, calc(100vw - 32px)); max-height: calc(100vh - 32px); padding: 0; border: 0; border-radius: 18px; background: var(--app-surface, #fff); color: var(--app-text, #172033); box-shadow: 0 30px 90px rgba(15, 35, 65, .3); }
    .medical-order-editor::backdrop, .medical-order-delete-dialog::backdrop { background: rgba(13, 27, 48, .55); backdrop-filter: blur(3px); }
    .medical-order-editor-form { display: grid; gap: 16px; padding: 0 24px 22px; }
    .medical-order-dialog-header { position: sticky; top: 0; z-index: 2; display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin: 0 -24px; padding: 22px 24px 18px; border-bottom: 1px solid var(--app-border, #e4e9f0); background: linear-gradient(135deg, color-mix(in srgb, var(--app-accent, #1677e8) 9%, var(--app-surface, #fff)), var(--app-surface, #fff) 62%); }
    .medical-order-dialog-header h2 { margin: 3px 0 3px; font-size: 24px; }
