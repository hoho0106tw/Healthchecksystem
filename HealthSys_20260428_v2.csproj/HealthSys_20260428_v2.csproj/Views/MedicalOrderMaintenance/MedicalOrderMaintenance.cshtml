    .medical-order-dialog-close { width: 36px; height: 36px; display: grid; flex: 0 0 36px; place-items: center; padding: 0; border: 0; border-radius: 50%; background: color-mix(in srgb, var(--app-text, #172033) 7%, transparent); color: var(--app-text-muted, #687386); font-size: 25px; line-height: 1; cursor: pointer; }
    .medical-order-dialog-close:hover { background: color-mix(in srgb, var(--app-text, #172033) 12%, transparent); color: var(--app-text, #172033); }
    .medical-order-form-section { padding: 16px; border: 1px solid var(--app-border, #e1e7ef); border-radius: 13px; background: color-mix(in srgb, var(--app-surface-muted, #f5f7fa) 62%, var(--app-surface, #fff)); }
    .medical-order-form-section-title { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .medical-order-form-section-title > span { width: 34px; height: 34px; display: grid; place-items: center; flex: 0 0 34px; border-radius: 10px; background: var(--app-accent-soft, #eaf3ff); color: var(--app-accent-dark, #0f67c7); font-size: 11px; font-weight: 900; }
    .medical-order-form-section-title > div { display: grid; gap: 1px; }
    .medical-order-form-section-title strong { font-size: 14px; }
    .medical-order-form-section-title small { color: var(--app-text-muted, #687386); font-size: 11px; }
    .medical-order-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .medical-order-form-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .medical-order-form-stack { display: grid; gap: 11px; }
    .medical-order-field-wide { grid-column: 1 / -1; }
    .medical-order-editor-field { display: grid; gap: 6px; min-width: 0; color: var(--app-text-muted, #556174); font-size: 12px; font-weight: 750; }
    .medical-order-editor-field em { margin-left: 3px; color: #d43b3b; font-size: 10px; font-style: normal; }
    .medical-order-editor-field input { width: 100%; min-height: 40px; padding: 8px 10px; border: 1px solid var(--app-border, #cfd7e3); border-radius: 8px; background: var(--app-surface, #fff); color: var(--app-text, #172033); font: inherit; font-size: 14px; font-weight: 500; }
    .medical-order-editor-field input:focus { border-color: var(--app-accent, #1677e8); outline: 3px solid rgba(var(--app-accent-rgb, 22, 119, 232), .13); }
    .medical-order-category-combobox { position: relative; }
    .medical-order-combobox-input { position: relative; display: block; }
    .medical-order-combobox-input input { padding-right: 42px; }
    .medical-order-combobox-input > button { position: absolute; top: 4px; right: 4px; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 7px; background: color-mix(in srgb, var(--app-accent, #1677e8) 8%, transparent); color: var(--app-accent-dark, #0f67c7); font-size: 20px; line-height: 1; cursor: pointer; }
    .medical-order-combobox-input > button:hover { background: color-mix(in srgb, var(--app-accent, #1677e8) 15%, transparent); }
    .medical-order-combobox-menu { position: absolute; top: calc(100% + 5px); left: 0; z-index: 8; width: max-content; min-width: 100%; max-width: min(820px, calc(100vw - 96px)); max-height: 270px; grid-template-columns: repeat(2, max-content); gap: 5px; overflow: auto; padding: 8px; border: 1px solid var(--app-border, #d8e0ea); border-radius: 10px; background: var(--app-surface, #fff); box-shadow: 0 15px 36px rgba(18, 40, 72, .18); }
    .medical-order-combobox-menu:not([hidden]) { display: grid; }
    .medical-order-combobox-menu > button { width: auto; display: flex; padding: 5px 6px; border: 0; border-radius: 8px; background: transparent; text-align: left; cursor: pointer; }
    .medical-order-combobox-menu > button .medical-order-category { width: auto; }
    .medical-order-item-category-menu { grid-template-columns: repeat(2, minmax(160px, 1fr)); width: 100%; }
    .medical-order-item-category-menu > button { color: var(--app-text, #172033); font-size: 13px; font-weight: 600; }
    .medical-order-combobox-menu > button:hover, .medical-order-combobox-menu > button:focus-visible { background: color-mix(in srgb, var(--app-accent, #1677e8) 8%, transparent); outline: none; }
    .medical-order-category-no-result { grid-column: 1 / -1; display: block; padding: 12px 10px; color: var(--app-text-muted, #687386); font-size: 12px; font-weight: 500; line-height: 1.55; text-align: center; }
    .medical-order-output-section { margin-bottom: 0; }
    .medical-order-dialog-error { margin: 0; padding: 10px 12px; border: 1px solid #efb1b1; border-radius: 8px; background: #fff1f1; color: #a92929; font-size: 13px; }
    .medical-order-dialog-footer { position: sticky; bottom: 0; display: flex; justify-content: flex-end; gap: 9px; margin: 0 -24px -22px; padding: 15px 24px; border-top: 1px solid var(--app-border, #e4e9f0); background: var(--app-surface, #fff); }
    .medical-order-dialog-footer button { min-width: 96px; }
    .medical-order-delete-dialog { width: min(440px, calc(100vw - 32px)); padding: 0; border: 0; border-radius: 17px; background: var(--app-surface, #fff); color: var(--app-text, #172033); box-shadow: 0 30px 90px rgba(15, 35, 65, .3); }
    .medical-order-delete-form { display: grid; justify-items: center; gap: 10px; padding: 26px; text-align: center; }
    .medical-order-delete-icon { width: 52px; height: 52px; display: grid; place-items: center; border-radius: 50%; background: #fff0f0; color: #d23c3c; font-size: 25px; font-weight: 900; }
    .medical-order-delete-form h2 { margin: 2px 0 0; font-size: 22px; }
    .medical-order-delete-form p { margin: 0; }
    .medical-order-delete-form > span { color: var(--app-text-muted, #687386); font-size: 12px; line-height: 1.6; }
    .medical-order-delete-actions { width: 100%; display: flex; justify-content: flex-end; gap: 9px; margin-top: 10px; }
    .medical-order-confirm-delete { min-height: 40px; padding: 8px 15px; border: 1px solid #cc3434; border-radius: 8px; background: #d94242; color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .medical-order-confirm-delete:hover { background: #c83232; }
    .medical-order-dialog-footer button:disabled, .medical-order-confirm-delete:disabled { cursor: wait; opacity: .62; }
    .medical-order-toast { position: fixed; right: 24px; bottom: 24px; z-index: 40; max-width: min(360px, calc(100vw - 48px)); padding: 12px 16px; border: 1px solid rgba(var(--app-accent-rgb, 22, 119, 232), .3); border-radius: 10px; background: var(--app-surface, #fff); color: var(--app-text, #172033); box-shadow: 0 14px 38px rgba(15, 35, 65, .22); font-size: 14px; font-weight: 700; }
    @@media (max-width: 850px) {
        .medical-order-filter { grid-template-columns: 1fr; }
        .medical-order-actions { justify-content: flex-end; }
        .medical-order-grid-footer { align-items: flex-start; flex-direction: column; }
        .medical-order-form-columns, .medical-order-form-grid { grid-template-columns: 1fr; }
        .medical-order-field-wide { grid-column: auto; }
        .medical-order-combobox-menu { width: 100%; grid-template-columns: 1fr; }
    }
    .medical-order-page { min-width: 0; min-height: 0; height: 100%; display: flex; flex-direction: column; }
    .medical-order-category-panel, .medical-order-filter, .medical-order-alert { flex: 0 0 auto; }
    .medical-order-grid-panel { flex: 1 1 auto; min-height: 360px; display: grid; grid-template-rows: auto minmax(0, 1fr) minmax(60px, 4%); }
    .medical-order-table-wrap { min-height: 0; overflow: auto; }
    .medical-order-table thead th { position: sticky; top: 0; z-index: 1; }
    @@media (max-width: 1100px) { .medical-order-filter { grid-template-columns: minmax(0, 1fr); } }
    @@media (max-width: 850px) { .medical-order-grid-panel { grid-template-rows: auto minmax(0, 1fr) auto; } }
    @@media (min-height: 901px) { .medical-order-category-tabs { grid-template-rows: repeat(2, 34px); } }
    @@media (min-height: 1126px) { .medical-order-category-tabs { grid-template-rows: repeat(3, 34px); } }
</style>

<script>
    (() => {
        const search = document.querySelector("[data-category-index-search]");
        const tabs = document.querySelector("[data-medical-order-category-tabs]");
        if (!search || !tabs) return;

        search.addEventListener("input", () => {
            const keyword = search.value.trim().toLocaleLowerCase("zh-TW");
            tabs.querySelectorAll("button[data-category-name]").forEach(button => {
                const name = (button.dataset.categoryName || "").toLocaleLowerCase("zh-TW");
                button.hidden = keyword !== "" && !name.includes(keyword);
            });
        });

        const toast = document.querySelector("[data-medical-order-toast]");
        let toastTimer = 0;
        const showToast = message => {
            if (!toast) return;
            toast.textContent = message;
            toast.hidden = false;
            window.clearTimeout(toastTimer);
            toastTimer = window.setTimeout(() => { toast.hidden = true; }, 2800);
        };

        const page = document.querySelector(".medical-order-page");
        const editor = document.querySelector("[data-order-editor]");
        const editorForm = document.querySelector("[data-order-editor-form]");
        const editorError = document.querySelector("[data-editor-error]");
        const editorTitle = document.querySelector("[data-editor-title]");
        const editorEyebrow = document.querySelector("[data-editor-eyebrow]");
        const editorSubmit = document.querySelector("[data-editor-submit]");
        let editorMode = "create";

        const setEditorField = (name, value) => {
            const field = editorForm?.querySelector(`[data-field="${name}"]`);
            if (field) field.value = value || "";
        };

        const openEditor = (mode, values = {}) => {
            if (!editor || !editorForm) return;
            editorMode = mode;
            editorForm.reset();
            editorError.hidden = true;
            setEditorField("OriginalCheckNo", mode === "edit" ? values.checkNo : "");
            setEditorField("CheckNo", values.checkNo);
            setEditorField("Name", values.name);
            setEditorField("CheckCategory", values.checkCategory);
            setEditorField("ItemCategory", values.itemCategory);
            setEditorField("EName", values.eName);
            setEditorField("Format", values.format);
            setEditorField("Unit", values.unit);
            closeCategoryMenu();
            closeItemCategoryMenu();
            editorTitle.textContent = mode === "edit" ? "編輯醫令" : "新增醫令";
            editorEyebrow.textContent = mode === "edit" ? "更新既有資料" : "建立新資料";
            editorSubmit.textContent = mode === "edit" ? "儲存變更" : "新增醫令";
            editor.showModal();
            window.setTimeout(() => editorForm.querySelector('[name="CheckNo"]')?.focus(), 50);
        };

        document.querySelector("[data-order-add]")?.addEventListener("click", () => openEditor("create"));
        document.querySelectorAll("[data-order-edit]").forEach(button => {
            button.addEventListener("click", () => openEditor("edit", button.dataset));
        });
        document.querySelectorAll("[data-editor-close], [data-editor-cancel]").forEach(button => {
            button.addEventListener("click", () => editor?.close());
        });
        editor?.addEventListener("click", event => {
            if (event.target === editor) editor.close();
        });

        const categoryCombobox = document.querySelector("[data-category-combobox]");
        const categoryInput = categoryCombobox?.querySelector('[name="CheckCategory"]');
        const categoryMenu = categoryCombobox?.querySelector("[data-category-menu]");
        const categoryToggle = categoryCombobox?.querySelector("[data-category-toggle]");
        const categoryNoResult = categoryCombobox?.querySelector("[data-category-no-result]");
        const categoryOptions = Array.from(categoryCombobox?.querySelectorAll("[data-category-option]") || []);

        function filterCategoryOptions() {
            const keyword = (categoryInput?.value || "").trim().toLocaleLowerCase("zh-TW");
            let visibleCount = 0;
            categoryOptions.forEach(option => {
                const text = (option.dataset.categorySearch || "").toLocaleLowerCase("zh-TW");
                option.hidden = keyword !== "" && !text.includes(keyword);
                if (!option.hidden) visibleCount += 1;
            });
            if (categoryNoResult) categoryNoResult.hidden = visibleCount > 0;
        }

        function openCategoryMenu() {
            if (!categoryMenu || !categoryInput) return;
            filterCategoryOptions();
            categoryMenu.hidden = false;
            categoryInput.setAttribute("aria-expanded", "true");
        }

        function closeCategoryMenu() {
            if (!categoryMenu || !categoryInput) return;
            categoryMenu.hidden = true;
            categoryInput.setAttribute("aria-expanded", "false");
        }

        categoryToggle?.addEventListener("click", () => {
            if (categoryMenu?.hidden) openCategoryMenu(); else closeCategoryMenu();
            categoryInput?.focus();
        });
        categoryInput?.addEventListener("focus", openCategoryMenu);
        categoryInput?.addEventListener("input", () => {
            openCategoryMenu();
            filterCategoryOptions();
        });
        categoryOptions.forEach(option => {
            option.addEventListener("click", () => {
                categoryInput.value = option.dataset.categoryOption || "";
                closeCategoryMenu();
                categoryInput.focus();
            });
        });
        document.addEventListener("click", event => {
            if (categoryCombobox && !categoryCombobox.contains(event.target)) closeCategoryMenu();
        });

        const itemCategoryCombobox = document.querySelector("[data-item-category-combobox]");
        const itemCategoryInput = itemCategoryCombobox?.querySelector('[name="ItemCategory"]');
        const itemCategoryMenu = itemCategoryCombobox?.querySelector("[data-item-category-menu]");
        const itemCategoryToggle = itemCategoryCombobox?.querySelector("[data-item-category-toggle]");
        const itemCategoryNoResult = itemCategoryCombobox?.querySelector("[data-item-category-no-result]");
        const itemCategoryOptions = Array.from(itemCategoryCombobox?.querySelectorAll("[data-item-category-option]") || []);

        function filterItemCategoryOptions() {
            const keyword = (itemCategoryInput?.value || "").trim().toLocaleLowerCase("zh-TW");
            let visibleCount = 0;
            itemCategoryOptions.forEach(option => {
                const text = (option.dataset.itemCategorySearch || "").toLocaleLowerCase("zh-TW");
                option.hidden = keyword !== "" && !text.includes(keyword);
                if (!option.hidden) visibleCount += 1;
            });
            if (itemCategoryNoResult) itemCategoryNoResult.hidden = visibleCount > 0;
        }

        function openItemCategoryMenu() {
            if (!itemCategoryMenu || !itemCategoryInput) return;
            filterItemCategoryOptions();
            itemCategoryMenu.hidden = false;
            itemCategoryInput.setAttribute("aria-expanded", "true");
        }

        function closeItemCategoryMenu() {
            if (!itemCategoryMenu || !itemCategoryInput) return;
            itemCategoryMenu.hidden = true;
            itemCategoryInput.setAttribute("aria-expanded", "false");
        }

        itemCategoryToggle?.addEventListener("click", () => {
            if (itemCategoryMenu?.hidden) openItemCategoryMenu(); else closeItemCategoryMenu();
            itemCategoryInput?.focus();
        });
        itemCategoryInput?.addEventListener("focus", openItemCategoryMenu);
        itemCategoryInput?.addEventListener("input", () => {
            openItemCategoryMenu();
            filterItemCategoryOptions();
        });
        itemCategoryOptions.forEach(option => {
            option.addEventListener("click", () => {
                itemCategoryInput.value = option.dataset.itemCategoryOption || "";
                closeItemCategoryMenu();
                itemCategoryInput.focus();
            });
        });
        document.addEventListener("click", event => {
            if (itemCategoryCombobox && !itemCategoryCombobox.contains(event.target)) closeItemCategoryMenu();
        });

        const readResponse = async response => {
            const contentType = response.headers.get("content-type") || "";
            if (contentType.includes("application/json")) return response.json();
            return { message: await response.text() };
        };

        editorForm?.addEventListener("submit", async event => {
            event.preventDefault();
            if (!editorForm.reportValidity() || !page) return;
            editorError.hidden = true;
            editorSubmit.disabled = true;
            editorSubmit.textContent = "儲存中…";

            try {
                const url = editorMode === "edit" ? page.dataset.updateUrl : page.dataset.createUrl;
                const response = await fetch(url, { method: "POST", body: new FormData(editorForm) });
                const result = await readResponse(response);
                if (!response.ok || !result.saved) throw new Error(result.message || "醫令儲存失敗。");
                editor.close();
                showToast(result.message || "醫令已儲存。");
                window.setTimeout(() => window.location.reload(), 650);
            } catch (error) {
                editorError.textContent = error.message || "醫令儲存失敗。";
                editorError.hidden = false;
            } finally {
                editorSubmit.disabled = false;
                editorSubmit.textContent = editorMode === "edit" ? "儲存變更" : "新增醫令";
            }
        });

        const deleteDialog = document.querySelector("[data-delete-dialog]");
        const deleteForm = document.querySelector("[data-delete-form]");
        const deleteCode = document.querySelector("[data-delete-code]");
        const deleteCodeInput = document.querySelector("[data-delete-code-input]");
        const deleteError = document.querySelector("[data-delete-error]");
        const deleteSubmit = document.querySelector("[data-delete-submit]");

        document.querySelectorAll("[data-order-delete]").forEach(button => {
            button.addEventListener("click", () => {
                const code = button.dataset.orderCode || "";
                deleteCode.textContent = code;
                deleteCodeInput.value = code;
                deleteError.hidden = true;
                deleteDialog?.showModal();
            });
        });
        document.querySelector("[data-delete-cancel]")?.addEventListener("click", () => deleteDialog?.close());
        deleteDialog?.addEventListener("click", event => {
            if (event.target === deleteDialog) deleteDialog.close();
        });

        deleteForm?.addEventListener("submit", async event => {
            event.preventDefault();
            if (!page) return;
            deleteError.hidden = true;
            deleteSubmit.disabled = true;
            deleteSubmit.textContent = "刪除中…";

            try {
                const response = await fetch(page.dataset.deleteUrl, { method: "POST", body: new FormData(deleteForm) });
                const result = await readResponse(response);
                if (!response.ok || !result.deleted) throw new Error(result.message || "醫令刪除失敗。");
                deleteDialog.close();
                showToast(result.message || "醫令已刪除。");
                window.setTimeout(() => window.location.reload(), 650);
            } catch (error) {
                deleteError.textContent = error.message || "醫令刪除失敗。";
                deleteError.hidden = false;
            } finally {
                deleteSubmit.disabled = false;
                deleteSubmit.textContent = "確認刪除";
            }
        });
    })();
</script>
