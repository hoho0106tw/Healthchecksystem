@model HealthSys_20260428_v2.csproj.Models.AppointmentManagementViewModel

@{
    ViewData["Title"] = "預約清單";
    var selectedAppointment = Model.SelectedAppointment;
    var totalAppointmentCount = Model.SummaryCards.FirstOrDefault(card => card.Key == "total")?.Value ?? Model.Appointments.Count;
    var individualAppointmentCount = Model.SummaryCards.FirstOrDefault(card => card.Key == "individual")?.Value ?? 0;
    var groupAppointmentCount = Model.SummaryCards.FirstOrDefault(card => card.Key == "group")?.Value ?? 0;
    const int defaultPageSize = 20;
    var initialPageSize = Model.PageSizeOptions.Contains(defaultPageSize)
        ? defaultPageSize
        : Model.PageSizeOptions.FirstOrDefault();
    initialPageSize = initialPageSize > 0 ? initialPageSize : defaultPageSize;
    var initialVisibleCount = Math.Min(initialPageSize, Model.Appointments.Count);
}

<link rel="stylesheet" href="~/css/appointment-sorting.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/appointment-status-colors.css" asp-append-version="true" />

<section class="appointment-page appointment-list-page today-appointment-page" id="today-appointment-list" aria-label="預約清單" data-appointment-delete-url="@Url.Action("DeleteAppointment", "Appointment")" data-appointment-cancel-url="@Url.Action("CancelAppointment", "Appointment")" data-create-appointment-url="@Url.Action("CreateAppointment", "Appointment")" data-appointment-batch-register-url="@Url.Action("BathRegistered", "Appointment")" data-supplement-order-options-url="@Url.Action("GetSupplementOrderOptions", "Appointment")" data-supplement-order-submit-url="@Url.Action("AddSupplementOrders", "Appointment")" data-supplement-other-suite-lookup-url="@Url.Action("OtherSuiteLookupFrame", "Appointment")">
    @Html.AntiForgeryToken()
    <div data-ai-page="appointments" data-ai-result-count="@Model.Appointments.Count" data-ai-query-error="@Model.QueryErrorMessage" hidden></div>
    <span class="sr-only" id="individual-appointment">個人預約</span>
    <header class="appointment-page-header">
        <div>
            <div class="appointment-page-meta" aria-label="預約摘要">
                <span>共 <b class="indigo" data-dashboard-count="total">@totalAppointmentCount</b> 筆</span>
                <span>團檢 <b class="teal" data-dashboard-count="group">@groupAppointmentCount</b></span>
                <span>個人 <b class="violet" data-dashboard-count="individual">@individualAppointmentCount</b></span>
            </div>
        </div>
        <div class="appointment-page-actions">
            <button class="ghost-button appointment-refresh-button" type="button">
                <span class="refresh-mini-icon" aria-hidden="true"></span>
                <span>重新整理</span>
            </button>
            <button class="ghost-button appointment-export-button" type="button">
                <span>匯出</span>
                <span class="down-caret" aria-hidden="true"></span>
            </button>
            <a class="primary-button appointment-add-button" asp-controller="Appointment" asp-action="CreateAppointment" aria-label="新增臨時預約">
                <span class="plus-icon" aria-hidden="true"></span>
                <span>新增臨時預約</span>
            </a>
        </div>
    </header>

    <div class="appointment-list-layout">
        <div class="appointment-list-main">
            <section class="panel appointment-filter-panel" aria-label="預約查詢條件">
                <div class="field-group appointment-time-range-field">
                    <span>預約時間</span>
                    <span class="appointment-time-range">
                        <input type="date" value="@Model.FilterStartDate.Replace("/", "-")" aria-label="預約開始日期" min="0001-01-01" max="9999-12-30" data-appointment-start-date />
                        <span aria-hidden="true">至</span>
                        <input type="date" value="@Model.FilterEndDate.Replace("/", "-")" aria-label="預約結束日期" min="0001-01-01" max="9999-12-30" data-appointment-end-date />
                    </span>
                </div>
                <label class="field-group">
                    <span>預約區域</span>
                    <select aria-label="預約區域" data-reservation-area-filter>
                        @foreach (var option in Model.ReservationAreaOptions)
                        {
                            <option value="@option.Value" selected="@option.IsSelected">@option.Text</option>
                        }
                    </select>
                </label>
                <label class="field-group">
                    <span>預約狀態</span>
                    <select aria-label="預約狀態" data-appointment-status-filter>
                        @foreach (var option in Model.AppointmentStatusOptions)
                        {
                            <option value="@option.Value" selected="@option.IsSelected">@option.Text</option>
                        }
                    </select>
                </label>
                <label class="field-group search-field">
                    <span>關鍵字搜尋</span>
                    <span class="appointment-search-box">
                        <input type="search" value="@Model.FilterKeyword" placeholder="姓名 / 身分證 / 專案編號 / Barcode / 公司" aria-label="搜尋姓名、身分證、專案編號、Barcode 或公司" data-appointment-keyword-filter />
                    </span>
                </label>
                <div class="appointment-filter-actions">
                    <button class="primary-button appointment-filter-search-button" type="button" data-appointment-search-button>
                        <span class="search-icon" aria-hidden="true"></span>
                        <span data-appointment-search-label>搜尋</span>
                    </button>
                    <span class="appointment-query-status" role="status" aria-live="polite" data-appointment-query-status></span>
                </div>
            </section>

            <section class="appointment-status-overview" aria-label="預約狀態人數統計">
                @foreach (var card in Model.StatusSummaryCards)
                {
                    <article class="appointment-status-metric @card.Tone" data-status-summary-card="@card.Key">
                        <div class="status-metric-content">
                            <div class="status-metric-main">
                                <span class="status-metric-icon" aria-hidden="true"></span>
                                <div class="status-metric-copy">
                                    <span>@card.Label</span>
                                    <strong><b data-status-summary-count="@card.Key-total">@card.TotalCount</b><small>人</small></strong>
                                </div>
                            </div>
                            <div class="status-metric-breakdown" aria-label="@card.Label 團檢與個人人數">
                                <span>團檢 <b data-status-summary-count="@card.Key-group">@card.GroupCount</b></span>
                                <span>個人 <b data-status-summary-count="@card.Key-individual">@card.IndividualCount</b></span>
                            </div>
                        </div>
                    </article>
                }
            </section>

            <section class="panel appointment-table-panel" aria-label="預約清單">
                <div class="appointment-batch-toolbar" aria-label="批次掛號工具列">
                    <div class="appointment-batch-selection" aria-live="polite">
                        <strong data-batch-selected-count>已標記 0 筆預約</strong>
                        <span data-batch-selection-hint>點選移動光棒，Ctrl 多選，Shift 範圍，Ctrl+A 全選</span>
                    </div>
                    <div class="appointment-batch-actions">
                        <button class="ghost-button appointment-batch-clear" type="button" data-batch-clear disabled>清除</button>
                        <button class="primary-button appointment-batch-register" type="button" data-batch-register disabled>批次掛號</button>
                    </div>
                </div>
                <div class="appointment-table-frame">
                    <div class="appointment-table-wrap" data-appointment-table-wrap>
                        <table class="appointment-table today-appointment-table">
                        <thead>
                            <tr>
                                <th>操作</th>
                                <th>受檢者</th>
                                <th>病歷號</th>
                                <th aria-sort="none"><button type="button" class="appointment-sort-button" data-appointment-sort="appointmentDate" aria-label="預約日期：點擊遞增排序">預約日期<span class="appointment-sort-arrows" aria-hidden="true"><span data-sort-direction="asc">▲</span><span data-sort-direction="desc">▼</span></span></button></th>
                                <th aria-sort="none"><button type="button" class="appointment-sort-button" data-appointment-sort="time" aria-label="時段：點擊遞增排序">時段<span class="appointment-sort-arrows" aria-hidden="true"><span data-sort-direction="asc">▲</span><span data-sort-direction="desc">▼</span></span></button></th>
                                <th aria-sort="none"><button type="button" class="appointment-sort-button" data-appointment-sort="status" aria-label="預約狀態：點擊遞增排序">預約狀態<span class="appointment-sort-arrows" aria-hidden="true"><span data-sort-direction="asc">▲</span><span data-sort-direction="desc">▼</span></span></button></th>
                                <th aria-sort="none"><button type="button" class="appointment-sort-button" data-appointment-sort="doctorName" aria-label="看診醫師：點擊遞增排序">看診醫師<span class="appointment-sort-arrows" aria-hidden="true"><span data-sort-direction="asc">▲</span><span data-sort-direction="desc">▼</span></span></button></th>
                                <th>診間號</th>
                                <th>預約區域</th>
                                <th>類型</th>
                                <th>公司 / 團體</th>
                                <th>方案</th>
                                <th>資料狀態</th>
                                <th>聯絡電話</th>
                                <th>備註</th>
                                <th>專案編號</th>
                                <th>Barcode編號</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model.Appointments)
                            {
                                var normalizedAppointmentStatus = (appointment.AppointmentStatus ?? string.Empty).Trim();
                                var normalizedReserveStatus = (appointment.ReserveStatus ?? string.Empty).Trim();
                                var currentReserveStatus = normalizedReserveStatus switch
                                {
                                    "0" or "1" or "2" or "4" or "5" => normalizedReserveStatus,
                                    _ when string.Equals(normalizedAppointmentStatus, "已預約", StringComparison.Ordinal) => "1",
                                    _ when string.Equals(normalizedAppointmentStatus, "已取消", StringComparison.Ordinal) => "0",
                                    _ when string.Equals(normalizedAppointmentStatus, "佔名額", StringComparison.Ordinal) => "2",
                                    _ when string.Equals(normalizedAppointmentStatus, "已掛號", StringComparison.Ordinal) => "4",
                                    _ when string.Equals(normalizedAppointmentStatus, "已報到", StringComparison.Ordinal) => "5",
                                    _ => ""
                                };
                                var isConfirmedStatus = currentReserveStatus == "1";
                                var isReservedSlotStatus = currentReserveStatus == "2";
                                var isCancelledStatus = currentReserveStatus == "0";
                                var isRegisteredStatus = currentReserveStatus == "4";
                                var canSupplementOrders = currentReserveStatus is "4" or "5";
                                var hasRegistrationStatus = currentReserveStatus is "4" or "5";
                                var hideReservedSlotAction = isConfirmedStatus || isReservedSlotStatus;

                                <tr class="@(appointment.Selected ? "is-selected" : "")"
                                    tabindex="0"
                                    aria-selected="@(appointment.Selected ? "true" : "false")"
                                    data-appointment-row
                                    data-name="@appointment.Name"
                                    data-appointment-date="@appointment.AppointmentDate"
                                    data-time="@appointment.Time"                               
                                    data-doctor-name="@appointment.DoctorName"
                                    data-doctor-id="@appointment.DoctorId"
                                    data-room-no="@appointment.RoomNo"
                                    data-work-area="@appointment.WorkArea"
                                    data-appointment-type="@appointment.Type"
                                    data-project-number="@appointment.ProjectNumber"
                                    data-self-pay-accounting-unit="@appointment.SelfPayAccountingUnit"
                                    data-barcode="@appointment.Barcode"
                                    data-pat-no="@appointment.PatNo"
                                    data-id-number="@appointment.IdNumber"
                                    data-gender="@appointment.Gender"
                                    data-has-selected-appointment-item="@appointment.HasSelectedAppointmentItem.ToString().ToLowerInvariant()"
                                    data-has-missing-accounting-unit="@appointment.HasMissingAccountingUnit.ToString().ToLowerInvariant()"
                                    data-company="@appointment.Company"
                                    data-plan="@appointment.Plan"
                                    data-phone="@appointment.Phone"
                                    data-note="@appointment.Note"
                                    data-status="@normalizedAppointmentStatus"
                                    data-status-tone="@appointment.AppointmentTone"
                                    data-reserve-status="@currentReserveStatus">
                                    <td>
                                        <div class="table-actions appointment-row-actions">
                                            <button class="row-more-button appointment-action-toggle" type="button" aria-haspopup="true" aria-expanded="false" aria-label="開啟 @appointment.Name 的操作選單">
                                                <span class="appointment-action-icon" aria-hidden="true"></span>
                                            </button>
                                            <div class="row-action-menu" role="menu" aria-label="@appointment.Name 的操作選單">
                                                <a class="query appointment-readonly-query-action" role="menuitem" asp-controller="Appointment" asp-action="CreateAppointment" asp-route-projectNumber="@appointment.ProjectNumber" asp-route-barcode="@appointment.Barcode" asp-route-reserveStatus="@currentReserveStatus" asp-route-readOnly="true" data-readonly-appointment-link hidden="@(!hasRegistrationStatus)">查詢個人預約</a>
                                                <button class="supplement-order" role="menuitem" type="button" data-supplement-order data-name="@appointment.Name" data-project-number="@appointment.ProjectNumber" data-barcode="@appointment.Barcode" hidden="@(!canSupplementOrders)">補下醫令</button>
                                                <button class="cancel-registration" role="menuitem" type="button" data-cancel-registration data-name="@appointment.Name" hidden="@(!isRegisteredStatus)">取消掛號</button>
                                                <a class="edit appointment-edit-register-action" role="menuitem" asp-controller="Appointment" asp-action="CreateAppointment" asp-route-projectNumber="@appointment.ProjectNumber" asp-route-barcode="@appointment.Barcode" asp-route-reserveStatus="@currentReserveStatus" data-edit-appointment-link data-standard-appointment-action hidden="@hasRegistrationStatus">
                                                <span class="appointment-edit-register-label">編輯預約</span>
                                            </a>
                                                <button class="status-confirmed" role="menuitem" type="button" data-update-appointment-status data-name="@appointment.Name" data-target-reserve-status="1" data-target-status-name="已預約" data-standard-appointment-action hidden="@(hasRegistrationStatus || isConfirmedStatus)">已預約</button>
                                                <button class="status-reserved-slot" role="menuitem" type="button" data-update-appointment-status data-name="@appointment.Name" data-target-reserve-status="2" data-target-status-name="佔名額" data-standard-appointment-action hidden="@(hasRegistrationStatus || hideReservedSlotAction)">佔名額</button>
                                                <button class="cancel" role="menuitem" type="button" data-cancel-appointment data-name="@appointment.Name" data-target-reserve-status="0" data-target-status-name="已取消" data-standard-appointment-action hidden="@(hasRegistrationStatus || isCancelledStatus)">取消預約</button>
                                                <button class="danger" role="menuitem" type="button" data-delete-appointment data-name="@appointment.Name" data-standard-appointment-action hidden="@hasRegistrationStatus">刪除</button>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@appointment.Name</td>
                                    <td>@appointment.PatNo</td>
                                    <td>@appointment.AppointmentDate</td>
                                    <td>@appointment.Time</td>
                                    <td><span class="appointment-status @appointment.AppointmentTone" data-appointment-status-cell>@appointment.AppointmentStatus</span></td>
                                    <td>@appointment.DoctorName</td>
                                    <td>@appointment.RoomNo</td>
                                    <td>@appointment.WorkArea</td>
                                    <td><span class="appointment-kind @appointment.TypeTone">@appointment.Type</span></td>
                                    <td>@appointment.Company</td>
                                    <td>@appointment.Plan</td>
                                    <td><span class="appointment-status @appointment.DataTone">@appointment.DataStatus</span></td>
                                    <td>@appointment.Phone</td>
                                    <td>@appointment.Note</td>
                                    <td>@appointment.ProjectNumber</td>
                                    <td>@appointment.Barcode</td>
                                </tr>
                            }
                        </tbody>
                        </table>
                    </div>
                    <div class="appointment-table-scrollbar" data-appointment-table-scrollbar tabindex="0" aria-label="預約清單水平捲動">
                        <div class="appointment-table-scrollbar-content" data-appointment-table-scrollbar-content></div>
                    </div>
                </div>
                <footer class="table-footer">
                    @if (Model.Appointments.Any())
                    {
                        <span>顯示第 1 - @initialVisibleCount 筆，共 @Model.Appointments.Count 筆</span>
                    }
                    else
                    {
                        <span>顯示 0 筆，共 0 筆</span>
                    }
                    <div class="pagination-controls">
                        <select class="page-select" aria-label="每頁筆數">
                            @foreach (var pageSize in Model.PageSizeOptions)
                            {
                                <option value="@pageSize" selected="@(pageSize == initialPageSize ? "selected" : null)">@pageSize 筆/頁</option>
                            }
                        </select>
                        <div class="pagination" aria-label="分頁">
                            <button type="button" data-pagination-prev disabled aria-label="上一頁">‹</button>
                            <button type="button" class="active" data-page="1" aria-current="page">1</button>
                            <button type="button" data-page="2">2</button>
                            <button type="button" data-page="3">3</button>
                            <button type="button" data-page="4">4</button>
                            <button type="button" data-page="5">5</button>
                            <button type="button" disabled>...</button>
                            <button type="button" data-page="13">13</button>
                            <button type="button" data-pagination-next aria-label="下一頁">›</button>
                        </div>
                    </div>
                </footer>
            </section>
        </div>

        <aside class="appointment-list-side" aria-label="預約側欄資訊">
            <section class="panel capacity-panel" aria-labelledby="capacity-title">
                <h2 id="capacity-title">時段容量 <span class="info-dot" aria-hidden="true">i</span></h2>
                <div class="capacity-list">
                    @foreach (var capacity in Model.CapacitySlots)
                    {
                        <article class="capacity-slot @(capacity.Active ? "is-active" : "")">
                            <div>
                                <strong>@capacity.Time</strong>
                                <span>@capacity.Detail</span>
                            </div>
                            <div class="capacity-count">
                                <strong>@capacity.Used</strong>
                                <span>@capacity.Hint</span>
                            </div>
                        </article>
                    }
                </div>
            </section>

            @if (selectedAppointment is not null)
            {
                <section class="panel selected-appointment-panel" aria-labelledby="selected-title">
                    <h2 id="selected-title">目前預約</h2>
                    <div class="selected-person-card">
                        <span class="person-avatar" aria-hidden="true"></span>
                        <div>
                            <strong data-selected-field="name">@selectedAppointment.Name</strong>
                            <span class="appointment-status @selectedAppointment.AppointmentTone" data-selected-field="status">@selectedAppointment.AppointmentStatus</span>
                            <p data-selected-field="projectNumber">@selectedAppointment.ProjectNumber</p>
                        </div>
                    </div>
                    <dl class="selected-appointment-data">
                        <div>
                            <dt>預約時段</dt>
                            <dd data-selected-field="dateTime">@selectedAppointment.AppointmentDate @selectedAppointment.Time</dd>
                        </div>
                        <div>
                            <dt>健檢方案</dt>
                            <dd data-selected-field="plan">@selectedAppointment.Plan</dd>
                        </div>
                        <div>
                            <dt>聯絡電話</dt>
                            <dd data-selected-field="phone">@selectedAppointment.Phone</dd>
                        </div>
                        <div>
                            <dt>提醒事項</dt>
                            <dd data-selected-field="note">@selectedAppointment.Note</dd>
                        </div>
                    </dl>
                    <div class="selected-actions">
                        <button class="primary-button wide-action" type="button" data-open-selected-appointment>
                            <span class="person-small-icon" aria-hidden="true"></span>
                            <span>預約</span>
                        </button>
                    </div>
                </section>
            }

            <section class="panel appointment-reminder-panel" aria-labelledby="reminder-title">
                <h2 id="reminder-title">今日提醒</h2>
                <div class="reminder-list">
                    @foreach (var reminder in Model.Reminders)
                    {
                        <div class="reminder-item @reminder.Tone">
                            <span class="reminder-icon @reminder.Icon" aria-hidden="true"></span>
                            <span>@reminder.Label</span>
                            <strong>@reminder.Value <small>@reminder.Unit</small></strong>
                        </div>
                    }
                </div>
            </section>
        </aside>
    </div>

    <div class="appointment-confirm-modal danger" data-appointment-query-error-modal hidden>
        <button class="appointment-confirm-backdrop" type="button" data-appointment-query-error-close aria-label="關閉查詢錯誤視窗"></button>
        <div class="appointment-confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="appointment-query-error-title" aria-describedby="appointment-query-error-message">
            <h2 id="appointment-query-error-title">查詢逾時</h2>
            <p id="appointment-query-error-message" data-appointment-query-error-message>@Model.QueryErrorMessage</p>
            <div class="appointment-confirm-actions">
                <button class="primary-button" type="button" data-appointment-query-error-close>關閉</button>
            </div>
        </div>
    </div>

    <div class="appointment-confirm-modal appointment-rejection-modal" data-appointment-rejection-modal hidden>
        <button class="appointment-confirm-backdrop" type="button" data-appointment-rejection-close aria-label="關閉拒絕預約視窗"></button>
        <div class="appointment-confirm-dialog appointment-rejection-dialog" role="alertdialog" aria-modal="true" aria-labelledby="appointment-rejection-title" aria-describedby="appointment-rejection-message">
            <div class="appointment-rejection-hero">
                <span class="appointment-rejection-icon" aria-hidden="true"><i></i></span>
                <div><span>RESERVATION CHECK</span><strong>預約資料完整性檢核</strong></div>
            </div>
            <h2 id="appointment-rejection-title" data-appointment-rejection-title>拒絕預約</h2>
            <p id="appointment-rejection-message" data-appointment-rejection-message>必要欄位尚未填寫完整，無法改為已預約。</p>
            <div class="appointment-rejection-detail">
                <span>請先補齊以下資料</span>
                <ul data-appointment-rejection-list></ul>
            </div>
            <div class="appointment-confirm-actions">
                <button class="primary-button" type="button" data-appointment-rejection-close>返回補齊資料</button>
            </div>
        </div>
    </div>

    <div class="appointment-confirm-modal" data-appointment-confirm-modal hidden>
        <button class="appointment-confirm-backdrop" type="button" data-appointment-confirm-close aria-label="關閉確認視窗"></button>
        <div class="appointment-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="appointment-confirm-title" aria-describedby="appointment-confirm-message">
            <div class="appointment-cancel-registration-hero" data-cancel-registration-confirm-hero hidden>
                <span class="appointment-cancel-registration-icon" aria-hidden="true"><i></i></span>
                <div>
                    <span>REGISTRATION CONTROL</span>
                    <strong>掛號狀態管理</strong>
                </div>
            </div>
            <h2 id="appointment-confirm-title" data-appointment-confirm-title>確認操作</h2>
            <p id="appointment-confirm-message" data-appointment-confirm-message></p>
            <p class="appointment-confirm-warning" data-appointment-confirm-warning hidden></p>
            <div class="appointment-confirm-actions">
                <button class="ghost-button" type="button" data-appointment-confirm-close>取消</button>
                <button class="primary-button" type="button" data-appointment-confirm-submit>確認</button>
            </div>
        </div>
    </div>

    <div class="appointment-supplement-order-modal" data-supplement-order-modal hidden>
        <button class="appointment-supplement-order-backdrop" type="button" data-supplement-order-close aria-label="關閉補下醫令視窗"></button>
        <div class="appointment-supplement-order-dialog" role="dialog" aria-modal="true" aria-label="補下醫令">
            <header class="appointment-supplement-order-header">
