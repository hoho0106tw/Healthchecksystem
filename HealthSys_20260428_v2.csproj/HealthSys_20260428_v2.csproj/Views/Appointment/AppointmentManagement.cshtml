                const name = String(unit?.name || "").normalize("NFKC").replace(/\s+/g, "").toLocaleLowerCase();
                return (!supplementActiveAccountingPrefix || getSupplementAccountingPrefix(unit) === supplementActiveAccountingPrefix)
                    && (!codeKeyword || code.includes(codeKeyword))
