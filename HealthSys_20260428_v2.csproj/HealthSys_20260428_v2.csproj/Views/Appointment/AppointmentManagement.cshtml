            };
            const visiblePackages = supplementAvailablePackages
                .map((item, originalIndex) => ({ item, originalIndex }))
                .filter(entry => {
                    const item = entry.item;
                    const haystack = (String(item?.orderNumber || item?.id || "") + " " + String(item?.name || "")).toLowerCase();
                    return !keyword || haystack.includes(keyword);
                })
                .sort((left, right) => {
                    const leftSelected = isSupplementPackageChecked(left.item);
                    const rightSelected = isSupplementPackageChecked(right.item);
                    if (leftSelected !== rightSelected) return leftSelected ? -1 : 1;
                    return left.originalIndex - right.originalIndex;
                })
                .map(entry => entry.item);
            const pageSize = Number(supplementPackagePageSize?.value || 5);
            const totalPages = Math.max(1, Math.ceil(visiblePackages.length / pageSize));
            supplementPackagePage = Math.min(Math.max(1, supplementPackagePage), totalPages);
            const pagePackages = visiblePackages.slice(
                (supplementPackagePage - 1) * pageSize,
                supplementPackagePage * pageSize);
            if (supplementPackagePageInfo) {
                const start = visiblePackages.length ? (supplementPackagePage - 1) * pageSize + 1 : 0;
                const end = Math.min(supplementPackagePage * pageSize, visiblePackages.length);
                supplementPackagePageInfo.textContent = "顯示 " + (visiblePackages.length ? start + "–" + end : "0") + " 筆，共 " + visiblePackages.length + " 筆";
            }
            renderSupplementPagination(
                supplementPackagePagination,
                supplementPackagePage,
                totalPages,
                pageNumber => { supplementPackagePage = pageNumber; renderSupplementAvailablePackages(); });

            if (visiblePackages.length === 0) {
                if (supplementPackageSelectAll) {
                    supplementPackageSelectAll.checked = false;
                    supplementPackageSelectAll.indeterminate = false;
                    supplementPackageSelectAll.disabled = true;
                }
                renderSupplementOrderMessage(
                    supplementPackagePickerBody,
                    keyword ? "找不到符合的套餐／套組" : "此專案沒有可新增的套餐／套組",
                    "",
                    false,
                    4);
                return;
            }

            const rows = pagePackages.flatMap(packageOption => {
                const row = document.createElement("tr");
                const orderNumber = String(packageOption?.orderNumber || packageOption?.id || "").trim();
                const normalizedOrderNumber = normalizeSupplementOrderNumber(orderNumber);
                const existingPackage = getSupplementExistingPackage(packageOption);
                const alreadyExists = Boolean(existingPackage)
                    || supplementExistingOrderNumbers.has(normalizedOrderNumber);
                const alreadyAdded = newOrderNumbers.has(normalizedOrderNumber);
                const isExpanded = supplementExpandedPackageIds.has(String(packageOption?.id || orderNumber));

                const choiceCell = document.createElement("td");
                const checkbox = document.createElement("input");
                checkbox.type = "checkbox";
                checkbox.value = String(packageOption?.id || "");
                checkbox.dataset.supplementPickerPackage = "";
                checkbox.checked = alreadyExists || alreadyAdded;
                checkbox.disabled = alreadyExists;
                checkbox.setAttribute("aria-label", "選取 " + (packageOption?.name || orderNumber));
                choiceCell.append(checkbox);

                const nameCell = document.createElement("td");
                nameCell.className = "appointment-supplement-order-name";
                const nameWrapper = document.createElement("div");
                nameWrapper.className = "package-name-with-expand";
                const expandButton = document.createElement("button");
                expandButton.type = "button";
                expandButton.className = "package-row-expand";
                expandButton.value = String(packageOption?.id || orderNumber);
                expandButton.dataset.supplementPackageExpand = "";
                expandButton.setAttribute("aria-expanded", isExpanded ? "true" : "false");
                expandButton.setAttribute("aria-label", (isExpanded ? "收合 " : "展開 ") + (packageOption?.name || orderNumber) + " 醫令細項");
                const chevron = document.createElement("span");
                chevron.className = "suite-chevron";
                expandButton.append(chevron);
                const name = document.createElement("span");
                name.className = "item-name";
                name.textContent = packageOption?.name || "--";
                nameWrapper.append(expandButton, name);
                nameCell.append(nameWrapper);

                const accountingCell = document.createElement("td");
                if (alreadyExists) {
                    const accounting = document.createElement("span");
                    accounting.className = "appointment-supplement-order-original-unit";
                    accounting.textContent = existingPackage?.selfPayAccountingUnitDisplay
                        || packageOption?.selfPayAccountingUnitDisplay
                        || getSupplementUnitDisplay(existingPackage?.selfPayAccountingUnit || packageOption?.selfPayAccountingUnit);
                    accountingCell.append(accounting);
                } else {
                    accountingCell.append(createSupplementUnitButton(packageOption));
                }

                const moneyCell = document.createElement("td");
                moneyCell.className = "appointment-supplement-order-money";
                moneyCell.textContent = packageOption?.priceText || "$" + Number(packageOption?.price || 0).toLocaleString("zh-TW");

                row.classList.toggle("is-unavailable", alreadyExists);
                row.classList.toggle("is-existing", alreadyExists);
                row.classList.toggle("is-selected", alreadyExists || alreadyAdded);
                row.classList.toggle("is-expanded", isExpanded);
                row.append(choiceCell, nameCell, accountingCell, moneyCell);
                return isExpanded ? [row, createSupplementPackageDetailRow(packageOption)] : [row];
            });

            supplementPackagePickerBody.replaceChildren(...rows);
            if (supplementPackageSelectAll) {
                const selectable = pagePackages.filter(item =>
                    !getSupplementExistingPackage(item)
                    && !supplementExistingOrderNumbers.has(normalizeSupplementOrderNumber(item?.orderNumber || item?.id)));
                const selectedCount = selectable.filter(item =>
                    newOrderNumbers.has(normalizeSupplementOrderNumber(item?.orderNumber || item?.id))).length;
                supplementPackageSelectAll.disabled = selectable.length === 0;
                supplementPackageSelectAll.checked = selectable.length > 0 && selectedCount === selectable.length;
                supplementPackageSelectAll.indeterminate = selectedCount > 0 && selectedCount < selectable.length;
            }
        };

        const updateSupplementSelectedProject = () => {
            if (!supplementSelectedProject) return;
            supplementSelectedProject.value = supplementSelectedProjectNo
                ? "[" + supplementSelectedProjectNo + "] " + (supplementSelectedProjectName || "")
                : "";
            supplementSelectedProject.title = supplementSelectedProject.value;
        };
        const renderSupplementNewOrders = () => {
            if (!supplementNewOrderBody) return;
            const otherSuites = [
                ...supplementExistingOtherSuites.map(item => ({ ...item, isExisting: true })),
                ...supplementNewOrders
                    .filter(item => item.type === "other-suite")
                    .map(item => ({ ...item, isExisting: false }))
            ];
            const pageSize = Number(supplementOtherSuitePageSize?.value || 5);
            const totalPages = Math.max(1, Math.ceil(otherSuites.length / pageSize));
            supplementOtherSuitePage = Math.min(Math.max(1, supplementOtherSuitePage), totalPages);
            const pageItems = otherSuites.slice(
                (supplementOtherSuitePage - 1) * pageSize,
                supplementOtherSuitePage * pageSize);
            if (supplementOtherSuitePageInfo) {
                const start = otherSuites.length ? (supplementOtherSuitePage - 1) * pageSize + 1 : 0;
                const end = Math.min(supplementOtherSuitePage * pageSize, otherSuites.length);
                supplementOtherSuitePageInfo.textContent = "顯示 " + (otherSuites.length ? start + "–" + end : "0") + " 筆，共 " + otherSuites.length + " 筆";
            }
            renderSupplementPagination(
                supplementOtherSuitePagination,
                supplementOtherSuitePage,
                totalPages,
                pageNumber => { supplementOtherSuitePage = pageNumber; renderSupplementNewOrders(); });

            if (otherSuites.length === 0) {
                renderSupplementOrderMessage(
                    supplementNewOrderBody,
                    "請先新增組套");
                updateSupplementOrderCounts();
                return;
            }

            const rows = pageItems.map(item => {
                const row = document.createElement("tr");
                if (!item.isExisting) row.dataset.supplementNewOrder = item.id;
                row.classList.toggle("is-existing", item.isExisting);

                const codeCell = document.createElement("td");
                codeCell.className = "appointment-supplement-order-code";
                codeCell.textContent = item.orderNumber || "--";

                const nameCell = document.createElement("td");
                nameCell.className = "appointment-supplement-order-name";
                nameCell.textContent = item.name || "--";

                const accountingCell = document.createElement("td");
                if (item.isExisting) {
                    const accounting = document.createElement("span");
                    accounting.className = "appointment-supplement-order-original-unit";
                    accounting.textContent = item.selfPayAccountingUnitDisplay
                        || getSupplementUnitDisplay(item.selfPayAccountingUnit);
                    accountingCell.append(accounting);
                } else {
                    accountingCell.append(createSupplementUnitButton(item));
                }

                const moneyCell = document.createElement("td");
                moneyCell.className = "appointment-supplement-order-money";
                moneyCell.textContent = item.isExisting
                    ? "--"
                    : "$" + Number(item.price || 0).toLocaleString("zh-TW");

                const actionCell = document.createElement("td");
                if (!item.isExisting) {
                    const removeButton = document.createElement("button");
                    removeButton.type = "button";
                    removeButton.className = "appointment-supplement-order-remove-button";
                    removeButton.value = item.id;
                    removeButton.dataset.supplementRemoveOrder = "";
                    removeButton.textContent = "移除";
                    actionCell.append(removeButton);
                }

                row.append(nameCell, codeCell, accountingCell, moneyCell, actionCell);
                return row;
            });

            supplementNewOrderBody.replaceChildren(...rows);
            updateSupplementOrderCounts();
        };

        const closeSupplementOtherSuiteLookup = () => {
            if (supplementOtherSuiteLookupModal) supplementOtherSuiteLookupModal.hidden = true;
            if (supplementOtherSuiteLookupHost) supplementOtherSuiteLookupHost.replaceChildren();
        };

        const openSupplementOtherSuiteLookup = () => {
            if (!supplementOtherSuiteLookupModal || !supplementOtherSuiteLookupHost || !supplementOtherSuiteLookupUrl) return;

            const iframe = document.createElement("iframe");
            iframe.title = "新增其他醫令";
            const lookupUrl = new URL(supplementOtherSuiteLookupUrl, window.location.href);
            if (supplementSelectedProjectNo) lookupUrl.searchParams.set("projectNo", supplementSelectedProjectNo);
            if (supplementSelectedProjectName) lookupUrl.searchParams.set("projectName", supplementSelectedProjectName);
            iframe.src = lookupUrl.toString();
            iframe.loading = "eager";
            iframe.setAttribute("data-other-suite-lookup-frame", "");
            supplementOtherSuiteLookupHost.replaceChildren(iframe);
            supplementOtherSuiteLookupModal.hidden = false;
        };

        const importSupplementOtherSuites = (suites) => {
            const incomingSuites = Array.isArray(suites) ? suites : [];
            let duplicateCount = 0;

            incomingSuites.forEach(suite => {
                const projectNo = String(suite?.projectNo || suite?.ProjectNo || "").trim();
                const sourceId = String(suite?.id || suite?.Id || "").trim();
                const orderNumber = String(suite?.code || suite?.Code || sourceId.split("|").pop() || "").trim();
                const normalizedOrderNumber = normalizeSupplementOrderNumber(orderNumber);

                if (!normalizedOrderNumber
                    || supplementExistingOrderNumbers.has(normalizedOrderNumber)
                    || getSupplementNewOrderNumbers().has(normalizedOrderNumber)) {
                    duplicateCount += 1;
                    return;
                }

                const code = String(suite?.selfPayAccountingUnit || suite?.SelfPayAccountingUnit || "00").trim() || "00";
                supplementNewOrders.push({
                    id: "other-suite|" + (sourceId || projectNo + "|" + orderNumber),
                    sourceId: sourceId,
                    projectNo: projectNo,
                    type: "other-suite",
                    orderNumber: orderNumber,
                    name: String(suite?.name || suite?.Name || orderNumber).trim(),
                    selfPayAccountingUnit: code,
                    selfPayAccountingUnitDisplay: String(
                        suite?.selfPayAccountingUnitDisplay
                        || suite?.SelfPayAccountingUnitDisplay
                        || getSupplementUnitDisplay(code)),
                    price: Number(suite?.price ?? suite?.Price ?? 0)
                });
            });

            renderSupplementNewOrders();
            renderSupplementAvailablePackages();
            closeSupplementOtherSuiteLookup();

            if (duplicateCount > 0) {
                window.alert("已略過 " + duplicateCount + " 個既有或重複的組套。");
            }
        };

        const closeSupplementOrderDialog = () => {
            if (supplementOrderSubmitInProgress) return;
            supplementOrderRequestController?.abort();
            supplementOrderRequestController = null;
            closeSupplementAccountingLookup();
            closeSupplementOtherSuiteLookup();
            if (supplementOrderModal) supplementOrderModal.hidden = true;
        };

        const waitForSupplementFeedback = milliseconds =>
            new Promise(resolve => window.setTimeout(resolve, Math.max(0, milliseconds)));

        const showSupplementOrderProgress = () => {
            const messages = [
                "正在準備掛號與醫令參數…",
                "正在逐筆送出補下醫令…",
                "正在確認每筆醫令執行結果…",
                "正在更新健檢套組資料…"
            ];
            let messageIndex = 0;
            if (supplementOrderProgressMessage) supplementOrderProgressMessage.textContent = messages[messageIndex];
            if (supplementOrderProgressModal) supplementOrderProgressModal.hidden = false;
            window.clearInterval(supplementOrderProgressTimer);
            supplementOrderProgressTimer = window.setInterval(() => {
                messageIndex = (messageIndex + 1) % messages.length;
                if (supplementOrderProgressMessage) supplementOrderProgressMessage.textContent = messages[messageIndex];
            }, 1450);
        };

        const hideSupplementOrderProgress = () => {
            window.clearInterval(supplementOrderProgressTimer);
            supplementOrderProgressTimer = 0;
            if (supplementOrderProgressModal) supplementOrderProgressModal.hidden = true;
        };

        const showSupplementOrderResult = (state, message) => {
            const succeeded = state === "success";
            supplementOrderSubmitSucceeded = succeeded;
            if (!supplementOrderResultModal) {
                window.alert(message);
                if (succeeded) window.location.reload();
                return;
            }
            supplementOrderResultModal.dataset.state = succeeded ? "success" : "error";
            if (supplementOrderResultKicker) supplementOrderResultKicker.textContent = succeeded ? "ORDER CREATED" : "ORDER FAILED";
            if (supplementOrderResultTitle) supplementOrderResultTitle.textContent = succeeded ? "新增成功" : "新增失敗";
            if (supplementOrderResultMessage) supplementOrderResultMessage.textContent = message;
            if (supplementOrderResultCloseButton) supplementOrderResultCloseButton.textContent = succeeded ? "完成" : "關閉並返回";
            supplementOrderResultModal.hidden = false;
            supplementOrderResultCloseButton?.focus();
        };

        const closeSupplementOrderResult = () => {
            if (supplementOrderResultModal) supplementOrderResultModal.hidden = true;
            if (supplementOrderSubmitSucceeded) {
                window.location.reload();
                return;
            }
            supplementOrderSubmitButton?.focus();
        };

        const submitSupplementOrders = async () => {
            if (supplementOrderSubmitInProgress) return;
            if (!supplementOrderSubmitUrl || !supplementTargetProjectNo || !supplementTargetBarcode) {
                showSupplementOrderResult("error", "缺少補下醫令送出網址或預約識別資料。");
                return;
            }

            if (supplementNewOrders.length === 0) {
                showSupplementOrderResult("error", "請至少勾選一個健檢專案 / 方案套組，或新增一個其他組套。");
                return;
            }

            const packages = supplementNewOrders.filter(item => item.type === "package");
            const otherSuites = supplementNewOrders.filter(item => item.type === "other-suite");
            const payload = {
                projectNumber: supplementTargetProjectNo,
                barcode: supplementTargetBarcode,
                packageProjectNo: supplementSelectedProjectNo,
                selectedPackageIds: packages.map(item => item.sourceId),
                selectedPackageNames: packages.map(item => item.name),
                selectedPackageAmounts: packages.map(item => String(item.price || 0)),
                selectedPackageSelfPayAccountingUnits: packages.map(item => item.selfPayAccountingUnit || "00"),
                selectedOtherSuiteIds: otherSuites.map(item => item.sourceId),
                selectedOtherSuiteSelfPayAccountingUnits: otherSuites.map(item => item.selfPayAccountingUnit || "00")
            };

            supplementOrderSubmitInProgress = true;
            supplementOrderSubmitSucceeded = false;
            if (supplementOrderSubmitButton) supplementOrderSubmitButton.disabled = true;
            if (supplementOrderCancelButton) supplementOrderCancelButton.disabled = true;
            supplementOrderCloseButtons.forEach(button => { button.disabled = true; });
            const feedbackStartedAt = window.performance.now();
            showSupplementOrderProgress();

            try {
                const response = await fetch(supplementOrderSubmitUrl, {
                    method: "POST",
                    headers: {
                        "Accept": "application/json",
                        "Content-Type": "application/json",
                        "RequestVerificationToken": antiForgeryToken,
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: JSON.stringify(payload)
                });
                const result = await response.json().catch(() => null);
                if (!response.ok || result?.success === false) {
                    throw new Error(result?.message || "補下醫令新增失敗。");
                }

                await waitForSupplementFeedback(750 - (window.performance.now() - feedbackStartedAt));
                hideSupplementOrderProgress();
                showSupplementOrderResult("success", result?.message || "補下醫令已新增完成，資料已成功儲存。");
            } catch (error) {
                await waitForSupplementFeedback(750 - (window.performance.now() - feedbackStartedAt));
                hideSupplementOrderProgress();
                showSupplementOrderResult("error", error?.message || "補下醫令新增失敗，請稍後再試。");
            } finally {
                supplementOrderSubmitInProgress = false;
                if (supplementOrderCancelButton) supplementOrderCancelButton.disabled = false;
                supplementOrderCloseButtons.forEach(button => { button.disabled = false; });
                updateSupplementOrderCounts();
            }
        };

        const openSupplementOrderDialog = async (row) => {
            if (!supplementOrderModal || !row) return;

            const projectNumber = String(row.dataset.projectNumber || "").trim();
            const barcode = String(row.dataset.barcode || "").trim();
            supplementTargetProjectNo = projectNumber;
            supplementTargetBarcode = barcode;
            if (supplementOrderName) supplementOrderName.textContent = row.dataset.name || "--";
            if (supplementOrderProject) supplementOrderProject.textContent = projectNumber || "--";
            if (supplementOrderBarcode) supplementOrderBarcode.textContent = barcode || "--";
            if (supplementPackageSearch) supplementPackageSearch.value = "";
            supplementSelectedProjectNo = projectNumber;
            supplementSelectedProjectName = String(row.dataset.plan || "").trim();
            updateSupplementSelectedProject();

            supplementAccountingUnits = [];
            supplementAvailablePackages = [];
            supplementNewOrders = [];
            supplementExistingPackageItems = [];
            supplementExistingOrderNumbers = new Set();
            supplementExistingPackages = new Map();
            supplementExistingOtherSuites = [];
            supplementExpandedPackageIds = new Set();
            supplementPackagePage = 1;
            supplementOtherSuitePage = 1;
            renderSupplementPackageCategoryTabs();
            renderSupplementOrderMessage(supplementPackageBody, "正在載入當初的套餐／套組…", "", false, 4);
            renderSupplementOrderMessage(supplementOtherSuiteBody, "正在載入當初的其他組套…", "", false, 4);
            renderSupplementOrderMessage(supplementPackagePickerBody, "正在準備可新增的套餐／套組…", "", false, 4);
            renderSupplementNewOrders();
            supplementOrderModal.hidden = false;
            supplementOrderModal.querySelector("[data-supplement-order-close]")?.focus();

            if (!supplementOrderOptionsUrl || !projectNumber || !barcode) {
                const message = "缺少 PROJECTNO 或 BARCODESTR，無法載入原始選擇。";
                renderSupplementOrderMessage(supplementPackageBody, message, "", true, 4);
                renderSupplementOrderMessage(supplementOtherSuiteBody, message, "", true, 4);
                renderSupplementOrderMessage(supplementPackagePickerBody, message, "", true, 4);
                return;
            }

            supplementOrderRequestController?.abort();
            supplementOrderRequestController = new AbortController();

            try {
                const requestUrl = new URL(supplementOrderOptionsUrl, window.location.origin);
                requestUrl.searchParams.set("projectNumber", projectNumber);
                requestUrl.searchParams.set("barcode", barcode);
                const response = await fetch(requestUrl, {
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    signal: supplementOrderRequestController.signal
                });
                const result = await response.json().catch(() => null);

                if (!response.ok) {
                    throw new Error(result?.message || "載入補下醫令資料失敗。");
                }

                const existingPackages = Array.isArray(result?.packages) ? result.packages : [];
                const existingOtherSuites = Array.isArray(result?.otherSuites) ? result.otherSuites : [];
                supplementExistingPackageItems = existingPackages;
                supplementExistingOtherSuites = existingOtherSuites.map((item, index) => ({
                    id: "existing-other-suite|" + String(item?.orderNumber || index),
                    type: "other-suite",
                    orderNumber: String(item?.orderNumber || "").trim(),
                    name: String(item?.name || item?.orderNumber || "").trim(),
                    selfPayAccountingUnit: String(item?.selfPayAccountingUnit || "00").trim() || "00",
                    selfPayAccountingUnitDisplay: String(item?.selfPayAccountingUnitDisplay || "").trim(),
                    price: 0
                }));
                supplementAccountingUnits = Array.isArray(result?.selfPayAccountingUnits)
                    ? result.selfPayAccountingUnits
                    : [];
                supplementAvailablePackages = Array.isArray(result?.availablePackages)
                    ? result.availablePackages
                    : [];
                supplementExistingOrderNumbers = new Set(
                    existingPackages
                        .concat(existingOtherSuites)
                        .map(item => normalizeSupplementOrderNumber(item?.orderNumber))
                        .filter(Boolean));
                supplementExistingPackages = new Map();
                existingPackages.forEach(item => {
                    const code = normalizeSupplementOrderNumber(item?.orderNumber);
                    const name = normalizeSupplementOrderNumber(item?.name);
                    if (code) supplementExistingPackages.set("code|" + code, item);
                    if (name) supplementExistingPackages.set("name|" + name, item);

                    const alreadyInProject = supplementAvailablePackages.some(packageOption =>
                        (code && normalizeSupplementOrderNumber(packageOption?.orderNumber || packageOption?.id) === code)
                        || (name && normalizeSupplementOrderNumber(packageOption?.name) === name));
                    if (!alreadyInProject) {
                        supplementAvailablePackages.push({
                            id: String(item?.orderNumber || item?.name || ""),
                            orderNumber: String(item?.orderNumber || ""),
                            name: String(item?.name || item?.orderNumber || ""),
                            selfPayAccountingUnit: String(item?.selfPayAccountingUnit || "00"),
                            selfPayAccountingUnitDisplay: String(item?.selfPayAccountingUnitDisplay || ""),
                            price: 0,
                            priceText: "--",
                            orderTotal: 0,
                            orders: []
                        });
                    }
                });

                renderSupplementPackageCategoryTabs();

                renderExistingSupplementOrders(
                    supplementPackageBody,
                    existingPackages,
                    "當初未選擇套餐／套組",
                    supplementPackageCount);
                renderExistingSupplementOrders(
                    supplementOtherSuiteBody,
                    existingOtherSuites,
                    "當初未選擇其他組套",
                    supplementOtherSuiteCount);
                renderSupplementAvailablePackages();
                renderSupplementNewOrders();
            } catch (error) {
                if (error?.name === "AbortError") return;
                const message = error?.message || "載入補下醫令資料時發生錯誤，請稍後再試。";
                renderSupplementOrderMessage(supplementPackageBody, message, "", true, 4);
                renderSupplementOrderMessage(supplementOtherSuiteBody, message, "", true, 4);
                renderSupplementOrderMessage(supplementPackagePickerBody, message, "", true, 4);
                updateSupplementOrderCounts();
            } finally {
                supplementOrderRequestController = null;
            }
        };

        supplementAccountingCloseButtons.forEach(button =>
            button.addEventListener("click", closeSupplementAccountingLookup));
        supplementAccountingFilters.forEach(input =>
            input.addEventListener("input", renderSupplementAccountingRows));
        supplementAccountingClear?.addEventListener("click", () => {
            supplementAccountingFilters.forEach(input => { input.value = ""; });
            supplementActiveAccountingPrefix = "";
            renderSupplementAccountingTabs();
            renderSupplementAccountingRows();
            supplementAccountingFilters[0]?.focus();
        });
        supplementPackageSearch?.addEventListener("input", () => {
            supplementPackagePage = 1;
            renderSupplementAvailablePackages();
        });
        supplementPackageCategoryTabs?.addEventListener("click", event => {
            const button = event.target.closest("[data-supplement-package-category]");
            if (!button || !supplementPackageCategoryTabs.contains(button)) return;
            if (supplementPackageSearch) {
                supplementPackageSearch.value = button.dataset.supplementPackageCategory || "";
            }
            supplementPackagePage = 1;
            renderSupplementAvailablePackages();
        });
        supplementPackagePageSize?.addEventListener("change", () => {
            supplementPackagePage = 1;
            renderSupplementAvailablePackages();
        });
        supplementOtherSuitePageSize?.addEventListener("change", () => {
            supplementOtherSuitePage = 1;
            renderSupplementNewOrders();
        });
        supplementPackageSelectAll?.addEventListener("change", () => {
            const checkboxes = Array.from(
                supplementPackagePickerBody?.querySelectorAll("[data-supplement-picker-package]:not(:disabled)") || []);
            checkboxes.forEach(checkbox => {
                if (supplementPackageSelectAll.checked && !checkbox.checked) {
                    addSupplementPackage(checkbox.value);
                } else if (!supplementPackageSelectAll.checked && checkbox.checked) {
                    const packageOption = supplementAvailablePackages.find(item =>
                        String(item?.id || "") === String(checkbox.value || ""));
                    removeSupplementNewOrder("package|" + String(packageOption?.id || packageOption?.orderNumber || ""));
                }
            });
            renderSupplementAvailablePackages();
            renderSupplementNewOrders();
        });
        supplementAccountingAllClear?.addEventListener("click", () => {
            supplementNewOrders.filter(item => item.type === "package").forEach(item => {
                const source = supplementAvailablePackages.find(option =>
                    String(option?.id || "") === String(item.sourceId || ""));
                item.selfPayAccountingUnit = String(source?.selfPayAccountingUnit || "00").trim() || "00";
                item.selfPayAccountingUnitDisplay = source?.selfPayAccountingUnitDisplay
                    || getSupplementUnitDisplay(item.selfPayAccountingUnit);
            });
            renderSupplementAvailablePackages();
            updateSupplementOrderCounts();
        });
        supplementAccountingAllApply?.addEventListener("click", () => {
            const packages = supplementNewOrders.filter(item => item.type === "package");
            const first = packages[0];
            if (!first) return;
            packages.forEach(item => {
                item.selfPayAccountingUnit = first.selfPayAccountingUnit;
                item.selfPayAccountingUnitDisplay = first.selfPayAccountingUnitDisplay;
            });
            renderSupplementAvailablePackages();
            updateSupplementOrderCounts();
        });
        supplementPackagePickerBody?.addEventListener("change", event => {
            const checkbox = event.target.closest("[data-supplement-picker-package]");
            if (!checkbox || checkbox.disabled) return;

            if (checkbox.checked) {
                addSupplementPackage(checkbox.value);
            } else {
                const packageOption = supplementAvailablePackages.find(item =>
                    String(item?.id || "") === String(checkbox.value || ""));
                const itemId = "package|" + String(packageOption?.id || packageOption?.orderNumber || "");
                removeSupplementNewOrder(itemId);
            }
        });
        supplementPackagePickerBody?.addEventListener("click", event => {
            const button = event.target.closest("[data-supplement-package-expand]");
            if (!button) return;
            const packageId = String(button.value || "");
            if (supplementExpandedPackageIds.has(packageId)) {
                supplementExpandedPackageIds.delete(packageId);
            } else {
                supplementExpandedPackageIds.add(packageId);
            }
            renderSupplementAvailablePackages();
        });
        supplementNewOrderBody?.addEventListener("click", event => {
            const button = event.target.closest("[data-supplement-remove-order]");
            if (button) removeSupplementNewOrder(button.value);
        });
        supplementAddOtherSuiteButton?.addEventListener("click", openSupplementOtherSuiteLookup);
        supplementOrderSubmitButton?.addEventListener("click", submitSupplementOrders);
        supplementOrderCancelButton?.addEventListener("click", closeSupplementOrderDialog);
        supplementOrderResultCloseButton?.addEventListener("click", closeSupplementOrderResult);
        supplementOtherSuiteLookupCloseButtons.forEach(button =>
            button.addEventListener("click", closeSupplementOtherSuiteLookup));

        window.addEventListener("message", event => {
            if (event.origin !== window.location.origin || !event.data || supplementOtherSuiteLookupModal?.hidden) return;

            if (event.data.type === "healthsys:other-suite-selected") {
                importSupplementOtherSuites([event.data.suite]);
            } else if (event.data.type === "healthsys:other-suites-selected") {
                importSupplementOtherSuites(event.data.suites);
            } else if (event.data.type === "healthsys:other-suite-lookup-close") {
                closeSupplementOtherSuiteLookup();
            }
        });
        const closeAppointmentRejection = () => {
            if (rejectionModal) {
                rejectionModal.hidden = true;
            }
        };

        const openAppointmentRejection = ({ title = "拒絕預約", message, items = [] }) => {
            if (!rejectionModal || !rejectionTitle || !rejectionMessage || !rejectionList) {
                window.alert([title, message, ...items].filter(Boolean).join("\n"));
                return;
            }

            rejectionTitle.textContent = title;
            rejectionMessage.textContent = message || "這筆資料目前無法執行此操作。";
            rejectionList.replaceChildren(...items.map((item) => {
                const listItem = document.createElement("li");
                listItem.textContent = item;
                return listItem;
            }));
            rejectionModal.hidden = false;
            rejectionCloseButtons.find((button) => button !== rejectionModal.querySelector(".appointment-confirm-backdrop"))?.focus();
        };

        const getMissingConfirmedAppointmentFields = (row) => {
            const requiredFields = [
                ["patNo", "病歷號"], ["name", "姓名"], ["idNumber", "身分證 / 居留證號"],
                ["gender", "性別"], ["phone", "手機"], ["workArea", "預約區域"],
                ["appointmentDate", "預約日期"], ["time", "預約時間"],
                ["doctorId", "看診醫師"], ["roomNo", "診間號"], ["projectNumber", "健檢專案"]
            ];
            const missingFields = requiredFields
                .filter(([field]) => !String(row?.dataset[field] || "").trim())
                .map(([, label]) => label);

            if (row?.dataset.hasSelectedAppointmentItem !== "true") {
                missingFields.push("套餐 / 套組");
            } else if (row?.dataset.hasMissingAccountingUnit === "true") {
                missingFields.push("優待身分");
            }

            return missingFields;
        };

        const closeConfirmDialog = () => {
            if (!confirmModal) {
                return;
            }

            confirmModal.hidden = true;
            confirmModal.classList.remove("danger");
            confirmModal.classList.remove("cancel-registration");

            if (cancelRegistrationConfirmHero) {
                cancelRegistrationConfirmHero.hidden = true;
            }

            pendingConfirmAction = null;
        };

        const openConfirmDialog = ({ title, message, warning = "", confirmText = "確認", danger = false, variant = "", onConfirm }) => {
            if (!confirmModal || !confirmTitle || !confirmMessage || !confirmWarning || !confirmSubmit) {
                onConfirm?.();
                return;
            }

            confirmTitle.textContent = title;
            confirmMessage.textContent = message;
            confirmSubmit.textContent = confirmText;
            confirmModal.classList.toggle("danger", danger);
            confirmModal.classList.toggle("cancel-registration", variant === "cancel-registration");

            if (cancelRegistrationConfirmHero) {
                cancelRegistrationConfirmHero.hidden = variant !== "cancel-registration";
            }

            if (warning) {
                confirmWarning.textContent = warning;
                confirmWarning.hidden = false;
            } else {
                confirmWarning.textContent = "";
                confirmWarning.hidden = true;
            }

            pendingConfirmAction = onConfirm;
            confirmModal.hidden = false;
            confirmSubmit.focus();
        };

        const updateAppointmentStatus = (row, status, statusTone, reserveStatus, refreshFilters = true) => {
            const nextReserveStatus = String(reserveStatus || "").trim();
            const fallbackStatus = appointmentStatusByReserveStatus[nextReserveStatus] || appointmentStatusByReserveStatus["0"];
            const nextStatus = String(status || fallbackStatus.status).trim() || fallbackStatus.status;
            const nextStatusTone = String(statusTone || fallbackStatus.tone).trim() || fallbackStatus.tone;

            row.dataset.status = nextStatus;
            row.dataset.statusTone = nextStatusTone;

            if (nextReserveStatus) {
                row.dataset.reserveStatus = nextReserveStatus;
            }

            const statusCell = row.querySelector("[data-appointment-status-cell]");

            if (statusCell) {
                statusCell.textContent = nextStatus;
                statusCell.className = `appointment-status ${nextStatusTone}`.trim();
            }

            if (row.classList.contains("is-selected")) {
                setSelectedRow(row);
            }

            syncAppointmentStatusActions(row);

            if (refreshFilters) {
                applyAppointmentFilters(false);
            }
        };

        const syncAppointmentStatusActions = (row) => {
            const currentStatus = String(row?.dataset.status || "").trim();
            const reserveStatusValue = String(row?.dataset.reserveStatus || "").trim();
            const currentReserveStatus = ["0", "1", "2", "4", "5"].includes(reserveStatusValue)
                ? reserveStatusValue
                : String(reserveStatusByAppointmentStatus[currentStatus] || "").trim();
            const isRegisteredStatus = currentReserveStatus === "4";
            const hasRegistrationStatus = ["4", "5"].includes(currentReserveStatus);

            row?.querySelectorAll("[data-standard-appointment-action]").forEach((action) => {
                action.hidden = hasRegistrationStatus;
            });

            const cancelRegistrationButton = row?.querySelector("[data-cancel-registration]");
            const supplementOrderButton = row?.querySelector("[data-supplement-order]");
            const readOnlyQueryLink = row?.querySelector("[data-readonly-appointment-link]");

            if (cancelRegistrationButton) {
                cancelRegistrationButton.hidden = !isRegisteredStatus;
            }

            if (supplementOrderButton) {
                supplementOrderButton.hidden = !hasRegistrationStatus;
            }

            if (readOnlyQueryLink) {
                readOnlyQueryLink.hidden = !hasRegistrationStatus;
            }

            row?.querySelectorAll("[data-target-reserve-status]").forEach((button) => {
                const targetReserveStatus = String(button.dataset.targetReserveStatus || "").trim();
                const isCurrentStatus = Boolean(currentReserveStatus && targetReserveStatus === currentReserveStatus);
                const isBlockedReservedSlotAction = currentReserveStatus === "1" && targetReserveStatus === "2";

                button.hidden = hasRegistrationStatus || isCurrentStatus || isBlockedReservedSlotAction;

                if (isCurrentStatus) {
                    button.disabled = false;
                }
            });
        };

        const createCancelFormData = (row, reserveStatus) => {
            const formData = new FormData();
            const currentReserveStatus = String(row.dataset.reserveStatus || "").trim();
            const nextReserveStatus = String(reserveStatus || currentReserveStatus).trim();

            if (antiForgeryToken) {
                formData.append("__RequestVerificationToken", antiForgeryToken);
            }

            formData.append("ProjectNumber", row.dataset.projectNumber || "");
            formData.append("Barcode", row.dataset.barcode || "");
            formData.append("PatNo", row.dataset.patNo || "");
            formData.append("Name", row.dataset.name || "");
            formData.append("CurrentReserveStatus", currentReserveStatus);
            formData.append("ReserveStatus", nextReserveStatus);

            return formData;
        };

        const showCancelErrorMessage = (message) => {
            window.alert(String(message || "").trim() || "更新預約狀態失敗，請確認預約資料後再試一次。");
        };

        const cancelAppointmentRow = async (row, reserveStatus = "0", triggerButton = null) => {
            if (!row || !appointmentCancelUrl) {
                return;
            }

            if (!String(row.dataset.barcode || "").trim()) {
                showCancelErrorMessage("缺少 Barcode 編號，無法更新預約狀態。");
                return;
            }

            if (!["0", "1", "2"].includes(String(reserveStatus || "").trim())) {
                showCancelErrorMessage("預約狀態只能是已取消、已預約、佔名額。");
                return;
            }

            const cancelButton = triggerButton || row.querySelector(`[data-target-reserve-status='${reserveStatus}']`);

            if (cancelButton) {
                cancelButton.disabled = true;
            }

            try {
                const response = await fetch(appointmentCancelUrl, {
                    method: "POST",
                    body: createCancelFormData(row, reserveStatus),
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });
                let result = null;

                try {
                    result = await response.json();
                } catch {
                    result = null;
                }

                if (!response.ok) {
                    if (reserveStatus === "1" && result?.rejected === true) {
                        openAppointmentRejection({
                            title: result.title || "拒絕預約",
                            message: result.message,
                            items: Array.isArray(result.missingFields) ? result.missingFields : []
                        });
                    } else {
                        showCancelErrorMessage(result?.message);
                    }
                    return;
                }

                const updatedCount = Number.parseInt(result?.updatedCount || "0", 10);

                if (result?.updated === true || result?.canceled === true || updatedCount >= 1) {
                    updateAppointmentStatus(row, result?.status, result?.statusTone, result?.reserveStatus || reserveStatus);
                } else {
                    showCancelErrorMessage(result?.message || "更新預約狀態失敗，未更新任何預約資料。");
                }
            } catch {
                showCancelErrorMessage("更新預約狀態時發生錯誤，請稍後再試。");
            } finally {
                if (cancelButton && row.isConnected) {
                    cancelButton.disabled = false;
                }
            }
        };

        const removeAppointmentRow = (row) => {
            row.remove();
            allRows = Array.from(page.querySelectorAll("[data-appointment-row]"));
            applyAppointmentFilters(false);
        };

        const createDeleteFormData = (row) => {
            const formData = new FormData();

            if (antiForgeryToken) {
                formData.append("__RequestVerificationToken", antiForgeryToken);
            }

            formData.append("ProjectNumber", row.dataset.projectNumber || "");
            formData.append("Barcode", row.dataset.barcode || "");
            formData.append("PatNo", row.dataset.patNo || "");
            formData.append("Name", row.dataset.name || "");

            return formData;
        };

        const showDeleteErrorMessage = (message) => {
            window.alert(String(message || "").trim() || "刪除失敗，請確認預約資料後再試一次。");
        };

        const deleteAppointmentRow = async (row) => {
            if (!row || !appointmentDeleteUrl) {
                return;
            }

            if (!String(row.dataset.barcode || "").trim()) {
                showDeleteErrorMessage("缺少 Barcode 編號，無法刪除預約。");
                return;
            }

            const deleteButton = row.querySelector("[data-delete-appointment]");

            if (deleteButton) {
                deleteButton.disabled = true;
            }

            try {
                const response = await fetch(appointmentDeleteUrl, {
                    method: "POST",
                    body: createDeleteFormData(row),
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });
                let result = null;

                try {
                    result = await response.json();
                } catch {
                    result = null;
                }

                if (!response.ok) {
                    showDeleteErrorMessage(result?.message);
                    return;
                }

                const deletedCount = Number.parseInt(result?.deletedCount || "0", 10);

                if (result?.deleted === true || deletedCount >= 1) {
                    removeAppointmentRow(row);
                } else {
                    showDeleteErrorMessage(result?.message || "刪除失敗，未刪除任何預約資料。");
                }
            } catch {
                showDeleteErrorMessage("刪除預約時發生錯誤，請稍後再試。");
            } finally {
                if (deleteButton && row.isConnected) {
                    deleteButton.disabled = false;
                }
            }
        };

        const getFixedColumnsWidth = () => {
            const fixedHeaderCells = tableWrap?.querySelectorAll(".today-appointment-table thead th:nth-child(-n + 5)");

            if (fixedHeaderCells?.length) {
                return Array.from(fixedHeaderCells).reduce((width, cell) => width + cell.getBoundingClientRect().width, 0);
            }

            const styles = getComputedStyle(page);
            const readPixelValue = (name) => Number.parseFloat(styles.getPropertyValue(name)) || 0;

            return readPixelValue("--today-fixed-select-width")
                + readPixelValue("--today-fixed-action-width")
                + readPixelValue("--today-fixed-name-width")
                + readPixelValue("--today-fixed-date-width")
                + readPixelValue("--today-fixed-time-width")
                + readPixelValue("--today-fixed-patno-width");
        };

        const syncHorizontalScrollbarSize = () => {
            if (!tableWrap || !horizontalScrollbar || !horizontalScrollbarContent) {
                return;
            }

            const fixedColumnsWidth = getFixedColumnsWidth();
            const visibleScrollWidth = tableWrap.clientWidth - fixedColumnsWidth;
            const scrollableContentWidth = tableWrap.scrollWidth - fixedColumnsWidth;
            const hasHorizontalOverflow = tableWrap.scrollWidth > tableWrap.clientWidth + 1 && visibleScrollWidth > 0;
            const scrollbarLeft = Math.max(0, Math.min(fixedColumnsWidth, tableWrap.clientWidth));

            horizontalScrollbar.hidden = !hasHorizontalOverflow;
            page.style.setProperty("--today-fixed-columns-width", `${scrollbarLeft}px`);
            horizontalScrollbar.style.left = `${scrollbarLeft}px`;
            horizontalScrollbarContent.style.width = `${Math.max(scrollableContentWidth, visibleScrollWidth)}px`;

            if (hasHorizontalOverflow) {
                horizontalScrollbar.scrollLeft = tableWrap.scrollLeft;
            }
        };

        const syncFromTableScroll = () => {
            if (!horizontalScrollbar || isSyncingHorizontalScroll) {
                return;
            }

            closeActionMenus();
            isSyncingHorizontalScroll = true;
            horizontalScrollbar.scrollLeft = tableWrap?.scrollLeft || 0;
            isSyncingHorizontalScroll = false;
        };

        const syncFromHorizontalScrollbar = () => {
            if (!tableWrap || isSyncingHorizontalScroll) {
                return;
            }

            isSyncingHorizontalScroll = true;
            tableWrap.scrollLeft = horizontalScrollbar?.scrollLeft || 0;
            isSyncingHorizontalScroll = false;
        };

        if (tableWrap && horizontalScrollbar && horizontalScrollbarContent) {
            tableWrap.addEventListener("scroll", syncFromTableScroll);
            horizontalScrollbar.addEventListener("scroll", syncFromHorizontalScrollbar);
            tableWrap.addEventListener("wheel", (event) => {
                const horizontalDelta = event.shiftKey ? event.deltaY : event.deltaX;

                if (!horizontalDelta || horizontalScrollbar.hidden) {
                    return;
                }

                const maxScrollLeft = tableWrap.scrollWidth - tableWrap.clientWidth;
                const nextScrollLeft = Math.min(Math.max(tableWrap.scrollLeft + horizontalDelta, 0), maxScrollLeft);

                if (nextScrollLeft === tableWrap.scrollLeft) {
                    return;
                }

                tableWrap.scrollLeft = nextScrollLeft;
                event.preventDefault();
            }, { passive: false });

            window.addEventListener("resize", syncHorizontalScrollbarSize);
            window.addEventListener("resize", closeActionMenus);

            if ("ResizeObserver" in window) {
                const resizeObserver = new ResizeObserver(syncHorizontalScrollbarSize);
                resizeObserver.observe(tableWrap);
            }
        }

        page.addEventListener("click", (event) => {
            const toggle = event.target.closest(".appointment-action-toggle");

            if (toggle && page.contains(toggle)) {
                const actions = toggle.closest(".appointment-row-actions");

                if (actions?.classList.contains("is-open")) {
                    closeActionMenus();
                } else {
                    openActionMenu(actions);
                }

                event.stopPropagation();
                return;
            }

            const supplementOrderButton = event.target.closest("[data-supplement-order]");

            if (supplementOrderButton && page.contains(supplementOrderButton)) {
                const row = supplementOrderButton.closest("[data-appointment-row]");
                closeActionMenus();
                event.stopPropagation();
                openSupplementOrderDialog(row);
                return;
            }
            const cancelRegistrationButton = event.target.closest("[data-cancel-registration]");

            if (cancelRegistrationButton && page.contains(cancelRegistrationButton)) {
                const row = cancelRegistrationButton.closest("[data-appointment-row]");
                const name = cancelRegistrationButton.dataset.name || row?.dataset.name || "這筆預約";

                closeActionMenus();
                event.stopPropagation();

                openConfirmDialog({
                    title: "取消掛號",
                    message: `是否要執行「${name}」的取消掛號動作？`,
                    warning: "取消後將解除目前掛號狀態，請先確認受檢者資料及作業需求。",
                    confirmText: "確認",
                    danger: false,
                    variant: "cancel-registration",
                    onConfirm: () => cancelAppointmentRow(row, "1", cancelRegistrationButton)
                });
                return;
            }

            const editAppointmentLink = event.target.closest("[data-edit-appointment-link], [data-readonly-appointment-link]");

            if (editAppointmentLink && page.contains(editAppointmentLink)) {
                const row = editAppointmentLink.closest("[data-appointment-row]");

                if (row) {
                    setSelectedRow(row);
                }

                editAppointmentLink.href = appendAppointmentReturnUrl(editAppointmentLink.href);
                closeActionMenus();
                return;
            }

            const statusButton = event.target.closest("[data-update-appointment-status], [data-cancel-appointment]");

            if (statusButton && page.contains(statusButton)) {
                const row = statusButton.closest("[data-appointment-row]");
                const name = statusButton.dataset.name || row?.dataset.name || "這筆預約";
                const reserveStatus = statusButton.dataset.targetReserveStatus || "0";
                const targetStatusName = statusButton.dataset.targetStatusName
                    || appointmentStatusByReserveStatus[reserveStatus]?.status
                    || "預約狀態";
                const isCancelStatus = reserveStatus === "0";

                closeActionMenus();
                event.stopPropagation();

                if (!row) {
                    return;
                }

                if (reserveStatus === "1") {
                    const missingFields = getMissingConfirmedAppointmentFields(row);

                    if (missingFields.length > 0) {
                        openAppointmentRejection({
                            title: "拒絕預約",
                            message: `「${name}」的必要欄位尚未填寫完整，無法改為已預約。`,
                            items: missingFields
                        });
                        return;
                    }
                }

                openConfirmDialog({
                    title: isCancelStatus ? "取消預約" : "更新預約狀態",
                    message: `是否要將 ${name} 的預約狀態改為「${targetStatusName}」？`,
                    confirmText: isCancelStatus ? "確認取消" : "確認更新",
                    onConfirm: () => cancelAppointmentRow(row, reserveStatus, statusButton)
                });

                return;
            }

            const deleteButton = event.target.closest("[data-delete-appointment]");

            if (deleteButton && page.contains(deleteButton)) {
                const row = deleteButton.closest("[data-appointment-row]");
                const name = deleteButton.dataset.name || row?.dataset.name || "這筆預約";

                closeActionMenus();
                event.stopPropagation();

                if (!row) {
                    return;
                }

                openConfirmDialog({
                    title: "刪除預約",
                    message: `是否真的要刪除 ${name} 嗎？`,
                    warning: "刪除後，此筆資料就會消失。",
                    confirmText: "確認刪除",
                    danger: true,
                    onConfirm: () => deleteAppointmentRow(row)
                });
                return;
            }

            if (!event.target.closest(".appointment-row-actions")) {
                closeActionMenus();
            }
        });

        page.addEventListener("keydown", (event) => {
            const key = String(event.key || "").toLowerCase();

            if ((event.ctrlKey || event.metaKey) && key === "a" && !event.target.closest("input, textarea, select, [contenteditable='true']")) {
                event.preventDefault();
                selectAllBatchRows();
                return;
            }

            if (event.key === "Escape") {
                closeActionMenus();
                closeConfirmDialog();
                closeSupplementOrderDialog();
                closeBatchResultDialog();
                closeAppointmentQueryError();
            }
        });

        supplementOrderCloseButtons.forEach((button) => {
            button.addEventListener("click", closeSupplementOrderDialog);
        });
        confirmCloseButtons.forEach((button) => {
            button.addEventListener("click", closeConfirmDialog);
        });

        confirmSubmit?.addEventListener("click", () => {
            const action = pendingConfirmAction;

            closeConfirmDialog();
            action?.();
        });

        const getSelectedAppointmentRow = () => rows.find((row) => row.classList.contains("is-selected"))
            || allRows.find((row) => row.classList.contains("is-selected"))
            || null;

        const getAppointmentReturnUrl = () => `${window.location.pathname}${window.location.search}${window.location.hash}`;

        const appendAppointmentReturnUrl = (target) => {
            const url = new URL(target, window.location.href);

            url.searchParams.set("returnUrl", getAppointmentReturnUrl());

            return url.toString();
        };

        const buildSelectedAppointmentUrl = (row) => {
            const projectNumber = String(row?.dataset.projectNumber || "").trim();
            const barcode = String(row?.dataset.barcode || "").trim();
            const reserveStatus = String(row?.dataset.reserveStatus || "").trim();

            if (!createAppointmentUrl || !projectNumber || !barcode) {
                return "";
            }

            const url = new URL(createAppointmentUrl, window.location.href);
            url.searchParams.set("projectNumber", projectNumber);
            url.searchParams.set("barcode", barcode);

            if (reserveStatus) {
                url.searchParams.set("reserveStatus", reserveStatus);
            }

            return appendAppointmentReturnUrl(url.toString());
        };

        const syncSelectedAppointmentButton = (row = getSelectedAppointmentRow()) => {
            if (!selectedAppointmentButton) {
                return;
            }

            const canOpen = Boolean(buildSelectedAppointmentUrl(row));
            selectedAppointmentButton.disabled = !canOpen;
            selectedAppointmentButton.setAttribute("aria-disabled", canOpen ? "false" : "true");
        };

        const openSelectedAppointment = () => {
            const targetUrl = buildSelectedAppointmentUrl(getSelectedAppointmentRow());

            if (!targetUrl) {
                window.alert("缺少專案編號或 Barcode，無法帶入個人預約。");
                syncSelectedAppointmentButton();
                return;
            }

            window.location.assign(targetUrl);
        };

        const clearSelectedFields = () => {
            Object.entries(selectedFields).forEach(([fieldName, field]) => {
                if (!field) {
                    return;
                }

                field.textContent = "";

                if (fieldName === "status") {
                    field.className = "appointment-status";
                }
            });

            syncSelectedAppointmentButton(null);
        };

        const setSelectedRow = (row) => {
            rows.forEach((currentRow) => {
                const isSelected = currentRow === row;
                currentRow.classList.toggle("is-selected", isSelected);
                currentRow.setAttribute("aria-selected", isSelected ? "true" : "false");
            });

            syncSelectedAppointmentButton(row);

            if (!selectedFields.name) {
                return;
            }

            selectedFields.name.textContent = row.dataset.name || "";
            selectedFields.projectNumber.textContent = row.dataset.projectNumber || "";
            selectedFields.dateTime.textContent = `${row.dataset.appointmentDate || ""} ${row.dataset.time || ""}`.trim();
            selectedFields.plan.textContent = row.dataset.plan || "";
            selectedFields.phone.textContent = row.dataset.phone || "";
            selectedFields.note.textContent = row.dataset.note || "";

            if (selectedFields.status) {
                selectedFields.status.textContent = row.dataset.status || "";
                selectedFields.status.className = `appointment-status ${row.dataset.statusTone || ""}`.trim();
            }
        };

        const getCurrentPageRows = () => rows.filter((row) => !row.hidden);

        const getBatchSelectedRows = () => allRows.filter((row) => row.classList.contains("is-batch-selected"));

        const getBatchRegisterRows = () => {
            const isEligible = (row) => String(row?.dataset.reserveStatus || "").trim() === "1";
            const batchRows = getBatchSelectedRows().filter(isEligible);

            if (batchRows.length > 0) {
                return batchRows;
            }

            const selectedRow = getSelectedAppointmentRow();
            return selectedRow && isEligible(selectedRow) ? [selectedRow] : [];
        };

        const setBatchRowSelected = (row, selected) => row?.classList.toggle("is-batch-selected", selected);

        const syncBatchSelectionState = () => {
            const selectedRows = getBatchSelectedRows();
            const selectedCount = selectedRows.length;
            const registerCount = getBatchRegisterRows().length;
            const hasReservedSlot = selectedRows.some((row) => String(row.dataset.reserveStatus || "").trim() === "2")
                || (selectedCount === 0 && String(getSelectedAppointmentRow()?.dataset.reserveStatus || "").trim() === "2");

            if (batchSelectedCount) {
                batchSelectedCount.textContent = selectedCount > 0
                    ? `已標記 ${selectedCount} 筆預約`
                    : `目前選取 ${registerCount} 筆預約`;
            }
            if (batchSelectionHint) {
                batchSelectionHint.textContent = hasReservedSlot
                    ? "選取資料包含佔名額，請先補齊資料並改為已預約"
                    : selectedCount > 0
                        ? "點選只移動光棒，Ctrl 可增減單筆，Shift 可延伸範圍，Ctrl+A 全選"
                        : "可直接掛號目前選取的已預約資料；Ctrl 多選，Shift 範圍，Ctrl+A 全選";
            }
            if (batchRegisterButton) batchRegisterButton.disabled = registerCount === 0 || hasReservedSlot;
            if (batchClearButton) batchClearButton.disabled = selectedCount === 0;
        };
        const clearBatchSelection = () => {
            allRows.forEach((row) => setBatchRowSelected(row, false));
            batchSelectionAnchor = null;
            syncBatchSelectionState();
        };

        const toggleBatchRowSelection = (row) => {
            setBatchRowSelected(row, !row.classList.contains("is-batch-selected"));
            batchSelectionAnchor = row;
            syncBatchSelectionState();
        };

        const selectBatchRange = (fromRow, toRow) => {
            const fromIndex = rows.indexOf(fromRow);
            const toIndex = rows.indexOf(toRow);

            if (fromIndex < 0 || toIndex < 0) {
                setBatchRowSelected(toRow, true);
            } else {
                rows.slice(Math.min(fromIndex, toIndex), Math.max(fromIndex, toIndex) + 1)
                    .forEach((row) => setBatchRowSelected(row, true));
            }
            batchSelectionAnchor = toRow;
            syncBatchSelectionState();
        };

        const selectAllBatchRows = () => {
            allRows.forEach((row) => setBatchRowSelected(row, false));
            rows.forEach((row) => setBatchRowSelected(row, true));
            batchSelectionAnchor = rows.at(-1) || null;
            syncBatchSelectionState();
        };

        const closeBatchResultDialog = () => {
            if (batchResultModal) batchResultModal.hidden = true;
        };

        const showBatchProgressDialog = (count) => {
            isBatchRegisterRunning = true;

            if (batchRegisterButton) batchRegisterButton.disabled = true;
            if (batchClearButton) batchClearButton.disabled = true;
            if (batchProgressMessage) {
                batchProgressMessage.textContent = "正在處理 " + count + " 筆預約資料，請勿關閉頁面…";
            }
            if (batchProgressModal) {
                batchProgressModal.hidden = false;
            }
        };

        const hideBatchProgressDialog = () => {
            isBatchRegisterRunning = false;

            if (batchProgressModal) {
                batchProgressModal.hidden = true;
            }
            syncBatchSelectionState();
        };

        const normalizeBatchMessage = (value, fallback = "批次掛號失敗，請稍後再試。") => {
            let message = value;

            if (message instanceof Error) {
                message = message.message;
            }

            for (let depth = 0; depth < 3; depth += 1) {
                if (message && typeof message === "object") {
                    message = message.message ?? message.detail ?? message.title ?? "";
                    continue;
                }

                if (typeof message !== "string") {
                    return fallback;
                }

                const trimmedMessage = message.trim();
                if (!trimmedMessage) {
                    return fallback;
                }

                if (trimmedMessage.startsWith("{") || trimmedMessage.startsWith("[")) {
                    try {
                        message = JSON.parse(trimmedMessage);
                        continue;
                    } catch {
                        return fallback;
                    }
                }

                if (/<[a-z][\s\S]*>/i.test(trimmedMessage)) {
                    const documentContent = new DOMParser().parseFromString(trimmedMessage, "text/html");
                    message = documentContent.querySelector("h1, h2, title")?.textContent
                        ?? documentContent.body?.textContent
                        ?? "";
                    continue;
                }

                return trimmedMessage.replace(/\s+/g, " ");
            }

            return fallback;
        };

        const normalizeBatchResult = (result) => {
            const success = result?.success === true;

            return {
                success,
                projectNumber: String(result?.projectNumber ?? ""),
                barcode: String(result?.barcode ?? ""),
                patNo: String(result?.patNo ?? ""),
                name: String(result?.name ?? ""),
                message: normalizeBatchMessage(result?.message, success ? "掛號成功。" : "批次掛號失敗，請稍後再試。"),
                processedAt: String(result?.processedAt ?? "")
            };
        };

        const createBatchResultRow = (result) => {
            const item = document.createElement("article");
            item.className = `appointment-batch-result-item ${result.success ? "success" : "failed"}`;
            item.innerHTML = `<span class="appointment-batch-result-badge">${result.success ? "成功" : "失敗"}</span><div><strong></strong><div class="appointment-batch-result-meta"><span class="appointment-batch-result-patno"></span><span aria-hidden="true">·</span><span class="appointment-batch-result-project"></span></div><p></p></div><time></time>`;
            item.querySelector("strong").textContent = result.name || "未命名";
            item.querySelector(".appointment-batch-result-patno").textContent = `病歷號 ${result.patNo || "--"}`;
            item.querySelector(".appointment-batch-result-project").textContent = `專案編號 ${result.projectNumber || "--"}`;
            item.querySelector("p").textContent = result.message;
            item.querySelector("time").textContent = result.processedAt;
            return item;
        };

        const openBatchResultDialog = (results) => {
            if (!batchResultModal) return;
            const successCount = results.filter((result) => result.success).length;
            const failedCount = results.length - successCount;
            if (batchResultTotal) batchResultTotal.textContent = String(results.length);
            if (batchResultSuccess) batchResultSuccess.textContent = String(successCount);
            if (batchResultFailed) batchResultFailed.textContent = String(failedCount);
            if (batchResultList) batchResultList.replaceChildren(...results.map(createBatchResultRow));
            batchResultModal.dataset.state = failedCount ? (successCount ? "partial" : "failed") : "success";
            batchResultModal.hidden = false;
            batchResultModal.querySelector("[data-batch-result-close]")?.focus();
        };

        const runBatchRegister = async () => {
            if (isBatchRegisterRunning) {
                return;
            }

            const explicitlySelectedRows = getBatchSelectedRows();
            const candidateRows = explicitlySelectedRows.length > 0
                ? explicitlySelectedRows
                : [getSelectedAppointmentRow()].filter(Boolean);
            const reservedSlotRows = candidateRows.filter((row) => String(row.dataset.reserveStatus || "").trim() === "2");

            if (reservedSlotRows.length > 0) {
                openAppointmentRejection({
                    title: "無法批次掛號",
                    message: "佔名額資料不可執行批次掛號，請先完成必要欄位並改為已預約。",
                    items: reservedSlotRows.map((row) => row.dataset.name || row.dataset.barcode || "未命名資料")
                });
                return;
            }

            const selectedRows = getBatchRegisterRows();
            const selectedItems = selectedRows.map((row) => ({
                reserveStatus: row.dataset.reserveStatus || "",
                projectNumber: row.dataset.projectNumber || "",
                barcode: row.dataset.barcode || "",
                patNo: row.dataset.patNo || "",
                name: row.dataset.name || "",
                appointmentDate: row.dataset.appointmentDate || "",
                time: row.dataset.time || "",
                doctorName: row.dataset.doctorName || "",
                doctorId: row.dataset.doctorId || "",
                roomNo: row.dataset.roomNo || "",
                selfPayAccountingUnit: row.dataset.selfPayAccountingUnit || ""
            }));

            if (!selectedItems.length) {
                return;
            }

            if (!batchRegisterUrl) {
                lastBatchResults = selectedRows.map((row) => ({
                    success: false,
                    projectNumber: row.dataset.projectNumber || "",
                    barcode: row.dataset.barcode || "",
                    patNo: row.dataset.patNo || "",
                    name: row.dataset.name || "",
                    message: "找不到批次掛號的後端路由。",
                    processedAt: new Date().toLocaleString("zh-TW", { hour12: false })
                }));
                openBatchResultDialog(lastBatchResults);
                return;
            }

            closeActionMenus();
            showBatchProgressDialog(selectedItems.length);

            try {
                const response = await fetch(batchRegisterUrl, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": antiForgeryToken
                    },
                    body: JSON.stringify({ rows: selectedItems })
                });
                const responseText = await response.text();
                let payload = null;

                if (responseText.trim()) {
                    try {
                        payload = JSON.parse(responseText);
                    } catch {
                        payload = null;
                    }
                }

                if (!response.ok) {
                    const statusMessage = `批次掛號失敗（HTTP ${response.status}）。`;
                    throw new Error(normalizeBatchMessage(payload ?? responseText, statusMessage));
                }

                if (!payload || !Array.isArray(payload.results)) {
                    throw new Error(normalizeBatchMessage(payload ?? responseText));
                }

                const results = payload.results.map(normalizeBatchResult);

                lastBatchResults = results;
                results.filter((result) => result.success)
                    .forEach((result) => {
                        const matchingRows = allRows.filter((item) =>
                            String(item.dataset.barcode || "").trim() === String(result.barcode || "").trim()
                            && String(item.dataset.projectNumber || "").trim() === String(result.projectNumber || "").trim());

                        matchingRows.forEach((row) => {
                            updateAppointmentStatus(row, "已掛號", "registered", "4", false);
                            setBatchRowSelected(row, false);
                            row.classList.add("batch-register-success");
                            window.setTimeout(() => row.classList.remove("batch-register-success"), 1800);
                        });
                    });
                syncDashboardCounts();
                setActivePage(activePage);
                openBatchResultDialog(results);
                syncBatchSelectionState();
            } catch (error) {
                const fallbackMessage = normalizeBatchMessage(error);
                const processedAt = new Date().toLocaleString("zh-TW", { hour12: false });

                lastBatchResults = selectedItems.map((item) => ({
                    success: false,
                    projectNumber: item.projectNumber,
                    barcode: item.barcode,
                    patNo: item.patNo,
                    name: item.name,
                    message: fallbackMessage,
                    processedAt
                }));
                openBatchResultDialog(lastBatchResults);
            } finally {
                hideBatchProgressDialog();
            }
        };

        const downloadBatchResults = () => {
            if (!lastBatchResults.length) return;
            const escapeCsv = (value) => `"${String(value ?? "").replace(/"/g, '""')}"`;
            const lines = [["處理結果", "受檢者", "病歷號", "專案編號", "Barcode", "訊息", "處理時間"], ...lastBatchResults.map((result) => [result.success ? "成功" : "失敗", result.name, result.patNo, result.projectNumber, result.barcode, result.message, result.processedAt])];
            const csvContent = lines.map((line) => line.map(escapeCsv).join(",")).join("\r\n");
            const utf8Bom = new Uint8Array([0xEF, 0xBB, 0xBF]);
            const url = URL.createObjectURL(new Blob([utf8Bom, csvContent], { type: "text/csv;charset=utf-8;" }));
            const link = Object.assign(document.createElement("a"), { href: url, download: "批次掛號結果.csv" });
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(url);
        };

        const bindAppointmentRow = (row) => {
            row.addEventListener("click", (event) => {
                if (event.target.closest("a, button, input, select, textarea")) {
                    return;
                }

                setSelectedRow(row);

                if (event.shiftKey) {
                    selectBatchRange(batchSelectionAnchor, row);
                } else if (event.ctrlKey || event.metaKey) {
                    toggleBatchRowSelection(row);
                } else {
                    batchSelectionAnchor = row;
                    syncBatchSelectionState();
                }
            });

            row.addEventListener("keydown", (event) => {
                if (event.key === "Enter") {
                    event.preventDefault();
                    setSelectedRow(row);
                    batchSelectionAnchor = row;
                    syncBatchSelectionState();
                    return;
                }

                if (event.key !== " ") {
                    return;
                }

                event.preventDefault();
                setSelectedRow(row);

                if (event.shiftKey) selectBatchRange(batchSelectionAnchor, row);
                else toggleBatchRowSelection(row);
            });
        };
        allRows.forEach(bindAppointmentRow);
        const pagination = page.querySelector(".table-footer .pagination");
        const pageSizeSelect = page.querySelector(".table-footer .page-select");
        const pageSummary = page.querySelector(".table-footer > span");
        let activePage = Number.parseInt(page.querySelector("[data-page].active")?.dataset.page || "1", 10);

        if (!Number.isFinite(activePage) || activePage < 1) {
            activePage = 1;
        }

        const getPageSize = () => {
            const parsedSize = Number.parseInt(pageSizeSelect?.value || "", 10);

            return Number.isFinite(parsedSize) && parsedSize > 0 ? parsedSize : 10;
        };

        const getPageCount = () => Math.max(1, Math.ceil(rows.length / getPageSize()));

        const clampPage = (pageNumber) => Math.min(Math.max(pageNumber, 1), getPageCount());

        const updatePageSummary = (startIndex, visibleCount) => {
            if (!pageSummary) {
                return;
            }

            if (!rows.length) {
                pageSummary.textContent = "顯示 0 筆，共 0 筆";
                return;
            }

            pageSummary.textContent = `顯示 ${startIndex + 1} - ${startIndex + visibleCount} 筆，共 ${rows.length} 筆`;
        };

        const getVisiblePageNumbers = () => {
            const pageCount = getPageCount();
            const maxVisiblePages = 7;

            if (pageCount <= maxVisiblePages) {
                const visiblePages = [];

                for (let pageNumber = 1; pageNumber <= pageCount; pageNumber += 1) {
                    visiblePages.push(pageNumber);
                }

                while (visiblePages.length < maxVisiblePages) {
                    visiblePages.push(`placeholder-${visiblePages.length}`);
                }

                return visiblePages;
            }

            if (activePage <= 4) {
                return [1, 2, 3, 4, 5, "ellipsis-end", pageCount];
            }

            if (activePage >= pageCount - 3) {
                return [1, "ellipsis-start", pageCount - 4, pageCount - 3, pageCount - 2, pageCount - 1, pageCount];
            }

            return [1, "ellipsis-start", activePage - 1, activePage, activePage + 1, "ellipsis-end", pageCount];
        };

        const createPageButton = (label, pageNumber, options = {}) => {
            const button = document.createElement("button");

            button.type = "button";
            button.textContent = label;

            if (typeof pageNumber === "number") {
                button.dataset.page = String(pageNumber);
            }

            if (options.ariaLabel) {
                button.setAttribute("aria-label", options.ariaLabel);
            }

            if (options.active) {
                button.classList.add("active");
                button.setAttribute("aria-current", "page");
            }

            if (options.disabled) {
                button.disabled = true;
            }

            if (options.placeholder) {
                button.classList.add("pagination-placeholder");
                button.disabled = true;
                button.setAttribute("aria-hidden", "true");
                button.tabIndex = -1;
                return button;
            }

            if (!options.disabled) {
                button.addEventListener("click", () => setActivePage(pageNumber));
            }

            return button;
        };

        const renderPagination = () => {
            if (!pagination) {
                return;
            }

            const pageCount = getPageCount();
            const buttons = [
                createPageButton("‹", activePage - 1, {
                    ariaLabel: "上一頁",
                    disabled: activePage === 1
                })
            ];

            getVisiblePageNumbers().forEach((pageNumber) => {
                if (typeof pageNumber === "string" && pageNumber.startsWith("placeholder-")) {
                    buttons.push(createPageButton("", null, {
                        placeholder: true
                    }));
                    return;
                }

                if (typeof pageNumber !== "number") {
                    buttons.push(createPageButton("...", null, {
                        ariaLabel: "省略頁碼",
                        disabled: true
                    }));
                    return;
                }

                buttons.push(createPageButton(String(pageNumber), pageNumber, {
                    active: pageNumber === activePage,
                    ariaLabel: `第 ${pageNumber} 頁`
                }));
            });

            buttons.push(createPageButton("›", activePage + 1, {
                ariaLabel: "下一頁",
                disabled: activePage === pageCount
            }));

            pagination.replaceChildren(...buttons);
        };

        let appointmentSortKey = "";
        let appointmentSortDirection = "asc";
        const originalSortOrder = new WeakMap(allRows.map((row, index) => [row, index]));
        const appointmentSortButtons = Array.from(page.querySelectorAll("[data-appointment-sort]"));

        const getAppointmentSortValue = (row, key) => {
            if (key === "appointmentDate") return normalizeDateValue(row.dataset.appointmentDate) || null;
            if (key === "status") {
                const code = String(row.dataset.reserveStatus || "").trim();
                const index = ["1", "4", "5", "6", "2", "0"].indexOf(code);
                return index < 0 ? null : index;
            }
            const text = String(row.dataset[key] || "").trim();
            if (!text || text === "-" || text === "—") return null;
            if (key === "time") {
                const match = /^(\d{1,2}):(\d{2})(?::(\d{2}))?/.exec(text)
                    || /^(\d{2})(\d{2})(\d{2})?$/.exec(text);
                if (match) return [match[1].padStart(2, "0"), match[2], match[3] || "00"].join(":");
            }
            return text;
        };

        const compareAppointmentRows = (left, right) => {
            const a = getAppointmentSortValue(left, appointmentSortKey);
            const b = getAppointmentSortValue(right, appointmentSortKey);
            if (a === null && b !== null) return 1;
            if (b === null && a !== null) return -1;
            const compared = a === b ? 0 : typeof a === "number" ? a - b
                : a.localeCompare(b, "zh-Hant-TW", { numeric: true });
            return compared ? compared * (appointmentSortDirection === "asc" ? 1 : -1)
                : (originalSortOrder.get(left) ?? 0) - (originalSortOrder.get(right) ?? 0);
        };

        appointmentSortButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const key = button.dataset.appointmentSort;
                appointmentSortDirection = appointmentSortKey === key && appointmentSortDirection === "asc" ? "desc" : "asc";
                appointmentSortKey = key;
                appointmentSortButtons.forEach((item) => {
                    const active = item === button;
                    item.closest("th").setAttribute("aria-sort", active ? (appointmentSortDirection === "asc" ? "ascending" : "descending") : "none");
                    item.querySelectorAll("[data-sort-direction]").forEach((arrow) => {
                        arrow.classList.toggle("is-active", active && arrow.dataset.sortDirection === appointmentSortDirection);
                    });
                    const label = item.firstChild.textContent.trim();
                    item.setAttribute("aria-label", label + (active ? (appointmentSortDirection === "asc" ? "：目前遞增，點擊遞減排序" : "：目前遞減，點擊遞增排序") : "：點擊遞增排序"));
                });
                setActivePage(1);
            });
        });

        const setActivePage = (pageNumber) => {
            if (appointmentSortKey) {
                rows.sort(compareAppointmentRows);
                const body = rows[0]?.parentElement;
                if (body) {
                    const fragment = document.createDocumentFragment();
                    rows.forEach((row) => fragment.appendChild(row));
                    body.appendChild(fragment);
                }
            }

            activePage = clampPage(pageNumber);

            const pageSize = getPageSize();
            const startIndex = (activePage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, rows.length);
            const visibleRowSet = new Set(rows.slice(startIndex, endIndex));

            allRows.forEach((row) => {
                row.hidden = !visibleRowSet.has(row);
            });

            const visibleRows = rows.slice(startIndex, endIndex);
            const selectedRow = rows.find((row) => row.classList.contains("is-selected"));

            if (visibleRows.length && !visibleRows.includes(selectedRow)) {
                setSelectedRow(visibleRows[0]);
            } else if (!rows.length) {
                clearSelectedFields();
            } else {
                syncSelectedAppointmentButton(selectedRow);
            }

            updatePageSummary(startIndex, visibleRows.length);
            renderPagination();
            syncHorizontalScrollbarSize();
            syncBatchSelectionState();
        };

        const applyAppointmentFilters = (resetPage = true) => {
            const startDate = normalizeDateValue(startDateInput?.value);
            const endDate = normalizeDateValue(endDateInput?.value);
            const selectedArea = (reservationAreaSelect?.value || "").trim();
            const selectedStatus = (appointmentStatusSelect?.value || "").trim();
            const keyword = normalizeFilterValue(keywordInput?.value);
            const searchAllDatesForDefaultKeyword = Boolean(keyword)
                && !dateFilterTouched
                && isDefaultTodayDateRange();

            rows = allRows.filter((row) => {
                const matchesKeyword = matchesAppointmentKeyword(row, keyword);
                const matchesDate = isAppointmentDateInRange(row, startDate, endDate)
                    || (searchAllDatesForDefaultKeyword && matchesKeyword);

                return matchesDate
                    && (!selectedArea || getAppointmentWorkArea(row) === selectedArea)
                    && (!selectedStatus || getAppointmentReserveStatus(row) === selectedStatus)
                    && matchesKeyword;
            });

            syncDashboardCounts();
            setActivePage(resetPage ? 1 : activePage);
        };

        const setAppointmentQueryState = (state, message = "") => {
            page.dataset.queryState = state;

            if (searchButton) {
                searchButton.disabled = state === "loading";
                searchButton.setAttribute("aria-busy", String(state === "loading"));
                searchButton.setAttribute("aria-disabled", String(state === "loading"));
                searchButton.title = "";
            }

            if (searchButtonLabel) {
                searchButtonLabel.textContent = state === "loading" ? "查詢中" : "搜尋";
            }

            if (queryStatus) {
                queryStatus.dataset.state = state;
                queryStatus.textContent = message;
            }
        };

        const setAppointmentGridAnimation = (state = "") => {
            window.clearTimeout(appointmentGridAnimationTimer);
            appointmentGridAnimationTimer = 0;
            tablePanel?.classList.toggle("is-query-loading", state === "loading");
            tablePanel?.classList.toggle("is-query-refreshed", state === "refreshed");
            tablePanel?.setAttribute("aria-busy", String(state === "loading"));
        };
        const playAppointmentGridRefreshed = () => {
            setAppointmentGridAnimation("refreshed");
            setAppointmentQueryState("done", `清單已更新，共 ${rows.length} 筆`);
            appointmentGridAnimationTimer = window.setTimeout(() => {
                setAppointmentGridAnimation();
                setAppointmentQueryState("idle");
            }, 1200);
        };
        const closeAppointmentQueryError = () => {
            if (queryErrorModal) {
                queryErrorModal.hidden = true;
            }
        };

        const showAppointmentQueryError = (message) => {
            const normalizedMessage = String(message || "").trim()
                || "查詢時間過長，請縮小查詢範圍後再試。";

            if (!queryErrorModal || !queryErrorMessage) {
                window.alert(normalizedMessage);
                return;
            }

            queryErrorMessage.textContent = normalizedMessage;
            queryErrorModal.hidden = false;
            queryErrorModal.querySelector("[data-appointment-query-error-close]:not(.appointment-confirm-backdrop)")?.focus();
        };

        const buildAppointmentSearchUrl = () => {
            const url = new URL(window.location.href);
            const keyword = String(keywordInput?.value || "").trim();
            const startDate = String(startDateInput?.value || "").trim();
            const endDate = String(endDateInput?.value || "").trim();
            const selectedArea = String(reservationAreaSelect?.value || "").trim();
            const selectedStatus = String(appointmentStatusSelect?.value || "").trim();
            const shouldSearchAllDatesForKeyword = Boolean(keyword)
                && !dateFilterTouched
                && isDefaultTodayDateRange();

            url.search = "";

            if (startDate && !shouldSearchAllDatesForKeyword) {
                url.searchParams.set("checkDateStart", startDate);
            }

            if (endDate && !shouldSearchAllDatesForKeyword) {
                url.searchParams.set("checkDateEnd", endDate);
            }

            if (selectedArea) {
                url.searchParams.set("reservationArea", selectedArea);
            }

            if (selectedStatus) {
                url.searchParams.set("reserveStatus", selectedStatus);
            }

            if (keyword) {
                url.searchParams.set("keyword", keyword);
            }

            return url.toString();
        };

        const runAppointmentSearch = () => {
            if (isAppointmentQueryRunning || page.dataset.queryState === "loading") {
                return;
            }

            for (const input of [startDateInput, endDateInput]) {
                if (!input) continue;
                input.setCustomValidity("");
                if (!input.validity.valid || (input.value && !normalizeDateValue(input.value))) {
                    input.setCustomValidity("請輸入有效的日期（西元年／月／日），並確認月份與日期正確。");
                    input.reportValidity();
                    input.focus();
                    return;
                }
            }

            const targetUrl = buildAppointmentSearchUrl();
            const currentUrl = new URL(window.location.href);
            const normalizedTargetUrl = new URL(targetUrl);
            const isCurrentQuery = normalizedTargetUrl.pathname === currentUrl.pathname
                && normalizedTargetUrl.search === currentUrl.search;

            isAppointmentQueryRunning = true;
            window.clearTimeout(appointmentQueryTimeoutTimer);
            closeActionMenus();
            setAppointmentQueryState("loading", "查詢中...");
            setAppointmentGridAnimation("loading");
            markAppointmentGridRefresh();
            appointmentQueryTimeoutTimer = window.setTimeout(() => {
                window.stop();
                appointmentQueryTimeoutTimer = 0;
                isAppointmentQueryRunning = false;
                clearAppointmentGridRefreshMark();
                setAppointmentGridAnimation();
                setAppointmentQueryState("idle");
                showAppointmentQueryError("查詢超過 30 秒，已自動逾時，請縮小查詢範圍後再試。");
            }, appointmentQueryTimeoutMilliseconds);

            window.setTimeout(() => {
                try {
                    if (isCurrentQuery) { window.location.reload(); }
                    else { window.location.assign(targetUrl); }
                } catch {
                    window.clearTimeout(appointmentQueryTimeoutTimer);
                    appointmentQueryTimeoutTimer = 0;
                    isAppointmentQueryRunning = false;
                    clearAppointmentGridRefreshMark();
                    setAppointmentGridAnimation();
                    setAppointmentQueryState("idle");
                    showAppointmentQueryError("無法送出查詢，請稍後再試。");
                }
            }, 360);
        };

        const getTodayInputDate = () => {
            const today = new Date();
            return `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
        };

        const toDateInputValue = (value) => {
            const normalized = normalizeDateValue(value);

            return normalized
                ? `${normalized.slice(0, 4)}-${normalized.slice(4, 6)}-${normalized.slice(6, 8)}`
                : "";
        };

        const applyAppointmentQueryFromUrl = () => {
            const query = new URLSearchParams(window.location.search);
            const keyword = String(query.get("keyword") || query.get("barcode") || query.get("healthCode") || "").trim();
            const projectNo = String(query.get("projectNo") || query.get("projectNumber") || "").trim();
            const customerName = String(query.get("customerName") || query.get("company") || "").trim();
            const startDateParam = query.get("checkDateStart") || query.get("startDate");
            const endDateParam = query.get("checkDateEnd") || query.get("endDate");
            const hasDateQuery = query.has("checkDateStart")
                || query.has("checkDateEnd")
                || query.has("startDate")
                || query.has("endDate");
            const hasAppointmentQuery = keyword || projectNo || customerName || hasDateQuery;

            if (!hasAppointmentQuery) {
                return;
            }

            const today = getTodayInputDate();
            const shouldUseTodayFallback = !keyword && (projectNo || customerName);
            const fallbackDate = shouldUseTodayFallback ? today : "";
            const startDate = toDateInputValue(startDateParam) || fallbackDate;
            const endDate = toDateInputValue(endDateParam) || startDate || fallbackDate;

            if (keywordInput) {
                keywordInput.value = keyword || projectNo || customerName;
            }

            if (startDateInput) {
                startDateInput.value = startDate;
            }

            if (endDateInput) {
                endDateInput.value = endDate;
            }

            dateFilterTouched = Boolean(startDate || endDate);
        };

        const focusAppointmentFromUrl = () => {
            const query = new URLSearchParams(window.location.search);
            const barcode = normalizeFilterValue(query.get("focusBarcode"));
            const projectNumber = normalizeFilterValue(query.get("focusProjectNumber"));

            if (!barcode && !projectNumber) {
                return;
            }

            const focusedRow = rows.find((row) =>
                (!barcode || normalizeFilterValue(row.dataset.barcode) === barcode)
                && (!projectNumber || normalizeFilterValue(row.dataset.projectNumber) === projectNumber));

            if (!focusedRow) {
                return;
            }

            const focusedRowIndex = rows.indexOf(focusedRow);
            const focusedPage = Math.floor(focusedRowIndex / getPageSize()) + 1;

            setSelectedRow(focusedRow);
            setActivePage(focusedPage);
            focusedRow.focus({ preventScroll: true });
        };

        applyAppointmentQueryFromUrl();
        [startDateInput, endDateInput].forEach((input) => {
            // Leave native text editing and the calendar icon available independently.
            input?.addEventListener("keydown", (event) => {
                if (event.key !== "Enter") return;
                event.preventDefault();
                runAppointmentSearch();
            });

            ["input", "change"].forEach((eventName) => {
                input?.addEventListener(eventName, () => {
                    input.setCustomValidity("");
                    dateFilterTouched = true;
                });
            });
        });
        keywordInput?.addEventListener("keydown", (event) => {
            if (event.key !== "Enter") {
                return;
            }

            event.preventDefault();
            runAppointmentSearch();
        });

        searchButton?.addEventListener("click", runAppointmentSearch);
        queryErrorCloseButtons.forEach((button) => button.addEventListener("click", closeAppointmentQueryError));
        rejectionCloseButtons.forEach((button) => button.addEventListener("click", closeAppointmentRejection));
        selectedAppointmentButton?.addEventListener("click", openSelectedAppointment);
        pageSizeSelect?.addEventListener("change", () => setActivePage(1));
        batchClearButton?.addEventListener("click", clearBatchSelection);
        batchRegisterButton?.addEventListener("click", runBatchRegister);
        batchResultCloseButtons.forEach((button) => button.addEventListener("click", closeBatchResultDialog));
        batchResultDownloadButton?.addEventListener("click", downloadBatchResults);
        if (String(queryErrorMessage?.textContent || "").trim()) {
            showAppointmentQueryError(queryErrorMessage.textContent);
        }
        window.addEventListener("pageshow", () => {
            window.clearTimeout(appointmentQueryTimeoutTimer);
            appointmentQueryTimeoutTimer = 0;
            isAppointmentQueryRunning = false;
            if (consumeAppointmentGridRefreshMark()) { playAppointmentGridRefreshed(); }
            else { setAppointmentGridAnimation(); setAppointmentQueryState("idle"); }
        });
        applyAppointmentFilters(false);
        focusAppointmentFromUrl();
    })();
</script>
