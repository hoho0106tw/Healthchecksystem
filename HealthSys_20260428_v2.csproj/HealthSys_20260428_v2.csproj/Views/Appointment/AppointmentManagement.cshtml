        let appointmentGridAnimationTimer = 0;
        let isAppointmentQueryRunning = false;
        const appointmentQueryTimeoutMilliseconds = 30000;
        const appointmentQueryRefreshStorageKey = "appointment-query-grid-refresh";
        const appointmentQueryRefreshStorage = (() => { try { return window.sessionStorage; } catch { return null; } })();
        const markAppointmentGridRefresh = () => { try { appointmentQueryRefreshStorage?.setItem(appointmentQueryRefreshStorageKey, "1"); } catch { } };
        const clearAppointmentGridRefreshMark = () => { try { appointmentQueryRefreshStorage?.removeItem(appointmentQueryRefreshStorageKey); } catch { } };
        const consumeAppointmentGridRefreshMark = () => {
            try {
                const shouldPlay = appointmentQueryRefreshStorage?.getItem(appointmentQueryRefreshStorageKey) === "1";
                appointmentQueryRefreshStorage?.removeItem(appointmentQueryRefreshStorageKey);
                return shouldPlay;
            } catch { return false; }
        };

        const setDashboardCount = (key, value) => {
            dashboardCountTargets[key]?.forEach((target) => {
